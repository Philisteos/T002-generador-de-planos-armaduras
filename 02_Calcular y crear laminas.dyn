    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# 02_Calcular y crear laminas - calcula cuantas laminas hacen falta para las\n# vistas de assembly pendientes y crea esa cantidad, con la numeracion de siempre.\n#\n# EMPAQUETADO (reescrito 2026-07-23): se mide cada bloque por su CROP + titulo\n# (View.CropBox/escala, ajustado al borde por el 01), NO por el contorno con lineas\n# de seccion (esas cruzan las vistas vecinas, es normal; medir por ellas daba un\n# assembly por pagina). El reparto es por COLUMNAS JUSTIFICADAS: los bloques se\n# apilan en columnas verticales, las columnas llenan el ancho de la hoja y dentro de\n# cada columna los bloques se reparten parejo para llenar el alto (justificado, sin\n# montarse). El slider \"Separacion entre vistas (mm)\" fija el espacio minimo que\n# reclama cada bloque -> cuantas caben por hoja -> cuantas laminas. 02_Colocar usa\n# la MISMA medida y el MISMO reparto.\n# Revit 2027 / Dynamo 4 / CPython3\n# IN[0] = tipo de vineta (dropdown Family Types)\n# IN[1] = numero del primer sheet\n# IN[2] = nombre del primer sheet\n# IN[3] = procesar todos los assemblies (bool)\n# IN[4] = filtro de assemblies si IN[3] es False (parcial, comas)\n# IN[5] = margen del borde de la lamina (mm) - debe coincidir con 02\n# IN[6] = reserva en el lado derecho (mm) - idem, debe coincidir con 02\n# IN[7] = separacion entre vistas (mm) - espacio minimo entre bloques; regula\n#         cuantas vistas por lamina (mas mm = menos por hoja = mas laminas).\n#         DEBE coincidir con 02 para que el calculo y la colocacion cuadren.\n\nimport clr\nimport re\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (FilteredElementCollector, AssemblyInstance, ViewSheet,\n                               Viewport, View, BuiltInCategory, Element, ElementId, XYZ)\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\ntb_type = UnwrapElement(IN[0])\nfirst_number = (IN[1] or '').strip()\nfirst_name = (IN[2] or '').strip()\nprocess_all = bool(IN[3])\nfilter_text = (IN[4] or '').strip()\nmargin = float(IN[5]) / 304.8\nright_reserve = float(IN[6]) / 304.8\n# separacion minima entre bloques (mm -> pies). Regula la densidad: mas separacion\n# = menos vistas por hoja = mas laminas. Si el input aun no existe, cae a 10 mm.\ntry:\n    sep = float(IN[7]) / 304.8\nexcept Exception:\n    sep = 10.0 / 304.8\nif sep < 0:\n    sep = 0.0\n# separacion REAL dentro de cada bloque (planta -> corte A -> corte B -> callouts):\n# margen general + 10 mm fijos, igual que 02.\ngap_bloque = margin + 10.0 / 304.8\n\nlog = []\nSUFIJO_ARMADURAS = ' - ARMADURA'\nSUFIJO_CORTE = SUFIJO_ARMADURAS + ' - CORTE A'\nSUFIJO_CORTE_B = SUFIJO_ARMADURAS + ' - CORTE B'\nSUFIJOS_CORTE = (SUFIJO_CORTE, SUFIJO_CORTE_B)\nPREFIJO_PEDESTAL = SUFIJO_ARMADURAS + ' - PEDESTAL '\n# CORTES DE PEDESTAL (2026-07-31): los crea el 01 desde cada callout y NO entran al calculo\n# de laminas - MANDATORIO (Javier): esas vistas las coloca el modelador a mano, opcionalmente\n# fuera de la lamina. Hoy quedan fuera solos (su nombre no empieza con PREFIJO_PEDESTAL, y\n# esta recoleccion es una whitelist), pero el filtro explicito de mas abajo protege contra un\n# rename futuro del sufijo.\nSUFIJO_CORTE_PEDESTAL = SUFIJO_ARMADURAS + ' - CORTE PEDESTAL '\n\n# reserva bajo cada vista para su titulo (planta y cortes/callouts)\nlabel_h_planta = 12.0 / 304.8\nlabel_h_corte = (12.0 + 14.0) / 304.8\n\ndef sufijo_corte(nombre):\n    for a in SUFIJOS_CORTE:\n        if nombre.endswith(a):\n            return a\n    return None\n\ndef es_callout_pedestal(nombre):\n    return PREFIJO_PEDESTAL in nombre\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\ndef label_h_de(v):\n    nombre = elem_name(v)\n    return label_h_corte if (sufijo_corte(nombre) or es_callout_pedestal(nombre)) else label_h_planta\n\ndef tb_label(t):\n    try:\n        return '{} : {}'.format(t.FamilyName, elem_name(t))\n    except Exception:\n        return 'Id ' + str(t.Id)\n\ndef list_titleblocks():\n    col = (FilteredElementCollector(doc)\n           .OfCategory(BuiltInCategory.OST_TitleBlocks)\n           .WhereElementIsElementType())\n    return list(col)\n\ndef paper_size(v):\n    # tamano en papel (pies) = crop del modelo / escala (crop ya ajustado por 00)\n    cb = v.CropBox\n    s = v.Scale if v.Scale > 0 else 1\n    return ((cb.Max.X - cb.Min.X) / s, (cb.Max.Y - cb.Min.Y) / s)\n\ndef dims_bloque(grupo):\n    # bloque vertical: planta arriba, cortes/callouts abajo. Ancho = crop mas ancho;\n    # alto = suma de (crop + titulo) + gap_bloque entre vistas.\n    ws = []\n    hs = []\n    for v in grupo:\n        w, h = paper_size(v)\n        ws.append(w)\n        hs.append(h + label_h_de(v))\n    bw = max(ws)\n    bh = sum(hs) + gap_bloque * (len(grupo) - 1)\n    return bw, bh\n\ndef usable_rect(sheet):\n    # area util = bbox de la vineta menos margenes (y reserva derecha)\n    col = FilteredElementCollector(doc, sheet.Id).OfCategory(BuiltInCategory.OST_TitleBlocks)\n    tb = col.FirstElement()\n    if tb is not None:\n        bb = tb.get_BoundingBox(sheet)\n        if bb is not None:\n            return (bb.Min.X + margin, bb.Min.Y + margin,\n                    bb.Max.X - margin - right_reserve, bb.Max.Y - margin)\n    o = sheet.Outline\n    return (o.Min.U + margin, o.Min.V + margin,\n            o.Max.U - margin - right_reserve, o.Max.V - margin)\n\n# ---------------- reparto por COLUMNAS JUSTIFICADAS ----------------\n# Los bloques (en orden por nombre) se apilan en columnas verticales; cuando una\n# columna se llena en alto, empieza otra a la derecha; cuando no cabe otra columna\n# en el ancho, empieza otra lamina. Despues cada lamina se JUSTIFICA: las columnas\n# se separan parejo para llenar el ancho y, dentro de cada columna, los bloques se\n# separan parejo para llenar el alto (nunca se montan; la separacion resultante\n# siempre es >= sep). Mantiene el orden por nombre entre y dentro de las laminas.\nEPS = 1e-9\n\ndef pack_columns(dims, W, H):\n    # dims: lista de (bw, bh) en orden. Devuelve lista de paginas; cada pagina es\n    # lista de columnas; cada columna es lista de indices de bloque.\n    pages = []\n    page = []\n    page_w = 0.0\n    col = []\n    col_h = 0.0\n    col_w = 0.0\n\n    for idx in range(len(dims)):\n        bw, bh = dims[idx]\n        if col and (col_h + sep + bh) > H + EPS:\n            # cerrar columna actual\n            w_need = (sep if page else 0.0) + col_w\n            if page and (page_w + w_need) > W + EPS:\n                pages.append(page)\n                page = []\n                page_w = 0.0\n                w_need = col_w\n            page.append(col)\n            page_w += w_need\n            col = []\n            col_h = 0.0\n            col_w = 0.0\n        # agregar bloque a la columna actual\n        if col:\n            col_h += sep + bh\n        else:\n            col_h = bh\n        col.append(idx)\n        if bw > col_w:\n            col_w = bw\n    if col:\n        w_need = (sep if page else 0.0) + col_w\n        if page and (page_w + w_need) > W + EPS:\n            pages.append(page)\n            page = []\n            w_need = col_w\n        page.append(col)\n    if page:\n        pages.append(page)\n    return pages\n\ndef layout(dims, x0, y0, x1, y1):\n    # devuelve (asign, n_paginas, avisos) donde asign[i] = (pagina, cx, by_top)\n    W = x1 - x0\n    H = y1 - y0\n    pages = pack_columns(dims, W, H)\n    asign = [None] * len(dims)\n    avisos = []\n    for i, (bw, bh) in enumerate(dims):\n        if bw > W + EPS or bh > H + EPS:\n            avisos.append(i)\n    for pi, page in enumerate(pages):\n        ncols = len(page)\n        widths = [max(dims[i][0] for i in colm) for colm in page]\n        sum_w = sum(widths)\n        gap_x = 0.0 if ncols <= 1 else (W - sum_w) / (ncols - 1)\n        if gap_x < 0:\n            gap_x = 0.0\n        # centro x de cada columna\n        cx_col = []\n        if ncols == 1:\n            left = x0 + max(0.0, (W - widths[0]) / 2.0)\n            cx_col.append(left + widths[0] / 2.0)\n        else:\n            x = x0\n            for w in widths:\n                cx_col.append(x + w / 2.0)\n                x += w + gap_x\n        for ci, colm in enumerate(page):\n            heights = [dims[i][1] for i in colm]\n            sum_h = sum(heights)\n            n = len(colm)\n            if n == 1:\n                top = y1 - max(0.0, (H - heights[0]) / 2.0)\n                asign[colm[0]] = (pi, cx_col[ci], top)\n            else:\n                gap_y = (H - sum_h) / (n - 1)\n                if gap_y < 0:\n                    gap_y = 0.0\n                y = y1\n                for k, i in enumerate(colm):\n                    asign[i] = (pi, cx_col[ci], y)\n                    y -= heights[k] + gap_y\n    return asign, len(pages), avisos\n\ndef bump(text, steps):\n    last = None\n    for m in re.finditer('\\\\d+', text):\n        last = m\n    if last is None:\n        return '{} {:02d}'.format(text, steps + 1)\n    width = len(last.group(0))\n    val = int(last.group(0)) + steps\n    return text[:last.start()] + str(val).zfill(width) + text[last.end():]\n\n# --- validar la vineta seleccionada ---\ntb_cat_id = ElementId(BuiltInCategory.OST_TitleBlocks)\nis_tb = (tb_type is not None\n         and tb_type.Category is not None\n         and tb_type.Category.Id == tb_cat_id)\n\nif not is_tb:\n    log.append('ERROR: el tipo seleccionado en el dropdown NO es una vineta (Title Block).')\n    log.append('Selecciona una de estas vinetas cargadas en el proyecto:')\n    tbs = list_titleblocks()\n    if not tbs:\n        log.append('  (no hay vinetas cargadas en el proyecto)')\n    for t in tbs:\n        log.append('  - ' + tb_label(t))\n    OUT = log\nelse:\n    by_type = {}\n    for ai in FilteredElementCollector(doc).OfClass(AssemblyInstance):\n        by_type.setdefault(ai.AssemblyTypeName, []).append(ai)\n\n    names = sorted(by_type.keys())\n    if not process_all:\n        tokens = [t.strip().lower() for t in filter_text.split(',') if t.strip()]\n        if tokens:\n            names = [n for n in names if any(tok in n.lower() for tok in tokens)]\n        else:\n            names = []\n            log.append('ERROR: \\\"Todos\\\" esta en False y el filtro esta vacio.')\n\n    view_by_name = {}\n    for v in FilteredElementCollector(doc).OfClass(View):\n        if not v.IsTemplate:\n            view_by_name[elem_name(v)] = v\n\n    placed_ids = set()\n    for vp in FilteredElementCollector(doc).OfClass(Viewport):\n        placed_ids.add(vp.ViewId.Value)\n\n    bloques = []\n    for n in names:\n        grupo = []\n        for vname in (n + SUFIJO_ARMADURAS, n + SUFIJO_CORTE, n + SUFIJO_CORTE_B):\n            v = view_by_name.get(vname)\n            if v is None:\n                log.append('AVISO: no existe la vista \\\"{}\\\" (corre 01_Vistas de assembly).'.format(vname))\n            elif v.Id.Value in placed_ids:\n                pass  # ya colocada en una lamina, no cuenta como pendiente\n            else:\n                grupo.append(v)\n        prefijo_ped = n + PREFIJO_PEDESTAL\n        # el 'and not in' excluye los CORTES DE PEDESTAL, ver SUFIJO_CORTE_PEDESTAL arriba\n        for vname_ped in sorted(nm for nm in view_by_name\n                                if nm.startswith(prefijo_ped) and SUFIJO_CORTE_PEDESTAL not in nm):\n            v_ped = view_by_name[vname_ped]\n            if v_ped.Id.Value not in placed_ids:\n                grupo.append(v_ped)\n        if grupo:\n            bloques.append(grupo)\n\n    if not bloques:\n        log.append('No hay vistas pendientes de colocar; no se creo ninguna lamina.')\n        OUT = log\n    else:\n        created = 0\n        sheets_needed = 0\n        TransactionManager.Instance.EnsureInTransaction(doc)\n        try:\n            if hasattr(tb_type, 'IsActive') and not tb_type.IsActive:\n                tb_type.Activate()\n\n            # --- lamina de prueba solo para medir el area util de la vineta ---\n            probe = ViewSheet.Create(doc, tb_type.Id)\n            doc.Regenerate()\n            x0, y0, x1, y1 = usable_rect(probe)\n            doc.Delete(probe.Id)\n\n            dims_bloques = [dims_bloque(g) for g in bloques]\n            asign, sheets_needed, avisos = layout(dims_bloques, x0, y0, x1, y1)\n            for idx in avisos:\n                bw, bh = dims_bloques[idx]\n                log.append('AVISO: \\\"{}\\\" ({:.0f} x {:.0f} mm en papel) es mas grande que el area util de una lamina.'.format(\n                    elem_name(bloques[idx][0]), bw * 304.8, bh * 304.8))\n\n            # --- crear esa cantidad de laminas, con la numeracion de siempre ---\n            if not first_number:\n                first_number = 'A-001'\n                log.append('AVISO: numero inicial vacio, se usa A-001.')\n            if not first_name:\n                first_name = 'SIN NOMBRE 01'\n                log.append('AVISO: nombre inicial vacio, se usa SIN NOMBRE 01.')\n\n            existing = set()\n            for vs in FilteredElementCollector(doc).OfClass(ViewSheet):\n                existing.add(vs.SheetNumber)\n\n            plan = []\n            produced = 0\n            offset = 0\n            while produced < sheets_needed and offset < sheets_needed + 1000:\n                num = first_number if offset == 0 else bump(first_number, offset)\n                offset += 1\n                if num in existing:\n                    log.append('AVISO: el numero {} ya existe en el proyecto, se salta.'.format(num))\n                    continue\n                name = first_name if produced == 0 else bump(first_name, produced)\n                plan.append((num, name))\n                existing.add(num)\n                produced += 1\n\n            for num, name in plan:\n                try:\n                    sheet = ViewSheet.Create(doc, tb_type.Id)\n                    sheet.SheetNumber = num\n                    try:\n                        sheet.Name = name\n                    except Exception:\n                        Element.Name.__set__(sheet, name)\n                    created += 1\n                    log.append('OK: {}  |  {}'.format(num, name))\n                except Exception as e:\n                    log.append('ERROR creando {}: {}'.format(num, e))\n        finally:\n            TransactionManager.Instance.TransactionTaskDone()\n\n        log.insert(0, 'Vineta usada: ' + tb_label(tb_type))\n        log.insert(1, 'Laminas necesarias calculadas: {} | creadas: {} (columnas justificadas)'.format(sheets_needed, created))\n        log.append('Listo. Ahora corre 03_Colocar vistas en laminas para distribuir las vistas en estas laminas.')\n        OUT = log",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "a9010000000000000000000000000001",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "a9010000000000000000000000000002",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "a9010000000000000000000000000003",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "a9010000000000000000000000000004",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "a9010000000000000000000000000005",
          "Name": "IN[3]",
          "Description": "Input #3",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
