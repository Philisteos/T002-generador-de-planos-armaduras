    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# 02_Colocar vistas en laminas - Por assembly: planta arriba + cortes + callouts\n# (mismo eje vertical), bloques repartidos en los sheets destino.\n#\n# EMPAQUETADO (reescrito 2026-07-23): se empaqueta y se apila por el tamano del\n# CROP de cada vista (View.CropBox / escala, que el 00 deja ajustado al borde de\n# la fundacion) MAS el titulo - NO por el contorno con lineas de seccion (esas\n# cruces salen del crop, se extienden muchisimo mas que la fundacion y como son\n# finas cruzarse con las vistas vecinas es normal; medir por ellas daba un bloque\n# por pagina). Reparto SKYLINE (bottom-left): cada bloque cae en el hueco mas alto\n# y a la izquierda, asi un bloque alto y angosto ocupa solo su columna y el resto\n# del ancho se rellena con los siguientes. 01_Calcular usa la MISMA medida y el\n# MISMO empaquetado. 02 mete la TOTALIDAD de las vistas en las laminas que ya\n# existen (creadas por 01): NO crea laminas nuevas y NUNCA descarta una vista. Si el\n# empaquetado necesita mas \u0027paginas\u0027 que laminas disponibles, esas paginas de mas se\n# reparten (round-robin) sobre las mismas laminas y las vistas se MONTAN - el slider\n# \"Separacion de vistas (%)\" es justamente para regular cuanto se montan: bajarlo\n# hace que todo entre montado en pocas laminas, subirlo las separa en mas laminas.\n#\n# Leyendas: eliminado (2026-07-10 a 2026-07-21, pedido de Javier).\n#\n# Revit 2027 / Dynamo 4 / CPython3\n# IN[0] = sheets destino: numeros separados por coma, o un prefijo comun\n# IN[1] = procesar todos los assemblies (bool)\n# IN[2] = filtro de assemblies si IN[1] es False (parcial, comas)\n# IN[3] = margen y separacion entre vistas (mm)\n# IN[4] = reserva en el lado derecho del sheet (mm)\n# IN[5] = tipo de viewport para las PLANTAS (vacio = tipo por defecto)\n# IN[6] = tipo de viewport para los CORTES (vacio = tipo por defecto)\n# IN[7] = separacion del titulo bajo el borde de los cortes (mm)\n# IN[8] = separacion de vistas (%) - regula cuantas vistas por lamina. 100 = ajustado\n#         (denso); \u003c 100 = mas montadas y menos laminas; \u003e 100 = mas separadas y mas\n#         laminas. DEBE coincidir con el mismo input de 01 para que cuadren.\n\nimport clr\nclr.AddReference(\u0027RevitAPI\u0027)\nclr.AddReference(\u0027RevitServices\u0027)\nfrom Autodesk.Revit.DB import (FilteredElementCollector, AssemblyInstance, ViewSheet,\n                               Viewport, View, ViewType, BuiltInCategory, XYZ, Element,\n                               ElementType, ElementId, BuiltInParameter, FamilySymbol,\n                               FamilyInstance, ViewDuplicateOption, StorageType)\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nsheets_text = (IN[0] or \u0027\u0027).strip()\nprocess_all = bool(IN[1])\nfilter_text = (IN[2] or \u0027\u0027).strip()\nmargin = float(IN[3]) / 304.8\nright_reserve = float(IN[4]) / 304.8\nvp_type_text = (IN[5] or \u0027\u0027).strip()\nvp_type_text_sec = (IN[6] or \u0027\u0027).strip()\ngap_corte = float(IN[7]) / 304.8   # slider: distancia del titulo bajo el borde del corte\n# separacion de vistas (%) - escala el hueco que reserva cada bloque al empaquetar\n# (no el tamano real): \u003c 100 monta las vistas, \u003e 100 las separa. DEBE coincidir con\n# 01. Si el input aun no existe (grafo sin re-abrir), cae a 100.\ntry:\n    esc = float(IN[8]) / 100.0\nexcept Exception:\n    esc = 1.0\nif esc \u003c 0.2:\n    esc = 0.2\ngap_planta = 5.0 / 304.8\n# reserva bajo cada vista para su titulo, usada para apilar y para el empaquetado\nlabel_h_planta = 12.0 / 304.8\nlabel_h_corte = (12.0 + 14.0) / 304.8\n# separacion REAL dentro de cada bloque (planta -\u003e corte A -\u003e corte B -\u003e callouts):\n# margen general + 10 mm fijos.\ngap_bloque = margin + 10.0 / 304.8\n\nlog = []\nSUFIJO_ARMADURAS = \u0027 - ARMADURA\u0027\nSUFIJO_CORTE = SUFIJO_ARMADURAS + \u0027 - CORTE A\u0027\nSUFIJO_CORTE_B = SUFIJO_ARMADURAS + \u0027 - CORTE B\u0027\nSUFIJOS_CORTE = (SUFIJO_CORTE, SUFIJO_CORTE_B)\nPREFIJO_PEDESTAL = SUFIJO_ARMADURAS + \u0027 - PEDESTAL \u0027\n\ndef sufijo_corte(nombre):\n    for a in SUFIJOS_CORTE:\n        if nombre.endswith(a):\n            return a\n    return None\n\ndef es_callout_pedestal(nombre):\n    return PREFIJO_PEDESTAL in nombre\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\ndef label_h_de(v):\n    nombre = elem_name(v)\n    return label_h_corte if (sufijo_corte(nombre) or es_callout_pedestal(nombre)) else label_h_planta\n\ndef paper_size(v):\n    # tamano en papel (pies) = crop del modelo / escala (crop ya ajustado por 00)\n    cb = v.CropBox\n    s = v.Scale if v.Scale \u003e 0 else 1\n    return ((cb.Max.X - cb.Min.X) / s, (cb.Max.Y - cb.Min.Y) / s)\n\n# --- tipos de viewport (plantas y cortes) ---\nvp_types = [t for t in FilteredElementCollector(doc).OfClass(ElementType)\n            if t.FamilyName == \u0027Viewport\u0027]\n\ndef crear_tipo_viewport(nombre):\n    base = vp_types[0]\n    nuevo = base.Duplicate(nombre)\n    vp_types.append(nuevo)\n    log.append(\u0027Tipo de viewport {} creado (duplicado de {}).\u0027.format(nombre, elem_name(base)))\n    p = nuevo.get_Parameter(BuiltInParameter.VIEWPORT_ATTR_SHOW_LABEL)\n    if p is not None and not p.IsReadOnly and p.AsInteger() != 1:\n        p.Set(1)\n    pt = nuevo.get_Parameter(BuiltInParameter.VIEWPORT_ATTR_LABEL_TAG)\n    if pt is not None and (pt.AsElementId() is None or pt.AsElementId().Value \u003c 0):\n        labels = list(FilteredElementCollector(doc).OfClass(FamilySymbol)\n                      .OfCategory(BuiltInCategory.OST_ViewportLabel))\n        if labels:\n            pt.Set(labels[0].Id)\n        else:\n            log.append(\u0027AVISO: no hay ninguna familia View Title cargada en el proyecto; el tipo {} mostrara la linea pero no el texto.\u0027.format(nombre))\n            log.append(\u0027Carga una (Insertar \u003e Cargar familia \u003e Anotaciones \u003e titulo de vista) y re-corre.\u0027)\n    return nuevo\n\ndef buscar_tipo_viewport(texto, uso):\n    if not texto:\n        return None\n    low = texto.lower()\n    for t in vp_types:\n        if elem_name(t).lower() == low:\n            return t\n    cands = [t for t in vp_types if low in elem_name(t).lower()]\n    if len(cands) == 1:\n        return cands[0]\n    if len(cands) \u003e 1:\n        log.append(\u0027AVISO: hay {} tipos de viewport que coinciden parcialmente con \\\"{}\\\" (para {}); se usa el tipo por defecto.\u0027.format(len(cands), texto, uso))\n        log.append(\u0027Tipos disponibles: \u0027 + \u0027, \u0027.join(sorted(elem_name(t) for t in vp_types)))\n        return None\n    return crear_tipo_viewport(texto)\n\nvp_type = None\nvp_type_sec = None\n\n# --- sheets destino, ordenados por numero ---\nall_sheets = {}\nfor s in FilteredElementCollector(doc).OfClass(ViewSheet):\n    all_sheets[s.SheetNumber] = s\n\ntarget_sheets = []\nseen = set()\nfor tok in [t.strip() for t in sheets_text.split(\u0027,\u0027) if t.strip()]:\n    if tok in all_sheets:\n        matches = [all_sheets[tok]]\n    else:\n        matches = [s for n, s in all_sheets.items() if n.startswith(tok)]\n    for s in matches:\n        if s.SheetNumber not in seen:\n            seen.add(s.SheetNumber)\n            target_sheets.append(s)\ntarget_sheets.sort(key=lambda s: s.SheetNumber)\n\nif not target_sheets:\n    log.append(\u0027ERROR: ningun sheet coincide con \\\"{}\\\".\u0027.format(sheets_text))\n    log.append(\u0027Sheets del proyecto: \u0027 + \u0027, \u0027.join(sorted(all_sheets.keys())[:30]))\n    OUT = log\nelse:\n    by_type = {}\n    for ai in FilteredElementCollector(doc).OfClass(AssemblyInstance):\n        by_type.setdefault(ai.AssemblyTypeName, []).append(ai)\n    names = sorted(by_type.keys())\n    if not process_all:\n        tokens = [t.strip().lower() for t in filter_text.split(\u0027,\u0027) if t.strip()]\n        if tokens:\n            names = [n for n in names if any(tok in n.lower() for tok in tokens)]\n        else:\n            names = []\n            log.append(\u0027ERROR: \\\"Todos\\\" esta en False y el filtro esta vacio.\u0027)\n\n    view_by_name = {}\n    for v in FilteredElementCollector(doc).OfClass(View):\n        if not v.IsTemplate:\n            view_by_name[elem_name(v)] = v\n\n    placed_ids = set()\n    vp_by_view = {}\n    for vp in FilteredElementCollector(doc).OfClass(Viewport):\n        placed_ids.add(vp.ViewId.Value)\n        vp_by_view[vp.ViewId.Value] = vp\n\n    def titulo_corte(v, vp):\n        try:\n            num = vp.get_Parameter(BuiltInParameter.VIEWPORT_DETAIL_NUMBER).AsString()\n            if not num:\n                return\n            base = elem_name(v)\n            suf = sufijo_corte(base)\n            if suf:\n                base = base[:-len(suf)]\n            p = v.get_Parameter(BuiltInParameter.VIEW_DESCRIPTION)\n            if p is not None and not p.IsReadOnly:\n                p.Set(\u0027{}{} - CORTE {}\u0027.format(base, SUFIJO_ARMADURAS, num))\n        except Exception:\n            pass\n\n    def letra(idx):\n        s = \u0027\u0027\n        n = idx + 1\n        while n \u003e 0:\n            n, r = divmod(n - 1, 26)\n            s = chr(65 + r) + s\n        return s\n\n    def asignar_letra(vp, sheet):\n        usados = set()\n        for vpid in sheet.GetAllViewports():\n            ovp = doc.GetElement(vpid)\n            try:\n                dn = ovp.get_Parameter(BuiltInParameter.VIEWPORT_DETAIL_NUMBER).AsString()\n                if dn:\n                    usados.add(dn)\n            except Exception:\n                pass\n        i = 0\n        while letra(i) in usados:\n            i += 1\n        try:\n            p = vp.get_Parameter(BuiltInParameter.VIEWPORT_DETAIL_NUMBER)\n            if p is not None and not p.IsReadOnly:\n                p.Set(letra(i))\n        except Exception:\n            pass\n\n    # bloques por assembly: planta arriba + cortes + callouts, mismo eje vertical\n    bloques = []\n    retitular = []  # cortes ya colocados a los que actualizar el titulo en lamina\n    for n in names:\n        grupo = []\n        for vname in (n + SUFIJO_ARMADURAS, n + SUFIJO_CORTE, n + SUFIJO_CORTE_B):\n            v = view_by_name.get(vname)\n            if v is None:\n                log.append(\u0027AVISO: no existe la vista \\\"{}\\\" (corre 00_Vistas de assembly).\u0027.format(vname))\n            elif v.Id.Value in placed_ids:\n                log.append(\u0027AVISO: \\\"{}\\\" ya esta en un sheet, se salta.\u0027.format(vname))\n                if sufijo_corte(vname) and v.Id.Value in vp_by_view:\n                    retitular.append((v, vp_by_view[v.Id.Value]))\n            else:\n                grupo.append(v)\n        prefijo_ped = n + PREFIJO_PEDESTAL\n        for vname_ped in sorted(nm for nm in view_by_name if nm.startswith(prefijo_ped)):\n            v_ped = view_by_name[vname_ped]\n            if v_ped.Id.Value in placed_ids:\n                pass\n            else:\n                grupo.append(v_ped)\n        if grupo:\n            bloques.append(grupo)\n\n    def usable_rect(sheet):\n        col = FilteredElementCollector(doc, sheet.Id).OfCategory(BuiltInCategory.OST_TitleBlocks)\n        tb = col.FirstElement()\n        if tb is not None:\n            bb = tb.get_BoundingBox(sheet)\n            if bb is not None:\n                return (bb.Min.X + margin, bb.Min.Y + margin,\n                        bb.Max.X - margin - right_reserve, bb.Max.Y - margin)\n        o = sheet.Outline\n        return (o.Min.U + margin, o.Min.V + margin,\n                o.Max.U - margin - right_reserve, o.Max.V - margin)\n\n    def tb_type_id_de(sheet):\n        col = FilteredElementCollector(doc, sheet.Id).OfCategory(BuiltInCategory.OST_TitleBlocks)\n        tb = col.FirstElement()\n        return tb.GetTypeId() if tb is not None else ElementId.InvalidElementId\n\n    def dims_bloque(grupo):\n        ws = []\n        hs = []\n        for v in grupo:\n            w, h = paper_size(v)\n            ws.append(w)\n            hs.append(h + label_h_de(v))\n        bw = max(ws)\n        bh = sum(hs) + gap_bloque * (len(grupo) - 1)\n        return bw, bh\n\n    # ---------------- empaquetado SKYLINE (identico a 01) ----------------\n    EPS = 1e-9\n\n    def depth_max(sky, a, b):\n        d = 0.0\n        for xi, xf, dep in sky:\n            if xf \u003c= a + EPS or xi \u003e= b - EPS:\n                continue\n            if dep \u003e d:\n                d = dep\n        return d\n\n    def ocupa(sky, a, b, nd):\n        nuevos = []\n        for xi, xf, dep in sky:\n            if xi \u003c a - EPS:\n                nuevos.append([xi, min(xf, a), dep])\n            if xf \u003e b + EPS:\n                nuevos.append([max(xi, b), xf, dep])\n        nuevos.append([a, b, nd])\n        nuevos = [ss for ss in nuevos if ss[1] - ss[0] \u003e EPS]\n        nuevos.sort(key=lambda ss: ss[0])\n        sky[:] = nuevos\n\n    def mejor_pos(sky, x0, x1, H, ew, eh):\n        best = None\n        for seg in sky:\n            x = seg[0]\n            if x + ew \u003e x1 + EPS:\n                continue\n            depth = depth_max(sky, x, x + ew)\n            if depth + eh \u003e H + EPS:\n                continue\n            if best is None or depth \u003c best[1] - EPS or (abs(depth - best[1]) \u003c EPS and x \u003c best[0] - EPS):\n                best = (x, depth)\n        return best\n\n    def bin_usado(sky):\n        for xi, xf, dep in sky:\n            if dep \u003e EPS:\n                return True\n        return False\n\n    def empaquetar(dims_bloques, x0, y0, x1, y1):\n        H = y1 - y0\n        bins = []\n        asign = []\n        avisos = []\n        def nuevo():\n            bins.append([[x0, x1, 0.0]])\n            return len(bins) - 1\n        cur = nuevo()\n        for idx, (bw, bh) in enumerate(dims_bloques):\n            # el hueco reservado por bloque se escala con la densidad (esc); el\n            # tamano real de las vistas no cambia, asi que con esc \u003c 1 se montan.\n            ew = bw * esc\n            eh = bh * esc\n            pos = mejor_pos(bins[cur], x0, x1, H, ew, eh)\n            # solo abrir lamina nueva si la actual YA tiene algo; si esta fresca y\n            # aun asi no cabe, se coloca igual aca (evita la primera lamina vacia).\n            if pos is None and bin_usado(bins[cur]):\n                cur = nuevo()\n                pos = mejor_pos(bins[cur], x0, x1, H, ew, eh)\n            if pos is None:\n                pos = (x0, 0.0)\n                if bh \u003e H:\n                    avisos.append(idx)\n            bx, depth = pos\n            asign.append((cur, bx, y1 - depth))\n            ocupa(bins[cur], bx, min(bx + ew, x1), depth + eh)\n        return asign, len(bins), avisos\n\n    def bump(text, steps):\n        import re\n        last = None\n        for m in re.finditer(\u0027\\\\d+\u0027, text):\n            last = m\n        if last is None:\n            return \u0027{} {:02d}\u0027.format(text, steps + 1)\n        width = len(last.group(0))\n        val = int(last.group(0)) + steps\n        return text[:last.start()] + str(val).zfill(width) + text[last.end():]\n\n    def colocar_grupo(grupo, x_izq, y_sup, bw, sheet):\n        # apila las vistas del bloque por su tamano de CROP (compacto): cada vista\n        # ocupa crop + titulo verticalmente, centrada en el mismo eje. Las lineas de\n        # seccion que salen del crop cruzan las vistas vecinas (normal en estos\n        # planos), no se cuentan para la separacion. El centrado horizontal se\n        # ajusta con el contorno real solo en X (para alinear la columna).\n        cx = x_izq + bw / 2.0\n        y = y_sup\n        n_ok = 0\n        for v in grupo:\n            cw, ch = paper_size(v)\n            lh = label_h_de(v)\n            centro = XYZ(cx, y - ch / 2.0, 0.0)\n            try:\n                vp = Viewport.Create(doc, sheet.Id, v.Id, centro)\n                if vp is None:\n                    log.append(\u0027ERROR: Revit no permitio colocar \\\"{}\\\" en {}.\u0027.format(elem_name(v), sheet.SheetNumber))\n                    y -= ch + lh + gap_bloque\n                    continue\n                es_corte = sufijo_corte(elem_name(v)) is not None\n                es_seccional_v = es_corte or es_callout_pedestal(elem_name(v))\n                t_apl = vp_type_sec if es_seccional_v else vp_type\n                if t_apl is not None:\n                    if vp.GetTypeId() != t_apl.Id:\n                        vp.ChangeTypeId(t_apl.Id)\n                    try:\n                        gap = gap_corte if es_seccional_v else gap_planta\n                        vp.LabelOffset = XYZ(0.0, -gap, 0.0)\n                        vp.LabelLineLength = cw\n                    except Exception:\n                        pass\n                if es_corte:\n                    asignar_letra(vp, sheet)\n                    titulo_corte(v, vp)\n                # centrar la columna en X con el contorno real (no toca la Y, para\n                # no inflar la separacion vertical con las lineas de seccion)\n                try:\n                    ob = vp.GetBoxOutline()\n                    cxr = (ob.MaximumPoint.X + ob.MinimumPoint.X) / 2.0\n                    c = vp.GetBoxCenter()\n                    vp.SetBoxCenter(XYZ(c.X + (cx - cxr), c.Y, 0.0))\n                except Exception:\n                    pass\n                n_ok += 1\n                log.append(\u0027OK: \\\"{}\\\" -\u003e sheet {}\u0027.format(elem_name(v), sheet.SheetNumber))\n                y -= ch + lh + gap_bloque\n            except Exception as e:\n                log.append(\u0027ERROR colocando \\\"{}\\\": {}\u0027.format(elem_name(v), e))\n                y -= ch + lh + gap_bloque\n        return n_ok\n\n    total_vistas = sum(len(g) for g in bloques)\n    placed = 0\n    overflow = []\n    montados = 0\n\n    TransactionManager.Instance.EnsureInTransaction(doc)\n    try:\n        vp_type = buscar_tipo_viewport(vp_type_text, \u0027plantas\u0027)\n        vp_type_sec = buscar_tipo_viewport(vp_type_text_sec, \u0027cortes\u0027)\n\n        # --- retrofit: cortes ya colocados -\u003e letra + titulo ---\n        def orden_visual(par):\n            v_r, vp_r = par\n            sh_r = doc.GetElement(vp_r.SheetId)\n            c = vp_r.GetBoxCenter()\n            return (sh_r.SheetNumber if sh_r is not None else \u0027\u0027, -c.Y, c.X)\n        retitular.sort(key=orden_visual)\n        for v_fix, vp_fix in retitular:\n            dn = None\n            try:\n                dn = vp_fix.get_Parameter(BuiltInParameter.VIEWPORT_DETAIL_NUMBER).AsString()\n            except Exception:\n                pass\n            if not (dn and dn.isalpha()):\n                sh_fix = doc.GetElement(vp_fix.SheetId)\n                if sh_fix is not None:\n                    asignar_letra(vp_fix, sh_fix)\n            if vp_type_sec is not None and vp_fix.GetTypeId() != vp_type_sec.Id:\n                try:\n                    vp_fix.ChangeTypeId(vp_type_sec.Id)\n                except Exception:\n                    pass\n            try:\n                vp_fix.LabelOffset = XYZ(0.0, -gap_corte, 0.0)\n                vp_fix.LabelLineLength = paper_size(v_fix)[0]\n            except Exception:\n                pass\n            titulo_corte(v_fix, vp_fix)\n        if retitular:\n            log.append(\u0027Letra y titulo actualizados para {} cortes ya colocados.\u0027.format(len(retitular)))\n\n        if bloques:\n            x0, y0, x1, y1 = usable_rect(target_sheets[0])\n\n            dims_bloques = [dims_bloque(g) for g in bloques]\n            asign, n_bins, avisos = empaquetar(dims_bloques, x0, y0, x1, y1)\n            for idx in avisos:\n                bw, bh = dims_bloques[idx]\n                log.append(\u0027AVISO: \\\"{}\\\" ({:.0f} x {:.0f} mm en papel) es mas grande que el area util de una lamina; ocupa su columna y puede sobrepasar el borde.\u0027.format(\n                    elem_name(bloques[idx][0]), bw * 304.8, bh * 304.8))\n\n            # sheets destino vacios (los que ya tienen viewports se omiten)\n            usable_sheets = []\n            for s in target_sheets:\n                if len(list(s.GetAllViewports())) \u003e 0:\n                    log.append(\u0027AVISO: sheet {} ya tiene vistas colocadas, se omite.\u0027.format(s.SheetNumber))\n                else:\n                    usable_sheets.append(s)\n\n            def sheet_for_bin(ibin):\n                # 02 mete TODAS las vistas en las laminas que existen: si el\n                # empaquetado necesita mas bins que laminas disponibles, se reparten\n                # en round-robin sobre las mismas laminas (las vistas se montan) -\n                # nunca se descarta una vista. El slider regula cuanto se montan.\n                if not usable_sheets:\n                    return None\n                return usable_sheets[ibin % len(usable_sheets)]\n\n            montados = max(0, n_bins - len(usable_sheets)) if usable_sheets else 0\n\n            for idx, grupo in enumerate(bloques):\n                ibin, bx, by_top = asign[idx]\n                sh = sheet_for_bin(ibin)\n                if sh is None:\n                    for v in grupo:\n                        overflow.append(elem_name(v))\n                    continue\n                bw, bh = dims_bloques[idx]\n                placed += colocar_grupo(grupo, bx, by_top, bw, sh)\n    finally:\n        TransactionManager.Instance.TransactionTaskDone()\n\n    if overflow:\n        log.append(\u0027ERROR: no habia ninguna lamina destino disponible; {} vistas quedaron sin colocar.\u0027.format(len(overflow)))\n    if montados \u003e 0:\n        log.append(\u0027AVISO: {} \\\"paginas\\\" de mas se montaron sobre las laminas existentes (todas las vistas quedaron colocadas). Baja el slider \"Separacion de vistas (%)\" para que quepan mas holgadas, o corre 01 con el mismo valor para crear mas laminas.\u0027.format(montados))\n    log.insert(0, \u0027Vistas colocadas: {} de {} (skyline por crop; paginas montadas: {})\u0027.format(placed, total_vistas, montados))\n    OUT = log",
      "Engine": "PythonNet3",
