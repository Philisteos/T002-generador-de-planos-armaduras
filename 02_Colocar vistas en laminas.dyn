    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# 02_Colocar vistas en laminas - Por assembly: planta arriba + corte abajo (mismo eje),\n# bloques repartidos en grilla por los sheets destino. Si el tipo de viewport\n# con titulo no existe en el proyecto, lo crea (bootstrap: duplica uno existente,\n# activa Show Title y asigna la familia de View Title).\n#\n# Leyendas, ELIMINADO (2026-07-10 a 2026-07-21, pedido de Javier: se estaban\n# importando/colocando leyendas no deseadas): existio una funcionalidad que colocaba\n# en la esquina inferior derecha de cada sheet las vistas de tipo Legend que\n# coincidian por nombre con un tipo de familia de los assemblies del sheet - se saco\n# por completo (funciones familias_recursivas/duplicado_leyenda/colocar_leyendas,\n# la coleccion legend_by_name y su bootstrap de tipo de viewport).\n#\n# Revit 2027 / Dynamo 4 / CPython3\n# IN[0] = sheets destino: numeros separados por coma, o un prefijo comun\n# IN[1] = procesar todos los assemblies (bool)\n# IN[2] = filtro de assemblies si IN[1] es False (parcial, comas)\n# IN[3] = margen y separacion entre vistas (mm)\n# IN[4] = reserva en el lado derecho del sheet (mm), p/ cajetin lateral de la viÃƒÂ±eta\n# IN[5] = tipo de viewport para las PLANTAS (vacio = tipo por defecto)\n# IN[6] = tipo de viewport para los CORTES (vacio = tipo por defecto)\n\nimport clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (FilteredElementCollector, AssemblyInstance, ViewSheet,\n                               Viewport, View, ViewType, BuiltInCategory, XYZ, Element,\n                               ElementType, BuiltInParameter, FamilySymbol, FamilyInstance,\n                               ViewDuplicateOption, StorageType)\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nsheets_text = (IN[0] or '').strip()\nprocess_all = bool(IN[1])\nfilter_text = (IN[2] or '').strip()\nmargin = float(IN[3]) / 304.8\nright_reserve = float(IN[4]) / 304.8\nvp_type_text = (IN[5] or '').strip()\nvp_type_text_sec = (IN[6] or '').strip()\nlabel_h_planta = 12.0 / 304.8  # reserva bajo la planta para su titulo\n# los cortes muestran spot elevations por debajo del borde (04, annotation crop\n# desactivado); sin este extra el titulo queda montado sobre esas anotaciones\ngap_corte = float(IN[7]) / 304.8  # slider: distancia del titulo bajo el borde del corte\nlabel_h_corte = gap_corte + 7.0 / 304.8  # misma relacion que la planta: label_h = gap + 7 mm de alto de texto\ngap_planta = 5.0 / 304.8\n# el margen general (input, min 5 mm) queda muy angosto ENTRE planta y cortes: ambos tienen el crop ajustado al borde del assembly, sin aire extra entre medio. gap_bloque suma 10 mm fijos solo para la separacion DENTRO del bloque (planta -> corte A -> corte B); no toca margenes del sheet ni grilla entre bloques.\ngap_bloque = margin + 10.0 / 304.8\n\nlog = []\n# contrato de nombres de la rutina de ARMADURAS (ver 00): planta 'FN-1001 -\n# ARMADURA', cortes 'FN-1001 - ARMADURA - CORTE A/B'. Este graph solo coloca\n# vistas de ARMADURAS; las de Formas (FN-1001 a secas) nunca matchean.\nSUFIJO_ARMADURAS = ' - ARMADURA'\nSUFIJO_CORTE = SUFIJO_ARMADURAS + ' - CORTE A'\nSUFIJO_CORTE_B = SUFIJO_ARMADURAS + ' - CORTE B'\nSUFIJOS_CORTE = (SUFIJO_CORTE, SUFIJO_CORTE_B)\n# callouts de pedestal (00): 'FN-1001 - ARMADURA - PEDESTAL PD-1003'. Cantidad variable\n# por assembly (0, 1 o mas segun cuantos TIPOS de C-Pedestal tenga) - se agregan al\n# bloque despues de los cortes, mismo eje vertical (2026-07-21, pedido de Javier: antes\n# 00 los creaba pero nunca se colocaban en laminas).\nPREFIJO_PEDESTAL = SUFIJO_ARMADURAS + ' - PEDESTAL '\n\ndef sufijo_corte(nombre):\n    for a in SUFIJOS_CORTE:\n        if nombre.endswith(a):\n            return a\n    return None\n\ndef es_callout_pedestal(nombre):\n    return PREFIJO_PEDESTAL in nombre\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\n# --- tipos de viewport (plantas y cortes) ---\nvp_types = [t for t in FilteredElementCollector(doc).OfClass(ElementType)\n            if t.FamilyName == 'Viewport']\n\ndef crear_tipo_viewport(nombre):\n    # bootstrap: el tipo no existe todavia en el proyecto -> se crea duplicando\n    # uno existente y se configura para que muestre titulo (Show Title + familia\n    # de View Title). Asi el graph queda autosuficiente en un proyecto nuevo.\n    base = vp_types[0]\n    nuevo = base.Duplicate(nombre)\n    vp_types.append(nuevo)\n    log.append('Tipo de viewport {} creado (duplicado de {}).'.format(nombre, elem_name(base)))\n    p = nuevo.get_Parameter(BuiltInParameter.VIEWPORT_ATTR_SHOW_LABEL)\n    if p is not None and not p.IsReadOnly and p.AsInteger() != 1:\n        p.Set(1)\n    pt = nuevo.get_Parameter(BuiltInParameter.VIEWPORT_ATTR_LABEL_TAG)\n    if pt is not None and (pt.AsElementId() is None or pt.AsElementId().Value < 0):\n        labels = list(FilteredElementCollector(doc).OfClass(FamilySymbol)\n                      .OfCategory(BuiltInCategory.OST_ViewportLabel))\n        if labels:\n            pt.Set(labels[0].Id)\n        else:\n            log.append('AVISO: no hay ninguna familia View Title cargada en el proyecto; el tipo {} mostrara la linea pero no el texto.'.format(nombre))\n            log.append('Carga una (Insertar > Cargar familia > Anotaciones > titulo de vista) y re-corre.')\n    return nuevo\n\ndef buscar_tipo_viewport(texto, uso):\n    if not texto:\n        return None\n    low = texto.lower()\n    for t in vp_types:\n        if elem_name(t).lower() == low:\n            return t\n    cands = [t for t in vp_types if low in elem_name(t).lower()]\n    if len(cands) == 1:\n        return cands[0]\n    if len(cands) > 1:\n        log.append('AVISO: hay {} tipos de viewport que coinciden parcialmente con \\\"{}\\\" (para {}); se usa el tipo por defecto.'.format(len(cands), texto, uso))\n        log.append('Tipos disponibles: ' + ', '.join(sorted(elem_name(t) for t in vp_types)))\n        return None\n    # ningun tipo coincide, ni exacto ni parcial: se crea desde cero\n    return crear_tipo_viewport(texto)\n\n# vp_type y vp_type_sec se resuelven mas abajo, DENTRO de la transaccion (crear\n# un tipo nuevo via Duplicate requiere una transaccion activa).\nvp_type = None\nvp_type_sec = None\n\n# --- sheets destino, ordenados por numero ---\nall_sheets = {}\nfor s in FilteredElementCollector(doc).OfClass(ViewSheet):\n    all_sheets[s.SheetNumber] = s\n\ntarget_sheets = []\nseen = set()\nfor tok in [t.strip() for t in sheets_text.split(',') if t.strip()]:\n    if tok in all_sheets:\n        matches = [all_sheets[tok]]\n    else:\n        matches = [s for n, s in all_sheets.items() if n.startswith(tok)]\n    for s in matches:\n        if s.SheetNumber not in seen:\n            seen.add(s.SheetNumber)\n            target_sheets.append(s)\ntarget_sheets.sort(key=lambda s: s.SheetNumber)\n\nif not target_sheets:\n    log.append('ERROR: ningun sheet coincide con \\\"{}\\\".'.format(sheets_text))\n    log.append('Sheets del proyecto: ' + ', '.join(sorted(all_sheets.keys())[:30]))\n    OUT = log\nelse:\n    # --- vistas a colocar, en orden por assembly: planta y luego corte ---\n    # by_type: TODOS los tipos de assembly del proyecto (no solo los del filtro de\n    # esta corrida) - se enumeran todos para poder filtrar despues por IN[2].\n    by_type = {}\n    for ai in FilteredElementCollector(doc).OfClass(AssemblyInstance):\n        by_type.setdefault(ai.AssemblyTypeName, []).append(ai)\n    names = sorted(by_type.keys())\n    if not process_all:\n        tokens = [t.strip().lower() for t in filter_text.split(',') if t.strip()]\n        if tokens:\n            names = [n for n in names if any(tok in n.lower() for tok in tokens)]\n        else:\n            names = []\n            log.append('ERROR: \\\"Todos\\\" esta en False y el filtro esta vacio.')\n\n    view_by_name = {}\n    for v in FilteredElementCollector(doc).OfClass(View):\n        if not v.IsTemplate:\n            view_by_name[elem_name(v)] = v\n\n    placed_ids = set()\n    vp_by_view = {}\n    for vp in FilteredElementCollector(doc).OfClass(Viewport):\n        placed_ids.add(vp.ViewId.Value)\n        vp_by_view[vp.ViewId.Value] = vp\n\n    def titulo_corte(v, vp):\n        # titulo en lamina del corte = '{assembly} - {numero de detalle}', el mismo\n        # numero que muestra el simbolo de corte en la planta. Se usa Title on Sheet\n        # para no tocar el nombre interno de la vista (contrato de los otros graphs).\n        try:\n            num = vp.get_Parameter(BuiltInParameter.VIEWPORT_DETAIL_NUMBER).AsString()\n            if not num:\n                return\n            base = elem_name(v)\n            suf = sufijo_corte(base)\n            if suf:\n                base = base[:-len(suf)]\n            p = v.get_Parameter(BuiltInParameter.VIEW_DESCRIPTION)\n            if p is not None and not p.IsReadOnly:\n                # titulo en lamina con la marca de la rutina: 'FN-1001 - ARMADURA - CORTE A'\n                p.Set('{}{} - CORTE {}'.format(base, SUFIJO_ARMADURAS, num))\n        except Exception:\n            pass\n\n    def letra(idx):\n        # 0->A ... 25->Z, 26->AA, 27->AB ... (estilo columnas de Excel)\n        s = ''\n        n = idx + 1\n        while n > 0:\n            n, r = divmod(n - 1, 26)\n            s = chr(65 + r) + s\n        return s\n\n    def asignar_letra(vp, sheet):\n        # detail number del corte = siguiente letra libre en ese sheet\n        usados = set()\n        for vpid in sheet.GetAllViewports():\n            ovp = doc.GetElement(vpid)\n            try:\n                dn = ovp.get_Parameter(BuiltInParameter.VIEWPORT_DETAIL_NUMBER).AsString()\n                if dn:\n                    usados.add(dn)\n            except Exception:\n                pass\n        i = 0\n        while letra(i) in usados:\n            i += 1\n        try:\n            p = vp.get_Parameter(BuiltInParameter.VIEWPORT_DETAIL_NUMBER)\n            if p is not None and not p.IsReadOnly:\n                p.Set(letra(i))\n        except Exception:\n            pass\n\n    # bloques por assembly: planta arriba + corte abajo, centrados en el mismo eje\n    bloques = []\n    retitular = []  # cortes ya colocados a los que actualizar el titulo en lamina\n    for n in names:\n        grupo = []\n        for vname in (n + SUFIJO_ARMADURAS, n + SUFIJO_CORTE, n + SUFIJO_CORTE_B):\n            v = view_by_name.get(vname)\n            if v is None:\n                log.append('AVISO: no existe la vista \\\"{}\\\" (corre 00_Vistas de assembly).'.format(vname))\n            elif v.Id.Value in placed_ids:\n                log.append('AVISO: \\\"{}\\\" ya esta en un sheet, se salta.'.format(vname))\n                if sufijo_corte(vname) and v.Id.Value in vp_by_view:\n                    retitular.append((v, vp_by_view[v.Id.Value]))\n            else:\n                grupo.append(v)\n        prefijo_ped = n + PREFIJO_PEDESTAL\n        for vname_ped in sorted(nm for nm in view_by_name if nm.startswith(prefijo_ped)):\n            v_ped = view_by_name[vname_ped]\n            if v_ped.Id.Value in placed_ids:\n                pass\n            else:\n                grupo.append(v_ped)\n        if grupo:\n            bloques.append(grupo)\n\n    def usable_rect(sheet):\n        # area util = bbox de la viÃƒÂ±eta menos margenes (y reserva derecha)\n        col = FilteredElementCollector(doc, sheet.Id).OfCategory(BuiltInCategory.OST_TitleBlocks)\n        tb = col.FirstElement()\n        if tb is not None:\n            bb = tb.get_BoundingBox(sheet)\n            if bb is not None:\n                return (bb.Min.X + margin, bb.Min.Y + margin,\n                        bb.Max.X - margin - right_reserve, bb.Max.Y - margin)\n        o = sheet.Outline\n        return (o.Min.U + margin, o.Min.V + margin,\n                o.Max.U - margin - right_reserve, o.Max.V - margin)\n\n    def paper_size(v):\n        # tamaÃƒÂ±o en papel (pies) = crop del modelo / escala\n        cb = v.CropBox\n        s = v.Scale if v.Scale > 0 else 1\n        return ((cb.Max.X - cb.Min.X) / s, (cb.Max.Y - cb.Min.Y) / s)\n\n    def label_h_de(v):\n        nombre = elem_name(v)\n        return label_h_corte if (sufijo_corte(nombre) or es_callout_pedestal(nombre)) else label_h_planta\n\n    def medidas(grupo):\n        # bloque vertical: planta arriba, corte abajo\n        ws = []\n        hs = []\n        for v in grupo:\n            w, h = paper_size(v)\n            ws.append(w)\n            hs.append(h + label_h_de(v))\n        bw = max(ws)\n        bh = sum(hs) + gap_bloque * (len(grupo) - 1)\n        return bw, bh, hs\n\n    def colocar_grupo(grupo, hs, x_izq, y_sup, bw, sheet):\n        # coloca las vistas del bloque centradas en el mismo eje vertical. La\n        # separacion ENTRE vistas del bloque (planta -> corte A -> corte B) se\n        # ajusta con el tamaÃƒÂ±o REAL ya colocado (Viewport.GetBoxOutline(), que SI\n        # incluye anotaciones que sobresalen del CropBox - cotas, spot elevations,\n        # el multitag de capa de cimiento - porque el Annotation Crop esta\n        # desactivado). paper_size()/View.CropBox solo mide la geometria recortada\n        # y subestima el alto real cuando hay overhang, lo que antes hacia que la\n        # separacion saliera inconsistente entre assemblies con distinta cantidad\n        # de anotaciones fuera del crop.\n        cx = x_izq + bw / 2.0\n        y = y_sup\n        n_ok = 0\n        for v, hv in zip(grupo, hs):\n            w_v = paper_size(v)[0]\n            h_v = hv - label_h_de(v)\n            centro = XYZ(cx, y - h_v / 2.0, 0.0)\n            try:\n                vp = Viewport.Create(doc, sheet.Id, v.Id, centro)\n                if vp is None:\n                    log.append('ERROR: Revit no permitio colocar \\\"{}\\\" en {}.'.format(elem_name(v), sheet.SheetNumber))\n                    y -= hv + gap_bloque\n                    continue\n                es_corte = sufijo_corte(elem_name(v)) is not None\n                es_callout = es_callout_pedestal(elem_name(v))\n                es_seccional = es_corte or es_callout\n                t_apl = vp_type_sec if es_seccional else vp_type\n                if t_apl is not None:\n                    if vp.GetTypeId() != t_apl.Id:\n                        vp.ChangeTypeId(t_apl.Id)\n                    try:\n                        # titulo alineado bajo el borde inferior izquierdo de la vista;\n                        # los cortes y callouts llevan mas separacion (ver gap_corte arriba)\n                        gap = gap_corte if es_seccional else gap_planta\n                        vp.LabelOffset = XYZ(0.0, -gap, 0.0)\n                        vp.LabelLineLength = w_v\n                    except Exception:\n                        pass\n                if es_corte:\n                    asignar_letra(vp, sheet)\n                    titulo_corte(v, vp)\n                # reposicionar segun el tamaÃƒÂ±o REAL ya colocado: tope en \"y\",\n                # centrado en \"cx\" (el centro real puede no coincidir exacto con\n                # el estimado si hay anotaciones asimetricas fuera del crop)\n                ob = vp.GetBoxOutline()\n                h_real = ob.MaximumPoint.Y - ob.MinimumPoint.Y\n                centro_x_real = (ob.MaximumPoint.X + ob.MinimumPoint.X) / 2.0\n                centro_actual = vp.GetBoxCenter()\n                dx = cx - centro_x_real\n                dy = y - ob.MaximumPoint.Y\n                vp.SetBoxCenter(XYZ(centro_actual.X + dx, centro_actual.Y + dy, 0.0))\n                n_ok += 1\n                log.append('OK: \\\"{}\\\" -> sheet {}'.format(elem_name(v), sheet.SheetNumber))\n                y -= h_real + gap_bloque\n            except Exception as e:\n                log.append('ERROR colocando \\\"{}\\\": {}'.format(elem_name(v), e))\n                y -= hv + gap_bloque\n        return n_ok\n\n    # names ya viene ordenado alfabeticamente mas arriba, asi que bloques tambien\n    # queda en orden correlativo por nombre de assembly - no se reordena en ningun\n    # punto (pedido explicito de Javier: el orden de salida tiene que ser siempre el\n    # de los nombres). Ver mas abajo como se maneja un bloque mas alto que un sheet\n    # completo sin sacarlo de su lugar en este orden. Debe coincidir con\n    # 01_Calcular y crear laminas (mismo criterio, mismo orden) para que la\n    # cantidad de laminas calculada ahi siga siendo la que 02 realmente necesita.\n\n    total_vistas = sum(len(g) for g in bloques)\n    placed = 0\n    overflow = []\n    si = 0\n    state = None\n\n    TransactionManager.Instance.EnsureInTransaction(doc)\n    try:\n        vp_type = buscar_tipo_viewport(vp_type_text, 'plantas')\n        vp_type_sec = buscar_tipo_viewport(vp_type_text_sec, 'cortes')\n        # retrofit: cortes ya colocados -> letra (en orden visual por sheet) + titulo\n        def orden_visual(par):\n            v_r, vp_r = par\n            sh_r = doc.GetElement(vp_r.SheetId)\n            c = vp_r.GetBoxCenter()\n            return (sh_r.SheetNumber if sh_r is not None else '', -c.Y, c.X)\n        retitular.sort(key=orden_visual)\n        for v_fix, vp_fix in retitular:\n            dn = None\n            try:\n                dn = vp_fix.get_Parameter(BuiltInParameter.VIEWPORT_DETAIL_NUMBER).AsString()\n            except Exception:\n                pass\n            if not (dn and dn.isalpha()):\n                sh_fix = doc.GetElement(vp_fix.SheetId)\n                if sh_fix is not None:\n                    asignar_letra(vp_fix, sh_fix)\n            if vp_type_sec is not None and vp_fix.GetTypeId() != vp_type_sec.Id:\n                try:\n                    vp_fix.ChangeTypeId(vp_type_sec.Id)\n                except Exception:\n                    pass\n            try:\n                # corregir el espaciado del titulo tambien en cortes ya colocados\n                vp_fix.LabelOffset = XYZ(0.0, -gap_corte, 0.0)\n                vp_fix.LabelLineLength = paper_size(v_fix)[0]\n            except Exception:\n                pass\n            titulo_corte(v_fix, vp_fix)\n        if retitular:\n            log.append('Letra y titulo actualizados para {} cortes ya colocados.'.format(len(retitular)))\n        # Orden correlativo estricto (2026-07-21, pedido explicito de Javier: los\n        # assemblies tienen que salir en su orden original, sin reordenar ni\n        # saltarse nada). Un assembly con varios pedestales puede seguir siendo mas\n        # alto que el area util de un sheet completo (bloque de 5 vistas apiladas);\n        # en ese caso YA NO se le reserva un sheet para el solo (eso desperdiciaba\n        # el resto del sheet) - se coloca en su posicion normal dentro del orden,\n        # comparte sheet con lo que le toque al lado, y se deja que sobrepase el\n        # borde inferior sin problema (pedido explicito: \"que se salga nomas, no\n        # hay problema con eso\"). Solo el ANCHO sigue siendo motivo para saltar de\n        # fila o de sheet en el caso de estos bloques; el alto deja de serlo.\n        for grupo in bloques:\n            bw, bh, hs = medidas(grupo)\n            done = False\n            avisado_imposible = False\n            while not done:\n                if state is None:\n                    while si < len(target_sheets):\n                        sh = target_sheets[si]\n                        if len(list(sh.GetAllViewports())) > 0:\n                            log.append('AVISO: sheet {} ya tiene vistas colocadas, se omite.'.format(sh.SheetNumber))\n                            si += 1\n                            continue\n                        x0, y0, x1, y1 = usable_rect(sh)\n                        state = {'sh': sh, 'x0': x0, 'y0': y0, 'x1': x1, 'y1': y1,\n                                 'cx': x0, 'cy': y1, 'row_h': 0.0}\n                        break\n                    if state is None:\n                        for v in grupo:\n                            overflow.append(elem_name(v))\n                        done = True\n                        continue\n                imposible = bh > (state['y1'] - state['y0'])  # ni un sheet fresco completo lo contiene\n                if imposible and not avisado_imposible:\n                    log.append('AVISO: \"{}\" ({:.0f} x {:.0f} mm en papel) es mas alto que el area util de un sheet; se coloca igual y sobrepasa el borde inferior.'.format(\n                        elem_name(grupo[0]), bw * 304.8, bh * 304.8))\n                    avisado_imposible = True\n                if state['cx'] > state['x0'] and state['cx'] + bw > state['x1']:\n                    state['cx'] = state['x0']\n                    state['cy'] -= state['row_h'] + margin\n                    state['row_h'] = 0.0\n                no_cabe_alto = (not imposible) and (state['cy'] - bh < state['y0'])\n                no_cabe_ancho = state['cx'] + bw > state['x1']\n                if no_cabe_alto or no_cabe_ancho:\n                    fresh = (state['cx'] == state['x0'] and state['cy'] == state['y1'])\n                    if not fresh:\n                        si += 1\n                        state = None\n                        continue\n                    if no_cabe_ancho:\n                        log.append('AVISO: \"{}\" ({:.0f} x {:.0f} mm en papel) es mas ancho que el area util del sheet {}; se coloca igual.'.format(\n                            elem_name(grupo[0]), bw * 304.8, bh * 304.8, state['sh'].SheetNumber))\n                placed += colocar_grupo(grupo, hs, state['cx'], state['cy'], bw, state['sh'])\n                state['cx'] += bw + margin\n                if bh > state['row_h']:\n                    state['row_h'] = bh\n                done = True\n    finally:\n        TransactionManager.Instance.TransactionTaskDone()\n\n    if overflow:\n        log.append('SIN ESPACIO para {} vistas: {}'.format(len(overflow), ', '.join(overflow)))\n        log.append('Corre 01_Calcular y crear laminas para agregar las que falten y vuelve a correr este graph (lo ya colocado se respeta).')\n    log.insert(0, 'Vistas colocadas: {} de {} (planta arriba, corte abajo por assembly)'.format(placed, total_vistas))\n    OUT = log",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
