    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# 03_Colocar vistas en laminas - Por assembly: planta arriba + cortes + callouts\n# (mismo eje vertical), bloques repartidos en los sheets destino.\n#\n# EMPAQUETADO (reescrito 2026-07-23): se mide y se apila por el CROP + titulo\n# (View.CropBox/escala, ajustado por el 01), NO por el contorno con lineas de\n# seccion (esas cruzan las vistas vecinas, es normal). Reparto por COLUMNAS\n# JUSTIFICADAS: los bloques se apilan en columnas verticales, las columnas llenan\n# el ancho de la hoja y dentro de cada columna los bloques se reparten parejo para\n# llenar el alto (justificado, SIN montarse). El slider \"Separacion entre vistas\n# (mm)\" fija el espacio minimo que reclama cada bloque -> cuantas caben por hoja ->\n# cuantas laminas. 01_Calcular usa la MISMA medida y el MISMO reparto, asi que la\n# cantidad de laminas que crea 01 es la que 02 llena. 02 NO crea laminas.\n#\n# Leyendas: eliminado (2026-07-10 a 2026-07-21, pedido de Javier).\n#\n# Revit 2027 / Dynamo 4 / CPython3\n# IN[0] = sheets destino: numeros separados por coma, o un prefijo comun\n# IN[1] = procesar todos los assemblies (bool)\n# IN[2] = filtro de assemblies si IN[1] es False (parcial, comas)\n# IN[3] = margen del borde de la lamina (mm)\n# IN[4] = reserva en el lado derecho del sheet (mm)\n# IN[5] = tipo de viewport para las PLANTAS (vacio = tipo por defecto)\n# IN[6] = tipo de viewport para los CORTES (vacio = tipo por defecto)\n# IN[7] = separacion del titulo bajo el borde de los cortes (mm)\n# IN[8] = separacion entre vistas (mm) - espacio minimo entre bloques; regula\n#         cuantas vistas por lamina. DEBE coincidir con el mismo input de 02.\n\nimport clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (FilteredElementCollector, AssemblyInstance, ViewSheet,\n                               Viewport, View, ViewType, BuiltInCategory, XYZ, Element,\n                               ElementType, ElementId, BuiltInParameter, FamilySymbol,\n                               FamilyInstance, ViewDuplicateOption, StorageType)\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nsheets_text = (IN[0] or '').strip()\nprocess_all = bool(IN[1])\nfilter_text = (IN[2] or '').strip()\nmargin = float(IN[3]) / 304.8\nright_reserve = float(IN[4]) / 304.8\nvp_type_text = (IN[5] or '').strip()\nvp_type_text_sec = (IN[6] or '').strip()\ngap_corte = float(IN[7]) / 304.8   # slider: distancia del titulo bajo el borde del corte\n# separacion minima entre bloques (mm -> pies). Regula la densidad. DEBE coincidir\n# con 01. Si el input aun no existe (grafo sin re-abrir), cae a 10 mm.\ntry:\n    sep = float(IN[8]) / 304.8\nexcept Exception:\n    sep = 10.0 / 304.8\nif sep < 0:\n    sep = 0.0\ngap_planta = 5.0 / 304.8\n# reserva bajo cada vista para su titulo, usada para apilar y para el reparto\nlabel_h_planta = 12.0 / 304.8\nlabel_h_corte = (12.0 + 14.0) / 304.8\n# separacion REAL dentro de cada bloque (planta -> corte A -> corte B -> callouts):\n# margen general + 10 mm fijos.\ngap_bloque = margin + 10.0 / 304.8\n\nlog = []\nSUFIJO_ARMADURAS = ' - ARMADURA'\nSUFIJO_CORTE = SUFIJO_ARMADURAS + ' - CORTE A'\nSUFIJO_CORTE_B = SUFIJO_ARMADURAS + ' - CORTE B'\nSUFIJOS_CORTE = (SUFIJO_CORTE, SUFIJO_CORTE_B)\nPREFIJO_PEDESTAL = SUFIJO_ARMADURAS + ' - PEDESTAL '\n# CORTES DE PEDESTAL (2026-07-31, ajustado el mismo dia): los crea el 01 desde cada callout.\n# NO entran a los BLOQUES del reparto (el 02 tampoco los cuenta al calcular cuantas laminas\n# hacen falta - MANDATORIO, Javier), pero SI se colocan: aparcados FUERA de la lamina, a la\n# IZQUIERDA del recuadro de la lamina de su assembly, apilados hacia abajo - la practica del\n# modelador es tenerlos fuera del recuadro y arrastrarlos a mano. Ver el bloque \"CORTES DE\n# PEDESTAL\" al final de la colocacion. El filtro explicito de la recoleccion de bloques\n# protege contra un rename futuro (hoy quedan fuera solos: su nombre no empieza con\n# PREFIJO_PEDESTAL y esa recoleccion es una whitelist).\nSUFIJO_CORTE_PEDESTAL = SUFIJO_ARMADURAS + ' - CORTE PEDESTAL '\n# separacion horizontal (mm de papel) entre el borde izquierdo del recuadro y los cortes de\n# pedestal aparcados.\nSEP_PARK_PEDESTAL = 10.0 / 304.8\n\ndef sufijo_corte(nombre):\n    for a in SUFIJOS_CORTE:\n        if nombre.endswith(a):\n            return a\n    return None\n\ndef es_callout_pedestal(nombre):\n    return PREFIJO_PEDESTAL in nombre\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\ndef label_h_de(v):\n    nombre = elem_name(v)\n    return label_h_corte if (sufijo_corte(nombre) or es_callout_pedestal(nombre)) else label_h_planta\n\ndef paper_size(v):\n    # tamano en papel (pies) = crop del modelo / escala (crop ya ajustado por 00)\n    cb = v.CropBox\n    s = v.Scale if v.Scale > 0 else 1\n    return ((cb.Max.X - cb.Min.X) / s, (cb.Max.Y - cb.Min.Y) / s)\n\n# --- tipos de viewport (plantas y cortes) ---\nvp_types = [t for t in FilteredElementCollector(doc).OfClass(ElementType)\n            if t.FamilyName == 'Viewport']\n\ndef crear_tipo_viewport(nombre):\n    base = vp_types[0]\n    nuevo = base.Duplicate(nombre)\n    vp_types.append(nuevo)\n    log.append('Tipo de viewport {} creado (duplicado de {}).'.format(nombre, elem_name(base)))\n    p = nuevo.get_Parameter(BuiltInParameter.VIEWPORT_ATTR_SHOW_LABEL)\n    if p is not None and not p.IsReadOnly and p.AsInteger() != 1:\n        p.Set(1)\n    pt = nuevo.get_Parameter(BuiltInParameter.VIEWPORT_ATTR_LABEL_TAG)\n    if pt is not None and (pt.AsElementId() is None or pt.AsElementId().Value < 0):\n        labels = list(FilteredElementCollector(doc).OfClass(FamilySymbol)\n                      .OfCategory(BuiltInCategory.OST_ViewportLabel))\n        if labels:\n            pt.Set(labels[0].Id)\n        else:\n            log.append('AVISO: no hay ninguna familia View Title cargada en el proyecto; el tipo {} mostrara la linea pero no el texto.'.format(nombre))\n            log.append('Carga una (Insertar > Cargar familia > Anotaciones > titulo de vista) y re-corre.')\n    return nuevo\n\ndef buscar_tipo_viewport(texto, uso):\n    if not texto:\n        return None\n    low = texto.lower()\n    for t in vp_types:\n        if elem_name(t).lower() == low:\n            return t\n    cands = [t for t in vp_types if low in elem_name(t).lower()]\n    if len(cands) == 1:\n        return cands[0]\n    if len(cands) > 1:\n        log.append('AVISO: hay {} tipos de viewport que coinciden parcialmente con \\\"{}\\\" (para {}); se usa el tipo por defecto.'.format(len(cands), texto, uso))\n        log.append('Tipos disponibles: ' + ', '.join(sorted(elem_name(t) for t in vp_types)))\n        return None\n    return crear_tipo_viewport(texto)\n\nvp_type = None\nvp_type_sec = None\nvp_type_callout = None\n# Tipo de viewport de los callouts de pedestal: FIJO, no es un input de Player (pedido de\n# Javier 2026-07-28, aplica SOLO a callouts -- las plantas y cortes siguen usando sus\n# propios inputs IN[5]/IN[6]).\nNOMBRE_TIPO_VIEWPORT_CALLOUT = 'C_Titulo_General'\n\n# --- sheets destino, ordenados por numero ---\nall_sheets = {}\nfor s in FilteredElementCollector(doc).OfClass(ViewSheet):\n    all_sheets[s.SheetNumber] = s\n\ntarget_sheets = []\nseen = set()\nfor tok in [t.strip() for t in sheets_text.split(',') if t.strip()]:\n    if tok in all_sheets:\n        matches = [all_sheets[tok]]\n    else:\n        matches = [s for n, s in all_sheets.items() if n.startswith(tok)]\n    for s in matches:\n        if s.SheetNumber not in seen:\n            seen.add(s.SheetNumber)\n            target_sheets.append(s)\ntarget_sheets.sort(key=lambda s: s.SheetNumber)\n\nif not target_sheets:\n    log.append('ERROR: ningun sheet coincide con \\\"{}\\\".'.format(sheets_text))\n    log.append('Sheets del proyecto: ' + ', '.join(sorted(all_sheets.keys())[:30]))\n    OUT = log\nelse:\n    by_type = {}\n    for ai in FilteredElementCollector(doc).OfClass(AssemblyInstance):\n        by_type.setdefault(ai.AssemblyTypeName, []).append(ai)\n    names = sorted(by_type.keys())\n    if not process_all:\n        tokens = [t.strip().lower() for t in filter_text.split(',') if t.strip()]\n        if tokens:\n            names = [n for n in names if any(tok in n.lower() for tok in tokens)]\n        else:\n            names = []\n            log.append('ERROR: \\\"Todos\\\" esta en False y el filtro esta vacio.')\n\n    view_by_name = {}\n    for v in FilteredElementCollector(doc).OfClass(View):\n        if not v.IsTemplate:\n            view_by_name[elem_name(v)] = v\n\n    placed_ids = set()\n    vp_by_view = {}\n    for vp in FilteredElementCollector(doc).OfClass(Viewport):\n        placed_ids.add(vp.ViewId.Value)\n        vp_by_view[vp.ViewId.Value] = vp\n\n    def titulo_corte(v, vp):\n        try:\n            num = vp.get_Parameter(BuiltInParameter.VIEWPORT_DETAIL_NUMBER).AsString()\n            if not num:\n                return\n            base = elem_name(v)\n            suf = sufijo_corte(base)\n            if suf:\n                base = base[:-len(suf)]\n            p = v.get_Parameter(BuiltInParameter.VIEW_DESCRIPTION)\n            if p is not None and not p.IsReadOnly:\n                p.Set('{}{} - CORTE {}'.format(base, SUFIJO_ARMADURAS, num))\n        except Exception:\n            pass\n\n    def letra(idx):\n        s = ''\n        n = idx + 1\n        while n > 0:\n            n, r = divmod(n - 1, 26)\n            s = chr(65 + r) + s\n        return s\n\n    def asignar_letra(vp, sheet):\n        usados = set()\n        for vpid in sheet.GetAllViewports():\n            ovp = doc.GetElement(vpid)\n            try:\n                dn = ovp.get_Parameter(BuiltInParameter.VIEWPORT_DETAIL_NUMBER).AsString()\n                if dn:\n                    usados.add(dn)\n            except Exception:\n                pass\n        i = 0\n        while letra(i) in usados:\n            i += 1\n        try:\n            p = vp.get_Parameter(BuiltInParameter.VIEWPORT_DETAIL_NUMBER)\n            if p is not None and not p.IsReadOnly:\n                p.Set(letra(i))\n        except Exception:\n            pass\n\n    # bloques por assembly: planta arriba + cortes + callouts, mismo eje vertical\n    bloques = []\n    bloques_nombres = []  # assembly de cada bloque, para saber en que lamina cayo (cortes de pedestal)\n    retitular = []  # cortes ya colocados a los que actualizar el titulo en lamina\n    for n in names:\n        grupo = []\n        for vname in (n + SUFIJO_ARMADURAS, n + SUFIJO_CORTE, n + SUFIJO_CORTE_B):\n            v = view_by_name.get(vname)\n            if v is None:\n                log.append('AVISO: no existe la vista \\\"{}\\\" (corre 01_Vistas de assembly).'.format(vname))\n            elif v.Id.Value in placed_ids:\n                log.append('AVISO: \\\"{}\\\" ya esta en un sheet, se salta.'.format(vname))\n                if (sufijo_corte(vname) or es_callout_pedestal(vname)) and v.Id.Value in vp_by_view:\n                    retitular.append((v, vp_by_view[v.Id.Value]))\n            else:\n                grupo.append(v)\n        prefijo_ped = n + PREFIJO_PEDESTAL\n        # el 'and not in' excluye los CORTES DE PEDESTAL, ver SUFIJO_CORTE_PEDESTAL arriba\n        for vname_ped in sorted(nm for nm in view_by_name\n                                if nm.startswith(prefijo_ped) and SUFIJO_CORTE_PEDESTAL not in nm):\n            v_ped = view_by_name[vname_ped]\n            if v_ped.Id.Value in placed_ids:\n                pass\n            else:\n                grupo.append(v_ped)\n        if grupo:\n            bloques.append(grupo)\n            bloques_nombres.append(n)\n\n    def usable_rect(sheet):\n        col = FilteredElementCollector(doc, sheet.Id).OfCategory(BuiltInCategory.OST_TitleBlocks)\n        tb = col.FirstElement()\n        if tb is not None:\n            bb = tb.get_BoundingBox(sheet)\n            if bb is not None:\n                return (bb.Min.X + margin, bb.Min.Y + margin,\n                        bb.Max.X - margin - right_reserve, bb.Max.Y - margin)\n        o = sheet.Outline\n        return (o.Min.U + margin, o.Min.V + margin,\n                o.Max.U - margin - right_reserve, o.Max.V - margin)\n\n    def dims_bloque(grupo):\n        ws = []\n        hs = []\n        for v in grupo:\n            w, h = paper_size(v)\n            ws.append(w)\n            hs.append(h + label_h_de(v))\n        bw = max(ws)\n        bh = sum(hs) + gap_bloque * (len(grupo) - 1)\n        return bw, bh\n\n    # ---------------- reparto por COLUMNAS JUSTIFICADAS (identico a 01) ----------------\n    EPS = 1e-9\n\n    def pack_columns(dims, W, H):\n        pages = []\n        page = []\n        page_w = 0.0\n        col = []\n        col_h = 0.0\n        col_w = 0.0\n        for idx in range(len(dims)):\n            bw, bh = dims[idx]\n            if col and (col_h + sep + bh) > H + EPS:\n                w_need = (sep if page else 0.0) + col_w\n                if page and (page_w + w_need) > W + EPS:\n                    pages.append(page)\n                    page = []\n                    page_w = 0.0\n                    w_need = col_w\n                page.append(col)\n                page_w += w_need\n                col = []\n                col_h = 0.0\n                col_w = 0.0\n            if col:\n                col_h += sep + bh\n            else:\n                col_h = bh\n            col.append(idx)\n            if bw > col_w:\n                col_w = bw\n        if col:\n            w_need = (sep if page else 0.0) + col_w\n            if page and (page_w + w_need) > W + EPS:\n                pages.append(page)\n                page = []\n                w_need = col_w\n            page.append(col)\n        if page:\n            pages.append(page)\n        return pages\n\n    def layout(dims, x0, y0, x1, y1):\n        W = x1 - x0\n        H = y1 - y0\n        pages = pack_columns(dims, W, H)\n        asign = [None] * len(dims)\n        avisos = []\n        for i, (bw, bh) in enumerate(dims):\n            if bw > W + EPS or bh > H + EPS:\n                avisos.append(i)\n        for pi, page in enumerate(pages):\n            ncols = len(page)\n            widths = [max(dims[i][0] for i in colm) for colm in page]\n            sum_w = sum(widths)\n            gap_x = 0.0 if ncols <= 1 else (W - sum_w) / (ncols - 1)\n            if gap_x < 0:\n                gap_x = 0.0\n            cx_col = []\n            if ncols == 1:\n                left = x0 + max(0.0, (W - widths[0]) / 2.0)\n                cx_col.append(left + widths[0] / 2.0)\n            else:\n                x = x0\n                for w in widths:\n                    cx_col.append(x + w / 2.0)\n                    x += w + gap_x\n            for ci, colm in enumerate(page):\n                heights = [dims[i][1] for i in colm]\n                sum_h = sum(heights)\n                n = len(colm)\n                if n == 1:\n                    top = y1 - max(0.0, (H - heights[0]) / 2.0)\n                    asign[colm[0]] = (pi, cx_col[ci], top)\n                else:\n                    gap_y = (H - sum_h) / (n - 1)\n                    if gap_y < 0:\n                        gap_y = 0.0\n                    y = y1\n                    for k, i in enumerate(colm):\n                        asign[i] = (pi, cx_col[ci], y)\n                        y -= heights[k] + gap_y\n        return asign, len(pages), avisos\n\n    def colocar_grupo(grupo, cx, y_sup, sheet):\n        # apila las vistas del bloque por su tamano de CROP (compacto): cada vista\n        # ocupa crop + titulo verticalmente, centrada en el eje cx de su columna. Las\n        # lineas de seccion que salen del crop cruzan las vistas vecinas (normal en\n        # estos planos). El centrado horizontal se ajusta con el contorno real en X.\n        y = y_sup\n        n_ok = 0\n        for v in grupo:\n            cw, ch = paper_size(v)\n            lh = label_h_de(v)\n            centro = XYZ(cx, y - ch / 2.0, 0.0)\n            try:\n                vp = Viewport.Create(doc, sheet.Id, v.Id, centro)\n                if vp is None:\n                    log.append('ERROR: Revit no permitio colocar \\\"{}\\\" en {}.'.format(elem_name(v), sheet.SheetNumber))\n                    y -= ch + lh + gap_bloque\n                    continue\n                es_corte = sufijo_corte(elem_name(v)) is not None\n                es_callout_v = es_callout_pedestal(elem_name(v))\n                es_seccional_v = es_corte or es_callout_v\n                if es_callout_v:\n                    t_apl = vp_type_callout\n                elif es_corte:\n                    t_apl = vp_type_sec\n                else:\n                    t_apl = vp_type\n                if t_apl is not None:\n                    if vp.GetTypeId() != t_apl.Id:\n                        vp.ChangeTypeId(t_apl.Id)\n                    try:\n                        gap = gap_corte if es_seccional_v else gap_planta\n                        vp.LabelOffset = XYZ(0.0, -gap, 0.0)\n                        vp.LabelLineLength = cw\n                    except Exception:\n                        pass\n                if es_corte:\n                    asignar_letra(vp, sheet)\n                    titulo_corte(v, vp)\n                # centrar la columna en X con el contorno real (no toca la Y, para\n                # no inflar la separacion vertical con las lineas de seccion)\n                try:\n                    ob = vp.GetBoxOutline()\n                    cxr = (ob.MaximumPoint.X + ob.MinimumPoint.X) / 2.0\n                    c = vp.GetBoxCenter()\n                    vp.SetBoxCenter(XYZ(c.X + (cx - cxr), c.Y, 0.0))\n                except Exception:\n                    pass\n                n_ok += 1\n                log.append('OK: \\\"{}\\\" -> sheet {}'.format(elem_name(v), sheet.SheetNumber))\n                y -= ch + lh + gap_bloque\n            except Exception as e:\n                log.append('ERROR colocando \\\"{}\\\": {}'.format(elem_name(v), e))\n                y -= ch + lh + gap_bloque\n        return n_ok\n\n    total_vistas = sum(len(g) for g in bloques)\n    placed = 0\n    placed_ped = 0  # cortes de pedestal aparcados fuera de la lamina (no cuentan en total_vistas)\n    overflow = []\n\n    TransactionManager.Instance.EnsureInTransaction(doc)\n    try:\n        vp_type = buscar_tipo_viewport(vp_type_text, 'plantas')\n        vp_type_sec = buscar_tipo_viewport(vp_type_text_sec, 'cortes')\n        vp_type_callout = buscar_tipo_viewport(NOMBRE_TIPO_VIEWPORT_CALLOUT, 'callouts')\n\n        # --- retrofit: cortes ya colocados -> letra + titulo ---\n        def orden_visual(par):\n            v_r, vp_r = par\n            sh_r = doc.GetElement(vp_r.SheetId)\n            c = vp_r.GetBoxCenter()\n            return (sh_r.SheetNumber if sh_r is not None else '', -c.Y, c.X)\n        retitular.sort(key=orden_visual)\n        for v_fix, vp_fix in retitular:\n            if es_callout_pedestal(elem_name(v_fix)):\n                if vp_type_callout is not None and vp_fix.GetTypeId() != vp_type_callout.Id:\n                    try:\n                        vp_fix.ChangeTypeId(vp_type_callout.Id)\n                    except Exception:\n                        pass\n                try:\n                    vp_fix.LabelOffset = XYZ(0.0, -gap_corte, 0.0)\n                    vp_fix.LabelLineLength = paper_size(v_fix)[0]\n                except Exception:\n                    pass\n                continue\n            dn = None\n            try:\n                dn = vp_fix.get_Parameter(BuiltInParameter.VIEWPORT_DETAIL_NUMBER).AsString()\n            except Exception:\n                pass\n            if not (dn and dn.isalpha()):\n                sh_fix = doc.GetElement(vp_fix.SheetId)\n                if sh_fix is not None:\n                    asignar_letra(vp_fix, sh_fix)\n            if vp_type_sec is not None and vp_fix.GetTypeId() != vp_type_sec.Id:\n                try:\n                    vp_fix.ChangeTypeId(vp_type_sec.Id)\n                except Exception:\n                    pass\n            try:\n                vp_fix.LabelOffset = XYZ(0.0, -gap_corte, 0.0)\n                vp_fix.LabelLineLength = paper_size(v_fix)[0]\n            except Exception:\n                pass\n            titulo_corte(v_fix, vp_fix)\n        if retitular:\n            log.append('Letra y titulo actualizados para {} cortes/callouts ya colocados.'.format(len(retitular)))\n\n        bloque_de = {}  # assembly -> sheet donde cayo su bloque en ESTA corrida\n        if bloques:\n            x0, y0, x1, y1 = usable_rect(target_sheets[0])\n            dims_bloques = [dims_bloque(g) for g in bloques]\n            asign, n_pages, avisos = layout(dims_bloques, x0, y0, x1, y1)\n            for idx in avisos:\n                bw, bh = dims_bloques[idx]\n                log.append('AVISO: \\\"{}\\\" ({:.0f} x {:.0f} mm en papel) es mas grande que el area util de una lamina.'.format(\n                    elem_name(bloques[idx][0]), bw * 304.8, bh * 304.8))\n\n            # sheets destino vacios (los que ya tienen viewports se omiten)\n            usable_sheets = []\n            for s in target_sheets:\n                if len(list(s.GetAllViewports())) > 0:\n                    log.append('AVISO: sheet {} ya tiene vistas colocadas, se omite.'.format(s.SheetNumber))\n                else:\n                    usable_sheets.append(s)\n\n            for idx, grupo in enumerate(bloques):\n                pi, cx, by_top = asign[idx]\n                if pi < len(usable_sheets):\n                    placed += colocar_grupo(grupo, cx, by_top, usable_sheets[pi])\n                    bloque_de[bloques_nombres[idx]] = usable_sheets[pi]\n                else:\n                    for v in grupo:\n                        overflow.append(elem_name(v))\n\n            if n_pages > len(usable_sheets):\n                log.append('AVISO: se necesitan {} laminas pero hay {} destino disponibles; corre 01 con el MISMO valor del slider \"Separacion entre vistas (mm)\" para crear las que faltan y vuelve a correr 02.'.format(n_pages, len(usable_sheets)))\n\n        # --- CORTES DE PEDESTAL: aparcados FUERA de la lamina (2026-07-31, Javier) ---\n        # No entran a los bloques ni al calculo del 02 (mandatorio), pero SI se colocan:\n        # a la IZQUIERDA del recuadro de la lamina de su assembly, apilados hacia abajo,\n        # con el tipo de viewport de cortes y su letra - asi la burbuja del marcador en el\n        # callout muestra numero de detalle y lamina reales. El modelador los arrastra a\n        # mano a su posicion final (su practica habitual: quedan fuera del recuadro).\n        # Corre TAMBIEN cuando no hay bloques pendientes (retrofit de una corrida\n        # anterior): la lamina de referencia es entonces la que ya tiene la PLANTA del\n        # assembly. Idempotente: un corte ya colocado (placed_ids) no se toca.\n        park_cursor = {}\n        for n in names:\n            pend = [view_by_name[nm] for nm in sorted(view_by_name)\n                    if nm.startswith(n + SUFIJO_CORTE_PEDESTAL)\n                    and view_by_name[nm].Id.Value not in placed_ids]\n            if not pend:\n                continue\n            sheet_dest = bloque_de.get(n)\n            if sheet_dest is None:\n                v_planta = view_by_name.get(n + SUFIJO_ARMADURAS)\n                if v_planta is not None and v_planta.Id.Value in vp_by_view:\n                    sheet_dest = doc.GetElement(vp_by_view[v_planta.Id.Value].SheetId)\n            if sheet_dest is None:\n                log.append('AVISO: {} tiene {} corte(s) de pedestal pendientes pero su planta no esta en ninguna lamina; se saltan (vuelve a correr despues de colocar el bloque).'.format(n, len(pend)))\n                continue\n            x0s, y0s, x1s, y1s = usable_rect(sheet_dest)\n            borde_izq = x0s - margin  # borde REAL del recuadro (usable_rect ya sumo el margen)\n            key = sheet_dest.Id.Value\n            if key not in park_cursor:\n                park_cursor[key] = y1s\n            for v_cp in pend:\n                w_cp, h_cp = paper_size(v_cp)\n                centro_cp = XYZ(borde_izq - SEP_PARK_PEDESTAL - w_cp / 2.0,\n                                park_cursor[key] - h_cp / 2.0, 0.0)\n                try:\n                    vp_cp = Viewport.Create(doc, sheet_dest.Id, v_cp.Id, centro_cp)\n                    if vp_cp is None:\n                        log.append('ERROR: Revit no permitio colocar \"{}\" en {}.'.format(elem_name(v_cp), sheet_dest.SheetNumber))\n                        continue\n                    if vp_type_sec is not None and vp_cp.GetTypeId() != vp_type_sec.Id:\n                        vp_cp.ChangeTypeId(vp_type_sec.Id)\n                    try:\n                        vp_cp.LabelOffset = XYZ(0.0, -gap_corte, 0.0)\n                        vp_cp.LabelLineLength = w_cp\n                    except Exception:\n                        pass\n                    asignar_letra(vp_cp, sheet_dest)\n                    placed_ped += 1\n                    park_cursor[key] -= h_cp + label_h_corte + gap_bloque\n                    log.append('OK: \"{}\" -> sheet {} (aparcado FUERA de la lamina, a la izquierda).'.format(elem_name(v_cp), sheet_dest.SheetNumber))\n                except Exception as e:\n                    log.append('ERROR colocando \"{}\": {}'.format(elem_name(v_cp), e))\n    finally:\n        TransactionManager.Instance.TransactionTaskDone()\n\n    if overflow:\n        log.append('SIN COLOCAR {} vistas (faltaron laminas): {}'.format(len(overflow), ', '.join(overflow)))\n    resumen = 'Vistas colocadas: {} de {} (columnas justificadas)'.format(placed, total_vistas)\n    if placed_ped:\n        resumen += ' | cortes de pedestal aparcados fuera de la lamina: {}'.format(placed_ped)\n    log.insert(0, resumen)\n    OUT = log",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
