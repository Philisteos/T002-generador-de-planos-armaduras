    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# 04_Cotas generales (ARMADURAS) - Anotaciones por assembly\n# planta: SOLO tags de Structural Rebar segun Layout Rule (2026-07-14: se quito la cota\n# de ancho/largo que heredaba la rutina de Formas - en el plano de armaduras esa cota\n# no va) | cortes A y B: altura total (ya no se tagea la\n# capa de cimiento ni se coloca spot elevation - ambos se eliminaron el 2026-07-21,\n# pedido de Javier: aparecian tags/anotaciones no deseados en los cortes)\n#\n# Regla de negocio de los tags de armadura (2026-07-14): en la planta (todavia NO en los\n# cortes), cada Structural Rebar del assembly (miembro directo o hospedado, ver\n# rebar_del_assembly) se etiqueta con un Rebar Tag (categoria OST_RebarTags, NO Multi-Category) de la familia\n# \"C_EtiquetaArmaduras\", eligiendo el TIPO segun el parametro de instancia de la barra\n# cuyo nombre contiene \"layout\" (busqueda parcial, ver leer_layout_rule - el accessor\n# shape-driven, Rebar.GetShapeDrivenAccessor(), resulto ser de SOLO ESCRITURA, sin\n# ningun getter, asi que el valor se lee del parametro real via AsValueString(); si\n# ninguna barra tiene un parametro asi, el log vuelca todos los parametros de esa\n# barra para diagnosticar): Layout = \"Single\" -\u003e tipo\n# \"RecuentoDoble_Corto\"; Layout = \"Number with Spacing\" -\u003e tipo \"RecuentoSimple_Corto\"\n# (ver TIPO_TAG_POR_LAYOUT). Otros valores de Layout (Fixed Number, Maximum Spacing,\n# Minimum Clear Spacing) no tienen regla definida todavia: la barra queda sin etiquetar y\n# el log avisa. Idempotente por barra (no por vista): una vez\n# tageada, no se vuelve a tocar aunque el resto de la planta (cotas) se reprocese.\n# Revit 2027 / Dynamo 4 / CPython3\n# IN[0] = procesar todos los assemblies (bool)\n# IN[1] = filtro por nombre si IN[0] es False (parcial, comas)\n# IN[2] = separacion de la cota respecto al assembly, en mm de papel\n# IN[3] = ya no se usa (antes: filtro de material para los cortes, luego reemplazado\n#         por un filtro de categoria Structural Foundation para la cota de altura -\n#         esa cota se elimino por completo el 2026-07-21). Se mantiene el input\n#         conectado por compatibilidad pero el graph lo ignora.\n# IN[4] = Multi-Rebar Annotations en cortes: separacion de la primera anotacion al borde\n#         del assembly, en mm de papel (pegado al assembly; default 3).\n# IN[5] = Multi-Rebar Annotations en cortes: paso a la izquierda entre anotaciones que\n#         chocan verticalmente, en mm de papel (default 8).\n#\n# Multi-Tag de capa de cimiento, ELIMINADO (2026-07-09 a 2026-07-21): existio un\n# Multi-Category Tag (\"C-MultiCat\" tipo \"Descripcion+Comentario\") sobre el elemento\n# REAL mas bajo del assembly cuando era de la familia \"C-CapaCimiento\" - se saco por\n# completo (pedido de Javier: aparecia un tag no deseado en los cortes).\n#\n# Cota de altura en cadena, ELIMINADA (2026-07-13 a 2026-07-21, pedido de Javier: eran\n# unas cotas azules que no deberian aparecer, senalando la zapata y el pedestal):\n# existio una cadena de Dimension en los cortes (make_dim_chain, un segmento por\n# elemento Structural Foundation) - se saco por completo junto con todo lo que solo\n# ella usaba (elem_bajo/candidato_bajo, hojas_recursivas, elemento_mas_bajo, has_dims,\n# make_dim_chain, element_top_faces, top_face_de, proj_range, CAT_FOUNDATION,\n# NOMBRE_FAMILIA_CAPA_CIMIENTO). El corte ahora solo recibe la Multi-Rebar Annotation.\n\nimport clr\nclr.AddReference(\u0027RevitAPI\u0027)\nclr.AddReference(\u0027RevitServices\u0027)\nfrom Autodesk.Revit.DB import (FilteredElementCollector, AssemblyInstance, View,\n                               Options, ViewDetailLevel, Solid, GeometryInstance,\n                               PlanarFace, ReferenceArray, Line, XYZ, UV,\n                               Element, BuiltInCategory, ElementId,\n                               IndependentTag, Reference, TagOrientation, FamilyInstance,\n                               MultiReferenceAnnotation, MultiReferenceAnnotationType,\n                               MultiReferenceAnnotationOptions, BuiltInParameter, StorageType)\nfrom Autodesk.Revit.DB.Structure import (Rebar, RebarInSystem, RebarContainer, RebarHostData,\n                                         RebarPresentationMode, MultiplanarOption, RebarShape,\n                                         RebarStyle)\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\nfrom System.Collections.Generic import List\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nprocess_all = bool(IN[0])\nfilter_text = (IN[1] or \u0027\u0027).strip()\noffset_mm = float(IN[2])\n# sliders del Player para el escalonado de las Multi-Rebar Annotations en los CORTES\n# (2026-07-21, pedido de Javier: regular la separacion sin editar el codigo). mm de\n# papel. IN[4] = separacion de la primera anotacion al borde del assembly (pegado);\n# IN[5] = paso a la izquierda entre anotaciones que chocan. Ver bloque de cortes.\nclearance_tags_corte_mm = float(IN[4])\npaso_tags_corte_mm = float(IN[5])\nNOMBRE_FAMILIA_TAG_CAPA = \u0027C-MultiCat\u0027\nNOMBRE_FAMILIA_TAG_ARM = \u0027C_EtiquetaArmaduras\u0027\nTIPO_TAG_POR_LAYOUT = {\n    \u0027single\u0027: \u0027RecuentoDoble_Corto\u0027,\n    \u0027number with spacing\u0027: \u0027RecuentoSimple_Corto\u0027,\n}\nPARTITIONS_TAGEABLES = set([\u0027PPL-INF\u0027, \u0027SEC-LAT\u0027])  # 2026-07-20: renombrados desde C-INF/C-LAT (C-SUP -\u003e PPL-SUP nunca estuvo en este set)\n# Multi-Rebar Annotation (2026-07-15): ademas del Rebar Tag de arriba (coexisten sobre\n# la misma barra), anota las mismas barras que 00 dejo en modo primera-y-ultima\n# (Rebar.SetPresentationMode con RebarPresentationMode.FirstLast, ver\n# mostrar_primera_ultima en 00) y que pasan el mismo filtro de Partition\n# (PARTITIONS_TAGEABLES). No es un Rebar Tag de familia cargable: la categoria es\n# OST_MultiReferenceAnnotations (Multi-Rebar Annotations en la UI), clase\n# MultiReferenceAnnotationType, sin FamilyName - se busca por Name directo.\nNOMBRE_TIPO_MULTIREBAR = \u0027RecuentoDoble+Info_S/Linea_Largo\u0027\n# Tipo distinto para estribos/amarras en los CORTES (2026-07-21, pedido de Javier):\n# si la barra es RebarShape.RebarStyle == StirrupTie, la Multi-Rebar Annotation del\n# corte usa este tipo en vez de NOMBRE_TIPO_MULTIREBAR. Solo aplica en cortes (ver\n# es_estribo_stirrup_tie y el bloque de Multi-Rebar Annotation en cortes) - la planta\n# no se toco, sigue usando siempre NOMBRE_TIPO_MULTIREBAR.\nNOMBRE_TIPO_MULTIREBAR_ESTRIBO = \u0027RecuentoSimple+Info_S/Linea_Largo\u0027\n# Escalonado de las Multi-Rebar Annotations en los CORTES (2026-07-21, pedido de\n# Javier: se montaban unas sobre otras y sobre la zapata). La separacion base al borde\n# (clearance) y el paso entre anotaciones que chocan son SLIDERS del Player\n# (clearance_tags_corte_mm = IN[4], paso_tags_corte_mm = IN[5], ver mas arriba) para\n# poder regularlos sin editar el codigo. Solo queda constante el colchon vertical de\n# deteccion de choques (mm de PAPEL, se convierte con la escala de cada corte): cuanto\n# se suma al rango vertical de cada barra para decidir si dos anotaciones chocan (cubre\n# el largo del texto, que sobresale del rango de la barra). Si dos tags a alturas\n# distintas igual se pisan por el texto, subir este valor.\nMARGEN_MULTIREBAR_CORTE_MM = 10.0\n# margen HORIZONTAL para el escalonado del empuje hacia ARRIBA (2026-07-21, mismo\n# pedido: sets horizontales -zapata- se amontonaban a la misma altura cuando habia\n# varios en el mismo corte). Mas grande que el vertical porque tiene que cubrir el\n# ANCHO del texto (mas largo que su alto), no solo un colchon de linea.\nMARGEN_HORIZONTAL_MULTIREBAR_CORTE_MM = 60.0\n# tags de familias en la planta (ex-05, integrado 2026-07-15): misma familia de tag\n# C-MultiCat que se usaba para el tag de capa de cimiento en los cortes (eliminado\n# 2026-07-21), tipo \u0027Modelo\u0027 (el default que usaba 05).\nNOMBRE_TIPO_TAG_FAMILIAS = \u0027Modelo\u0027\nNOMBRE_FAMILIA_PEDESTAL_PURA = \u0027C-Pedestal\u0027\n\nlog = []\n# contrato de nombres de la rutina de ARMADURAS (ver 00): este graph acota las\n# vistas de ARMADURAS; las de Formas (FN-1001 a secas) nunca matchean.\nSUFIJO_ARMADURAS = \u0027 - ARMADURA\u0027\nSUFIJO_CORTE = SUFIJO_ARMADURAS + \u0027 - CORTE A\u0027\nSUFIJO_CORTE_B = SUFIJO_ARMADURAS + \u0027 - CORTE B\u0027\nPARALELO = 0.99   # tolerancia: la normal de la cara debe ser paralela a la direccion medida\nMIN_DIST = 0.01   # pies: separacion minima entre las dos referencias de una cota\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\ndef rebar_del_assembly(ai):\n    # mismo patron que armaduras_del_assembly() de 00: barras miembro directo del\n    # assembly + barras hospedadas (RebarHostData). RebarHostData se chequea en\n    # CUALQUIER instancia del assembly, a cualquier profundidad de anidamiento\n    # (instancias_recursivas, 2026-07-20) -- no solo en los miembros de PRIMER NIVEL:\n    # si el elemento que hospeda la barra es un sub-componente anidado 2+ niveles\n    # adentro de un miembro de primer nivel (mismo caso que el fix de collect_faces),\n    # RebarHostData.GetRebarHostData() sobre el miembro de primer nivel daba None y\n    # la planta quedaba sin ningun Rebar Tag ni Multi-Rebar Annotation.\n    barras = {}\n    def agregar(r):\n        try:\n            barras[r.Id.Value] = r\n        except Exception:\n            pass\n    for mid in ai.GetMemberIds():\n        el = doc.GetElement(mid)\n        if isinstance(el, (Rebar, RebarInSystem, RebarContainer)):\n            agregar(el)\n    for el in instancias_recursivas(ai):\n        try:\n            hd = RebarHostData.GetRebarHostData(el)\n        except Exception:\n            hd = None\n        if hd is None:\n            continue\n        try:\n            for r in hd.GetRebarsInHost():\n                agregar(r)\n        except Exception:\n            pass\n    return list(barras.values())\n\ndef instancias_recursivas(ai):\n    # todas las FamilyInstance del assembly a cualquier profundidad de anidamiento\n    # (a diferencia de hojas_recursivas, incluye tambien los contenedores, no solo las\n    # hojas) - mismo patron que usa 01 para lo mismo.\n    vistos = set()\n    resultado = []\n    stack = list(ai.GetMemberIds())\n    while stack:\n        eid = stack.pop()\n        if eid.Value in vistos:\n            continue\n        vistos.add(eid.Value)\n        el = doc.GetElement(eid)\n        if el is None or not isinstance(el, FamilyInstance):\n            continue\n        resultado.append(el)\n        try:\n            stack.extend(list(el.GetSubComponentIds()))\n        except Exception:\n            pass\n    return resultado\n\ndef es_familia_pedestal(nombre_familia):\n    # 2026-07-15: no todos los pedestales son la familia \\\"C-Pedestal\\\" pura - hay\n    # familias COMBINADAS fundacion+pedestal en una sola pieza (\\\"C-Fundacion+Pedestal\\\",\n    # \\\"C-Fundacion+2-Pedestal\\\"). Match por substring, mismo criterio que 01.\n    try:\n        return \u0027pedestal\u0027 in nombre_familia.strip().lower()\n    except Exception:\n        return False\n\ndef pedestales_del_assembly(ai):\n    # todas las instancias del assembly cuya familia matchea es_familia_pedestal - se\n    # usa SOLO para CONTAR cuantos pedestales tiene el assembly.\n    resultado = []\n    for el in instancias_recursivas(ai):\n        try:\n            fam = el.Symbol.Family.Name\n        except Exception:\n            continue\n        if es_familia_pedestal(fam):\n            resultado.append(el)\n    return resultado\n\ndef tipos_pedestal(ai):\n    # nombres de TIPO distintos de la familia C-Pedestal PURA en el assembly (match\n    # EXACTO de familia, igual que los callouts de pedestal de 00 - las familias\n    # combinadas fundacion+pedestal NO cuentan aca: son un solo tipo sin pedestales\n    # separables). Distinto de pedestales_del_assembly (substring), que cuenta\n    # INSTANCIAS para ocultar barras.\n    tipos = set()\n    for el in instancias_recursivas(ai):\n        try:\n            fam = el.Symbol.Family.Name\n        except Exception:\n            continue\n        if fam.strip().lower() == NOMBRE_FAMILIA_PEDESTAL_PURA.lower():\n            tipos.add(elem_name(el.Symbol).strip())\n    return tipos\n\ndef es_barra_de_pedestal(r, pedestal_ids):\n    # host de la barra (Rebar.GetHostId) y su cadena de anidamiento\n    # (FamilyInstance.SuperComponent): True si el host o algun ancestro ES una de las\n    # instancias de pedestal del assembly (pedestal_ids, ver pedestales_del_assembly).\n    try:\n        host = doc.GetElement(r.GetHostId())\n    except Exception:\n        return False\n    pasos = 0\n    while host is not None and pasos \u003c 50:\n        try:\n            hid = host.Id.Value\n        except Exception:\n            hid = None\n        if hid is not None and hid in pedestal_ids:\n            return True\n        try:\n            host = host.SuperComponent\n        except Exception:\n            host = None\n        pasos += 1\n    return False\n\ndef resolver_pedestal_de_barra(r, pedestal_ids):\n    # mismo recorrido que es_barra_de_pedestal, pero devuelve el ElementId.Value del\n    # pedestal encontrado (o None) en vez de True/False - permite saber A CUAL\n    # pedestal especifico pertenece la barra, no solo si pertenece a alguno\n    # (2026-07-21, usado en el corte para acercar cada Multi-Rebar Annotation al\n    # pedestal que le corresponde en vez de amontonarlas todas a la izquierda).\n    try:\n        host = doc.GetElement(r.GetHostId())\n    except Exception:\n        return None\n    pasos = 0\n    while host is not None and pasos \u003c 50:\n        try:\n            hid = host.Id.Value\n        except Exception:\n            hid = None\n        if hid is not None and hid in pedestal_ids:\n            return hid\n        try:\n            host = host.SuperComponent\n        except Exception:\n            host = None\n        pasos += 1\n    return None\n\ndef lado_derecho_pedestal_en_corte(pedestal_id, pedestales, vsec):\n    # True si el pedestal identificado por pedestal_id queda al lado DERECHO de los\n    # demas pedestales del assembly, proyectando el centro de cada uno sobre\n    # vsec.RightDirection (sistema local de ESTE corte especifico - cada corte tiene\n    # su propio eje). Compara contra el PROMEDIO de todos los pedestales en vez de\n    # asumir que son exactamente dos, para no fallar con 3+.\n    right_v = vsec.RightDirection\n    proyecciones = {}\n    for el in pedestales:\n        try:\n            bb = el.get_BoundingBox(None)\n            if bb is None:\n                continue\n            centro = XYZ((bb.Min.X + bb.Max.X) / 2.0, (bb.Min.Y + bb.Max.Y) / 2.0, (bb.Min.Z + bb.Max.Z) / 2.0)\n            proyecciones[el.Id.Value] = centro.DotProduct(right_v)\n        except Exception:\n            continue\n    if pedestal_id not in proyecciones or len(proyecciones) \u003c 2:\n        return False\n    promedio = sum(proyecciones.values()) / len(proyecciones)\n    return proyecciones[pedestal_id] \u003e promedio\n\ndef empuje_derecha_corte(centro, direccion, v, off_plan):\n    # Mismo criterio geometrico que posicion_afuera_assembly (funcion COMPARTIDA con\n    # la planta, no se modifica) pero forzando el empuje hacia la DERECHA - se usa\n    # SOLO para barras de un pedestal identificado como \"el de la derecha\" en un\n    # assembly con 2+ pedestales (ver lado_derecho_pedestal_en_corte), para que sus\n    # Multi-Rebar Annotation queden cerca de su propio pedestal en vez de\n    # amontonarse a la izquierda con el resto del assembly (2026-07-21, pedido de\n    # Javier: como dejar mas cerca de los pedestales a las cotas correspondientes).\n    perp = v.ViewDirection.CrossProduct(direccion)\n    if perp.GetLength() \u003c 1e-6:\n        perp = v.RightDirection\n    else:\n        perp = perp.Normalize()\n    right_v = v.RightDirection\n    if perp.DotProduct(right_v) \u003c 0:\n        perp = perp.Negate()\n    bb = v.CropBox\n    maxv = None\n    for x in (bb.Min.X, bb.Max.X):\n        for y in (bb.Min.Y, bb.Max.Y):\n            p = bb.Transform.OfPoint(XYZ(x, y, 0.0))\n            val = p.DotProduct(perp)\n            if maxv is None or val \u003e maxv:\n                maxv = val\n    val_centro = centro.DotProduct(perp)\n    destino = maxv + off_plan\n    return centro.Add(perp.Multiply(destino - val_centro)), perp\n\ndef leer_layout_rule(r):\n    # El accessor shape-driven (RebarShapeDrivenAccessor) resulto ser de SOLO\n    # ESCRITURA (2026-07-14): solo tiene SetLayoutAsSingle/SetLayoutAsFixedNumber/etc,\n    # ningun getter. El valor real hay que leerlo del parametro de instancia de la\n    # barra (busqueda por coincidencia parcial del nombre, no exacta, por si el\n    # nombre de definicion no es exactamente \"Layout\"). Devuelve (texto, None) si\n    # funciono, o (None, motivo) si no.\n    if not isinstance(r, Rebar):\n        return None, \u0027no es un Rebar individual ({})\u0027.format(type(r).__name__)\n    try:\n        parametros = list(r.Parameters)\n    except Exception as e:\n        return None, \u0027no se pudo leer Parameters: {}\u0027.format(e)\n    for p in parametros:\n        try:\n            nombre = p.Definition.Name\n        except Exception:\n            continue\n        if \u0027layout\u0027 in nombre.lower():\n            try:\n                valor = p.AsValueString()\n            except Exception:\n                valor = None\n            if valor:\n                return valor.strip(), None\n    nombres = sorted(set(p.Definition.Name for p in parametros if p.Definition is not None))\n    return None, \u0027no se encontro ningun parametro de Layout; parametros de esta barra: {}\u0027.format(\u0027, \u0027.join(nombres))\n\ndef leer_partition(r):\n    # Regla de negocio 2026-07-15: solo se tagean barras cuyo parametro de instancia\n    # \\\"Partition\\\" (texto plano, no enum - a diferencia de Layout Rule no hace falta\n    # AsValueString) valga \\\"PPL-INF\\\" o \\\"SEC-LAT\\\" (PARTITIONS_TAGEABLES, renombrados 2026-07-20 desde C-INF/C-LAT). Cualquier otro\n    # valor, o sin el parametro, no se tagea.\n    try:\n        p = r.LookupParameter(\u0027Partition\u0027)\n    except Exception:\n        p = None\n    if p is None:\n        return None\n    try:\n        valor = p.AsString()\n    except Exception:\n        valor = None\n    return valor.strip() if valor else None\n\ndef es_estribo_stirrup_tie(r):\n    # 2026-07-21 (pedido de Javier, solo para los CORTES): identifica si la barra usa\n    # una RebarShape de estilo StirrupTie (estribo/amarra) - en ese caso, la Multi-Rebar\n    # Annotation del corte debe usar NOMBRE_TIPO_MULTIREBAR_ESTRIBO en vez del tipo\n    # general. RebarShapeDrivenAccessor no expone el RebarStyle directo (mismo problema\n    # que el Layout Rule, ver leer_layout_rule) - se resuelve via el parametro de\n    # instancia \u0027Rebar Shape\u0027 (BuiltInParameter.REBAR_SHAPE, referencia a un elemento\n    # RebarShape), con fallback a buscar por nombre de parametro si ese BuiltInParameter\n    # no aplicara en este Revit. RebarShape.RebarStyle SI es una propiedad real de la\n    # API (no un parametro), se lee directo una vez resuelto el elemento.\n    if not isinstance(r, Rebar):\n        return False\n    shape = None\n    try:\n        p = r.get_Parameter(BuiltInParameter.REBAR_SHAPE)\n        if p is not None and p.StorageType == StorageType.ElementId:\n            cand = doc.GetElement(p.AsElementId())\n            if isinstance(cand, RebarShape):\n                shape = cand\n    except Exception:\n        shape = None\n    if shape is None:\n        try:\n            for p in r.Parameters:\n                try:\n                    nombre = p.Definition.Name\n                except Exception:\n                    continue\n                if \u0027shape\u0027 in nombre.lower() and p.StorageType == StorageType.ElementId:\n                    cand = doc.GetElement(p.AsElementId())\n                    if isinstance(cand, RebarShape):\n                        shape = cand\n                        break\n        except Exception:\n            pass\n    if shape is None:\n        return False\n    try:\n        return shape.RebarStyle == RebarStyle.StirrupTie\n    except Exception:\n        return False\n\ndef proyectar_al_plano_vista(v, d):\n    # componente de d dentro del plano de la vista (sin la parte a lo largo de\n    # ViewDirection), normalizada. None si d es (casi) paralelo a ViewDirection.\n    try:\n        vd = v.ViewDirection\n        en_plano = d.Subtract(vd.Multiply(d.DotProduct(vd)))\n        if en_plano.GetLength() \u003c 1e-6:\n            return None\n        return en_plano.Normalize()\n    except Exception:\n        return None\n\ndef tangente_barra_en_plano(r, v):\n    # tangente de la primera curva de la barra (Rebar.GetCenterlineCurves), proyectada\n    # al plano de la vista - direccion real de la barra en pantalla. La usan tanto\n    # direccion_cota_multirebar (rotada 90, de fallback) como el empuje hacia afuera de\n    # los Rebar Tag (directa, sin rotar - un Rebar Tag no tiene la restriccion de\n    # perpendicularidad que exige Revit para Multi-Rebar Annotation, ver mas abajo).\n    try:\n        curvas = r.GetCenterlineCurves(False, True, True, MultiplanarOption.IncludeOnlyPlanarCurves, 0)\n    except Exception:\n        return None\n    for c in curvas:\n        try:\n            tangente = c.GetEndPoint(1).Subtract(c.GetEndPoint(0))\n        except Exception:\n            continue\n        if tangente.GetLength() \u003c 1e-6:\n            continue\n        d = proyectar_al_plano_vista(v, tangente.Normalize())\n        if d is not None:\n            return d\n    return None\n\ndef direccion_cota_multirebar(r, v):\n    # Direccion de la linea de cota del Multi-Rebar Annotation. Revit exige que las\n    # referencias (las barras del set, lineas en la planta) sean PERPENDICULARES a la\n    # linea de cota - o sea, la cota corre a lo largo del camino de distribucion del\n    # set (2026-07-15, error real de la primera corrida: \"references must be linear\n    # references which are perpendicular to the dimension line\", con la diagonal del\n    # bounding box como direccion). Preferencia: la direccion del distribution path\n    # del accessor shape-driven (que si expone ESTE getter, a diferencia del Layout\n    # Rule, que no tiene ninguno - ver leer_layout_rule); fallback: perpendicular a la\n    # tangente de la barra (tangente_barra_en_plano) en el plano de la vista.\n    try:\n        acc = r.GetShapeDrivenAccessor()\n        camino = acc.GetDistributionPath()\n        d = proyectar_al_plano_vista(v, camino.Direction)\n        if d is not None:\n            return d, \u0027distribution path\u0027\n    except Exception:\n        pass\n    tangente = tangente_barra_en_plano(r, v)\n    if tangente is not None:\n        try:\n            perp = v.ViewDirection.CrossProduct(tangente)\n            d = proyectar_al_plano_vista(v, perp)\n            if d is not None:\n                return d, \u0027perpendicular al eje de la barra\u0027\n        except Exception:\n            pass\n    return None, None\n\ndef posicion_afuera_assembly(centro, direccion, v, off_plan):\n    # Empuja \u0027centro\u0027 hacia afuera del CROP BOX de la vista (ya ajustado por 00 justo\n    # al borde visible del assembly, con un margen chico y PAREJO en las 4\n    # direcciones - ver ajustar_crop_planta de 00), perpendicular a \u0027direccion\u0027, con\n    # lado FIJO por familia de direccion (2026-07-15, ver Multi-Rebar Annotation):\n    # sets/tags cuyo eje perpendicular es mas vertical van siempre ARRIBA; los que dan\n    # mas horizontal van siempre a la IZQUIERDA. No decide por en que mitad del\n    # assembly cae el centro de ESTE elemento en particular - ese criterio inicial\n    # mandaba elementos con centro casi exacto al medio a lados distintos de forma\n    # inconsistente segun redondeo. Devuelve tambien empuje_vertical (2026-07-20): True\n    # si el empuje fue hacia ARRIBA, False si fue hacia el COSTADO (izquierda) - lo usa\n    # el Multi-Rebar Annotation para saber cuando rotar el texto a Vertical.\n    # 2026-07-20: antes media el borde con la geometria solida cruda (collect_faces),\n    # que puede incluir hormigon que no se ve en el dibujo (ej. la losa de fundacion) y\n    # se extiende de forma asimetrica mas alla del refuerzo visible segun la direccion\n    # - el mismo offset_mm terminaba viendose con margenes bien distintos empujando\n    # hacia arriba vs hacia el costado. El CropBox no tiene ese problema: es el mismo\n    # rectangulo parejo en las 4 direcciones que ya ve el usuario en el dibujo.\n    perp = v.ViewDirection.CrossProduct(direccion)\n    if perp.GetLength() \u003c 1e-6:\n        perp = v.RightDirection\n    else:\n        perp = perp.Normalize()\n    up_v = v.UpDirection\n    right_v = v.RightDirection\n    empuje_vertical = abs(perp.DotProduct(up_v)) \u003e= abs(perp.DotProduct(right_v))\n    if empuje_vertical:\n        if perp.DotProduct(up_v) \u003c 0:\n            perp = perp.Negate()\n    else:\n        if perp.DotProduct(right_v) \u003e 0:\n            perp = perp.Negate()\n    bb = v.CropBox\n    maxv = None\n    for x in (bb.Min.X, bb.Max.X):\n        for y in (bb.Min.Y, bb.Max.Y):\n            p = bb.Transform.OfPoint(XYZ(x, y, 0.0))\n            val = p.DotProduct(perp)\n            if maxv is None or val \u003e maxv:\n                maxv = val\n    val_centro = centro.DotProduct(perp)\n    destino = maxv + off_plan\n    return centro.Add(perp.Multiply(destino - val_centro)), empuje_vertical, perp\n\n# --- assemblies objetivo (unicos por tipo, igual que 02) ---\nby_type = {}\nfor ai in FilteredElementCollector(doc).OfClass(AssemblyInstance):\n    by_type.setdefault(ai.AssemblyTypeName, []).append(ai)\n\nif process_all:\n    targets = sorted(by_type.keys())\nelse:\n    tokens = [t.strip().lower() for t in filter_text.split(\u0027,\u0027) if t.strip()]\n    if tokens:\n        targets = [n for n in sorted(by_type.keys())\n                   if any(tok in n.lower() for tok in tokens)]\n    else:\n        targets = []\n        log.append(\u0027ERROR: \\\"Todos\\\" esta en False y el filtro esta vacio.\u0027)\n\nviews = {}\nfor v in FilteredElementCollector(doc).OfClass(View):\n    if not v.IsTemplate:\n        views[elem_name(v)] = v\n\ndef add_solid_faces(out, s, trf, cat_id, el_id):\n    for f in s.Faces:\n        if isinstance(f, PlanarFace) and f.Reference is not None:\n            n = f.FaceNormal\n            buv = f.GetBoundingBox()\n            uv = UV((buv.Min.U + buv.Max.U) / 2.0, (buv.Min.V + buv.Max.V) / 2.0)\n            p = f.Evaluate(uv)\n            if trf is not None:\n                n = trf.OfVector(n)\n                p = trf.OfPoint(p)\n            out.append((f.Reference, n, p, cat_id, el_id))\n\ndef collect_faces(ai):\n    # caras planas con referencia de (a) TODOS los miembros de PRIMER NIVEL del\n    # assembly, sea cual sea su tipo, y (b) TODAS las FamilyInstance anidadas a\n    # cualquier profundidad (instancias_recursivas) - 2026-07-21 fix: instancias_recursivas\n    # SOLO devuelve FamilyInstance (`if not isinstance(el, FamilyInstance): continue`);\n    # un Floor (System Family, no FamilyInstance) que forme el borde real del assembly\n    # quedaba totalmente afuera de faces si SOLO se recorria instancias_recursivas, y\n    # extremes(faces, ...) terminaba agarrando la cara de un pedestal (mas cerca, no el\n    # borde real) como \"mejor candidato disponible\" para las cotas de cobertura de la\n    # Multi-Rebar Annotation - sin ningun error, solo un valor mas chico de lo real.\n    # Se combinan ambos recorridos (con un set \u0027vistos\u0027 para no procesar el mismo\n    # ElementId dos veces) para cubrir TANTO miembros de primer nivel que no son\n    # FamilyInstance (Floors, etc.) COMO el anidamiento profundo (2026-07-20, ver\n    # commit anterior: familia combinada Fundacion+Pedestal -\u003e C-Pedestal anidado -\u003e\n    # su propia C-CapaCimiento G35 anidada dentro del pedestal, que con SOLO\n    # ai.GetMemberIds() quedaba fuera o con la categoria del contenedor).\n    out = []\n    opt = Options()\n    opt.ComputeReferences = True\n    opt.DetailLevel = ViewDetailLevel.Fine\n    vistos = set()\n    def procesar(el):\n        if el is None:\n            return\n        try:\n            eid = el.Id.Value\n        except Exception:\n            eid = None\n        if eid is not None:\n            if eid in vistos:\n                return\n            vistos.add(eid)\n        try:\n            geo = el.get_Geometry(opt)\n        except Exception:\n            geo = None\n        if geo is None:\n            return\n        cat_id = el.Category.Id if el.Category is not None else None\n        for g in geo:\n            if isinstance(g, Solid) and g.Volume \u003e 1e-9:\n                add_solid_faces(out, g, None, cat_id, eid)\n            elif isinstance(g, GeometryInstance):\n                trf = g.Transform\n                for sg in g.GetSymbolGeometry():\n                    if isinstance(sg, Solid) and sg.Volume \u003e 1e-9:\n                        add_solid_faces(out, sg, trf, cat_id, eid)\n    for mid in ai.GetMemberIds():\n        procesar(doc.GetElement(mid))\n    for el in instancias_recursivas(ai):\n        procesar(el)\n    return out\n\ndef extremes(faces, d):\n    # las dos caras mas extremas cuya normal es paralela a d\n    cands = [(ref, p) for ref, n, p, c, e in faces if abs(n.DotProduct(d)) \u003e PARALELO]\n    if len(cands) \u003c 2:\n        return None\n    lo = min(cands, key=lambda c: c[1].DotProduct(d))\n    hi = max(cands, key=lambda c: c[1].DotProduct(d))\n    if hi[1].DotProduct(d) - lo[1].DotProduct(d) \u003c MIN_DIST:\n        return None\n    return lo, hi\n\ndef dim_line(d, perp, perp_value, p_lo, p_hi):\n    # linea paralela a d, desplazada a perp_value sobre el eje perp\n    c = p_lo.Add(p_hi).Multiply(0.5)\n    base = c.Add(perp.Multiply(perp_value - c.DotProduct(perp)))\n    q1 = base.Add(d.Multiply(p_lo.DotProduct(d) - base.DotProduct(d)))\n    q2 = base.Add(d.Multiply(p_hi.DotProduct(d) - base.DotProduct(d)))\n    return Line.CreateBound(q1, q2)\n\ndef crear_cotas_cobertura_multirebar(vplan, faces, r, dir_multi, perp, posicion_multi, tname):\n    # Pedido de jefatura (2026-07-21): ademas de la Multi-Rebar Annotation, dos\n    # Aligned Dimension mas, A LA MISMA ALTURA (mismo offset perpendicular, perp) que\n    # la anotacion: borde del assembly -\u003e primera barra del array, y ultima barra -\u003e\n    # borde opuesto (\"cobertura\" a cada lado del array). El borde se mide con\n    # extremes(faces, dir_multi) SIN filtrar por categoria (faces completo, sin\n    # restringir a Structural Foundation) -- a veces el elemento que forma ese borde es un Floor, no un\n    # Structural Foundation, y esto se comporta como el bounding box real del\n    # assembly con referencias reales de Revit, sin importar la categoria. La\n    # primera/ultima barra del array: Rebar.GetSubelements()[i].GetReference() sirve\n    # para IndependentTag.Create (ver referencias_para_tag) pero Revit la rechaza para\n    # NewDimension (\"Invalid number of references\", 2026-07-21, confirmado en corrida\n    # real) -- hace falta una referencia de CURVA (ComputeReferences=True sobre la\n    # geometria, mismo mecanismo que el ultimo fallback de referencias_para_tag). La\n    # barra ya esta en modo RebarPresentationMode.FirstLast PARA ESTA VISTA (ver 00),\n    # asi que pedir su geometria CON la vista como contexto (Options.View = vplan) ya\n    # devuelve solo esas dos barras simplificadas -- no hace falta elegir entre mas de\n    # dos. Se ordenan por proyeccion sobre dir_multi (min = primera, max = ultima) en\n    # vez de asumir un orden fijo.\n    try:\n        opt_barras = Options()\n        opt_barras.ComputeReferences = True\n        opt_barras.View = vplan\n        geo_barras = r.get_Geometry(opt_barras)\n    except Exception:\n        geo_barras = None\n    if geo_barras is None:\n        return 0\n    candidatos = []\n    for g in geo_barras:\n        ref_g = getattr(g, \u0027Reference\u0027, None)\n        if ref_g is None:\n            continue\n        try:\n            p0 = g.GetEndPoint(0)\n            p1 = g.GetEndPoint(1)\n        except Exception:\n            continue\n        centro_g = p0.Add(p1).Multiply(0.5)\n        candidatos.append((ref_g, centro_g.DotProduct(dir_multi)))\n    if len(candidatos) \u003c 2:\n        return 0\n    candidatos.sort(key=lambda c: c[1])\n    ref_primera = candidatos[0][0]\n    ref_ultima = candidatos[-1][0]\n    ext = extremes(faces, dir_multi)\n    if ext is None:\n        log.append(\u0027AVISO {}: barra {} sin caras extremas para la cota de cobertura.\u0027.format(tname, r.Id.Value))\n        return 0\n    (lo_ref, p_lo), (hi_ref, p_hi) = ext\n    perp_value = posicion_multi.DotProduct(perp)\n    creadas = 0\n    try:\n        ra1 = ReferenceArray()\n        ra1.Append(lo_ref)\n        ra1.Append(ref_primera)\n        line1 = dim_line(dir_multi, perp, perp_value, p_lo, posicion_multi)\n        doc.Create.NewDimension(vplan, line1, ra1)\n        creadas += 1\n    except Exception as e:\n        log.append(\u0027ERROR {} cota de cobertura inicial (barra {}): {}\u0027.format(tname, r.Id.Value, e))\n    try:\n        ra2 = ReferenceArray()\n        ra2.Append(ref_ultima)\n        ra2.Append(hi_ref)\n        line2 = dim_line(dir_multi, perp, perp_value, posicion_multi, p_hi)\n        doc.Create.NewDimension(vplan, line2, ra2)\n        creadas += 1\n    except Exception as e:\n        log.append(\u0027ERROR {} cota de cobertura final (barra {}): {}\u0027.format(tname, r.Id.Value, e))\n    return creadas\n\ndef refs_curvas_horizontales(r, vsec, up):\n    # Referencias de curva de la barra (en modo FirstLast devuelve solo la 1a y ultima\n    # barra del array) que se ven como LINEA HORIZONTAL en el plano del corte\n    # (abs(tang.RightDirection) \u003e= 0.9). Filtrar a horizontales evita la COTA DIAGONAL: una\n    # barra vista de punta, o el lado vertical de un estribo, da una referencia de PUNTO, y\n    # una Dimension entre dos puntos a distinto X mide la distancia real (diagonal), no la\n    # vertical (bug real 2026-07-21). Devuelve [(Reference, proj_en_up, punto_medio)]\n    # ordenadas por proyeccion en up (menor = mas abajo, mayor = mas arriba).\n    right = vsec.RightDirection\n    try:\n        opt = Options()\n        opt.ComputeReferences = True\n        opt.View = vsec\n        geo = r.get_Geometry(opt)\n    except Exception:\n        return []\n    if geo is None:\n        return []\n    res = []\n    for g in geo:\n        ref_g = getattr(g, \u0027Reference\u0027, None)\n        if ref_g is None:\n            continue\n        try:\n            p0 = g.GetEndPoint(0)\n            p1 = g.GetEndPoint(1)\n        except Exception:\n            continue\n        tang = p1.Subtract(p0)\n        if tang.GetLength() \u003c 1e-9:\n            continue\n        tang = tang.Normalize()\n        if abs(tang.DotProduct(right)) \u003c 0.9:\n            continue\n        centro_g = p0.Add(p1).Multiply(0.5)\n        res.append((ref_g, centro_g.DotProduct(up), centro_g))\n    res.sort(key=lambda c: c[1])\n    return res\n\ndef corte_ya_tiene_cadena(vsec):\n    # Idempotencia de la cadena: cada Multi-Rebar Annotation crea su propia Dimension\n    # (DimensionId). Si en el corte hay alguna OST_Dimensions que NO pertenece a una\n    # anotacion, la cadena vertical ya se creo (en un corte no hay otras cotas - el 04 solo\n    # acota plantas aparte). Requiere doc.Regenerate() antes, para que los DimensionId de\n    # las anotaciones recien creadas esten poblados.\n    dims_anotacion = set()\n    for a in (FilteredElementCollector(doc, vsec.Id)\n              .OfCategory(BuiltInCategory.OST_MultiReferenceAnnotations)\n              .OfClass(MultiReferenceAnnotation)):\n        try:\n            did = a.DimensionId\n            if did is not None and did != ElementId.InvalidElementId:\n                dims_anotacion.add(did.Value)\n        except Exception:\n            pass\n    for d in (FilteredElementCollector(doc, vsec.Id)\n              .OfCategory(BuiltInCategory.OST_Dimensions)\n              .WhereElementIsNotElementType()):\n        if d.Id.Value not in dims_anotacion:\n            return True\n    return False\n\ndef crear_cadena_vertical_corte(vsec, faces, barras, tname, offset_mm_val):\n    # Cadena VERTICAL de cotas de cobertura en el corte (pedido de Javier; re-implementada\n    # 2026-07-25 - existio el 2026-07-21 y se habia revertido junto con la cota de altura).\n    # Analoga a las cotas de cobertura de la planta (crear_cotas_cobertura_multirebar) pero\n    # ENCADENADA a lo largo de la altura (UpDirection): cara superior -\u003e 1a barra del set\n    # mas alto (cobertura superior); ultima barra de un set -\u003e 1a barra del siguiente (hueco\n    # entre sets consecutivos); ultima barra del set mas bajo -\u003e cara inferior (cobertura\n    # inferior). El span INTERNO de cada set NO se cota (eso lo muestra la Multi-Rebar\n    # Annotation roja). Solo participan los sets Number with Spacing con distribucion\n    # ~vertical (barras apiladas en altura) - los mismos que la anotacion empuja al costado.\n    # Va al MISMO offset lateral que las anotaciones (no mas afuera).\n    if corte_ya_tiene_cadena(vsec):\n        log.append(\u0027{}: {} ya tiene cadena vertical de cobertura, se salta.\u0027.format(tname, elem_name(vsec)))\n        return 0\n    up = vsec.UpDirection\n    right = vsec.RightDirection\n    ext = extremes(faces, up)\n    if ext is None:\n        log.append(\u0027AVISO {}: {} sin caras superior/inferior para la cadena vertical.\u0027.format(tname, elem_name(vsec)))\n        return 0\n    (cara_lo_ref, p_lo), (cara_hi_ref, p_hi) = ext\n    info = []\n    for r in barras:\n        try:\n            if not r.CanApplyPresentationMode(vsec):\n                continue\n        except Exception:\n            continue\n        layout_txt, _e = leer_layout_rule(r)\n        if layout_txt is None or layout_txt.strip().lower() != \u0027number with spacing\u0027:\n            continue\n        dir_multi, _via = direccion_cota_multirebar(r, vsec)\n        if dir_multi is None:\n            continue\n        # solo distribucion ~vertical (barras apiladas en altura)\n        if abs(dir_multi.DotProduct(up)) \u003c abs(dir_multi.DotProduct(right)):\n            continue\n        try:\n            if r.GetPresentationMode(vsec) != RebarPresentationMode.FirstLast:\n                r.SetPresentationMode(vsec, RebarPresentationMode.FirstLast)\n        except Exception:\n            pass\n        refs = refs_curvas_horizontales(r, vsec, up)\n        if len(refs) \u003c 2:\n            log.append(\u0027AVISO {}: barra {} sin curva horizontal en el plano, se omite de la cadena vertical.\u0027.format(tname, r.Id.Value))\n            continue\n        info.append({\u0027sup\u0027: refs[-1], \u0027inf\u0027: refs[0], \u0027c\u0027: (refs[0][1] + refs[-1][1]) / 2.0})\n    if not info:\n        return 0\n    info.sort(key=lambda s: -s[\u0027c\u0027])  # el mas alto primero\n    centro_ref = p_lo.Add(p_hi).Multiply(0.5)\n    off_plan = offset_mm_val / 304.8 * vsec.Scale\n    pos, _ev, perp = posicion_afuera_assembly(centro_ref, up, vsec, off_plan)\n    perp_value = pos.DotProduct(perp)\n    segmentos = [(cara_hi_ref, p_hi, info[0][\u0027sup\u0027][0], info[0][\u0027sup\u0027][2])]\n    for i in range(len(info) - 1):\n        a = info[i][\u0027inf\u0027]\n        b = info[i + 1][\u0027sup\u0027]\n        segmentos.append((a[0], a[2], b[0], b[2]))\n    ult = info[-1][\u0027inf\u0027]\n    segmentos.append((ult[0], ult[2], cara_lo_ref, p_lo))\n    creadas = 0\n    for ref_a, p_a, ref_b, p_b in segmentos:\n        try:\n            ra = ReferenceArray()\n            ra.Append(ref_a)\n            ra.Append(ref_b)\n            line = dim_line(up, perp, perp_value, p_a, p_b)\n            doc.Create.NewDimension(vsec, line, ra)\n            creadas += 1\n        except Exception as e:\n            log.append(\u0027ERROR {} segmento de cadena vertical en {}: {}\u0027.format(tname, elem_name(vsec), e))\n    if creadas:\n        log.append(\u0027OK {}: cadena vertical de cobertura en {} con {} segmentos ({} sets).\u0027.format(tname, elem_name(vsec), creadas, len(info)))\n    return creadas\n\ndef has_tags(v):\n    return (FilteredElementCollector(doc, v.Id)\n            .OfCategory(BuiltInCategory.OST_MultiCategoryTags)\n            .OfClass(IndependentTag).GetElementCount() \u003e 0)\n\ndef elementos_ya_tageados(v):\n    # ids de todos los elementos que ya tienen un Rebar Tag en esta vista\n    # (para no re-etiquetar barras ya tageadas en corridas anteriores).\n    tageados = set()\n    for tg in (FilteredElementCollector(doc, v.Id)\n               .OfCategory(BuiltInCategory.OST_RebarTags)\n               .OfClass(IndependentTag)):\n        try:\n            for tid in tg.GetTaggedLocalElementIds():\n                tageados.add(tid.Value)\n        except Exception:\n            pass\n    return tageados\n\ndef elementos_ya_anotados_multirebar(v):\n    # mismo patron que elementos_ya_tageados pero para Multi-Rebar Annotations\n    # (categoria OST_MultiReferenceAnnotations, clase MultiReferenceAnnotation): junta\n    # los ElementId de todas las referencias ya anotadas en esta vista, via\n    # GetTaggedReferences() (lista de Reference, no de ElementId como IndependentTag).\n    anotados = set()\n    for an in (FilteredElementCollector(doc, v.Id)\n               .OfCategory(BuiltInCategory.OST_MultiReferenceAnnotations)\n               .OfClass(MultiReferenceAnnotation)):\n        try:\n            for ref in an.GetTaggedReferences():\n                anotados.add(ref.ElementId.Value)\n        except Exception:\n            pass\n    return anotados\n\ndef referencias_para_tag(r, vista):\n    # Candidatos de Reference para IndependentTag.Create, en orden de preferencia.\n    # Reference(elemento) directo fallo en este modelo (\"The reference can not be\n    # tagged\", 2026-07-14) pese a que el tag manual por categoria SI funciona en la\n    # misma vista: al clickear con el mouse, Revit taguea una barra concreta del SET,\n    # y la API expone esas barras individuales como Subelements con su propia\n    # Reference (GetSubelements()[i].GetReference()) - esa es la forma que suele\n    # aceptar. Como fallback final, una referencia sacada de la geometria visible\n    # (cara o curva con ComputeReferences=True).\n    cands = []\n    try:\n        cands.append((Reference(r), \u0027Reference(elemento)\u0027))\n    except Exception:\n        pass\n    try:\n        for sub in r.GetSubelements():\n            try:\n                ref_sub = sub.GetReference()\n            except Exception:\n                continue\n            if ref_sub is not None:\n                cands.append((ref_sub, \u0027subelemento\u0027))\n                break\n    except Exception:\n        pass\n    try:\n        opt = Options()\n        opt.ComputeReferences = True\n        opt.View = vista\n        geo = r.get_Geometry(opt)\n    except Exception:\n        geo = None\n    if geo is not None:\n        ref_geo = None\n        for g in geo:\n            if isinstance(g, Solid) and g.Volume \u003e 1e-9:\n                for f in g.Faces:\n                    if f.Reference is not None:\n                        ref_geo = (f.Reference, \u0027cara de geometria\u0027)\n                        break\n            elif getattr(g, \u0027Reference\u0027, None) is not None:\n                ref_geo = (g.Reference, \u0027curva de geometria\u0027)\n            if ref_geo is not None:\n                break\n        if ref_geo is not None:\n            cands.append(ref_geo)\n    return cands\n\ntotal = 0\nTransactionManager.Instance.EnsureInTransaction(doc)\n\ntag_types_arm = {}\nfaltantes_arm = set(TIPO_TAG_POR_LAYOUT.values())\nfor t in FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_RebarTags).WhereElementIsElementType():\n    try:\n        if t.FamilyName.strip().lower() == NOMBRE_FAMILIA_TAG_ARM.lower():\n            nom = elem_name(t).strip()\n            if nom in faltantes_arm:\n                tag_types_arm[nom] = t\n                faltantes_arm.discard(nom)\n    except Exception:\n        continue\nif faltantes_arm:\n    log.append(\u0027AVISO: no se encontraron estos tipos de \"{}\" (Rebar Tag): {}. Las barras con ese Layout no se etiquetan.\u0027.format(\n        NOMBRE_FAMILIA_TAG_ARM, \u0027, \u0027.join(sorted(faltantes_arm))))\n    disponibles_arm = list(FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_RebarTags).WhereElementIsElementType())\n    if disponibles_arm:\n        log.append(\u0027Rebar Tags disponibles: \u0027 + \u0027, \u0027.join(sorted(\u0027{} : {}\u0027.format(t.FamilyName, elem_name(t)) for t in disponibles_arm)))\nfor t in tag_types_arm.values():\n    if hasattr(t, \u0027IsActive\u0027) and not t.IsActive:\n        t.Activate()\n\n# tipo de Multi-Rebar Annotation (2026-07-15, ver NOMBRE_TIPO_MULTIREBAR mas arriba) -\n# no es FamilySymbol (sin FamilyName/Activate), se busca por Name directo sobre la\n# clase MultiReferenceAnnotationType.\ntag_type_multirebar = None\nfor t in FilteredElementCollector(doc).OfClass(MultiReferenceAnnotationType):\n    try:\n        if elem_name(t).strip().lower() == NOMBRE_TIPO_MULTIREBAR.lower():\n            tag_type_multirebar = t\n            break\n    except Exception:\n        continue\nif tag_type_multirebar is None:\n    log.append(\u0027AVISO: no se encontro el Multi-Rebar Annotation Type {} (categoria Multi-Rebar Annotations); esa anotacion se omite.\u0027.format(NOMBRE_TIPO_MULTIREBAR))\n    disponibles_multirebar = list(FilteredElementCollector(doc).OfClass(MultiReferenceAnnotationType))\n    if disponibles_multirebar:\n        log.append(\u0027Multi-Rebar Annotation Types disponibles: \u0027 + \u0027, \u0027.join(sorted(elem_name(t) for t in disponibles_multirebar)))\nelif hasattr(tag_type_multirebar, \u0027IsActive\u0027) and not tag_type_multirebar.IsActive:\n    tag_type_multirebar.Activate()\n\n# tipo de Multi-Rebar Annotation para estribos/amarras en los CORTES (2026-07-21, ver\n# NOMBRE_TIPO_MULTIREBAR_ESTRIBO y es_estribo_stirrup_tie mas arriba). Si no se\n# encuentra, el corte cae de vuelta al tipo general (tag_type_multirebar) para esa\n# barra - no se deja de anotar, solo no se distingue visualmente el estribo.\ntag_type_multirebar_estribo = None\nfor t in FilteredElementCollector(doc).OfClass(MultiReferenceAnnotationType):\n    try:\n        if elem_name(t).strip().lower() == NOMBRE_TIPO_MULTIREBAR_ESTRIBO.lower():\n            tag_type_multirebar_estribo = t\n            break\n    except Exception:\n        continue\nif tag_type_multirebar_estribo is None:\n    log.append(\u0027AVISO: no se encontro el Multi-Rebar Annotation Type {} (para estribos en los cortes); esas barras usan el tipo general {}.\u0027.format(NOMBRE_TIPO_MULTIREBAR_ESTRIBO, NOMBRE_TIPO_MULTIREBAR))\nelif hasattr(tag_type_multirebar_estribo, \u0027IsActive\u0027) and not tag_type_multirebar_estribo.IsActive:\n    tag_type_multirebar_estribo.Activate()\n\n# tipo de tag para las familias de la planta (ex-05): C-MultiCat : Modelo\ntag_type_familias = None\nfor t in FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_MultiCategoryTags).WhereElementIsElementType():\n    try:\n        if (t.FamilyName.strip().lower() == NOMBRE_FAMILIA_TAG_CAPA.lower()\n                and elem_name(t).strip().lower() == NOMBRE_TIPO_TAG_FAMILIAS.lower()):\n            tag_type_familias = t\n            break\n    except Exception:\n        continue\nif tag_type_familias is None:\n    log.append(\u0027AVISO: no se encontro el tag \"{} : {}\" (Multi-Category Tag) para las familias de la planta (ex-05); ese tagueo se omite.\u0027.format(\n        NOMBRE_FAMILIA_TAG_CAPA, NOMBRE_TIPO_TAG_FAMILIAS))\nelif hasattr(tag_type_familias, \u0027IsActive\u0027) and not tag_type_familias.IsActive:\n    tag_type_familias.Activate()\n\ntry:\n    for tname in targets:\n        ai = by_type[tname][0]\n        try:\n            faces = collect_faces(ai)\n            if not faces:\n                log.append(\u0027ERROR {}: los miembros no exponen geometria con referencias.\u0027.format(tname))\n                continue\n            pedestales_ai = pedestales_del_assembly(ai)\n            pedestal_ids_ai = set(el.Id.Value for el in pedestales_ai) if len(pedestales_ai) \u003e= 2 else set()\n            # barras del assembly (miembro directo + hospedadas) - se usa tanto para la\n            # planta como para el Multi-Rebar Annotation de los cortes (2026-07-21).\n            barras_ai = rebar_del_assembly(ai)\n            # ---------- PLANTA: tags de Structural Rebar (2026-07-14: ya NO se acota ancho/largo) ----------\n            vplan = views.get(tname + SUFIJO_ARMADURAS)\n            if vplan is None:\n                log.append(\u0027AVISO {}: no existe la vista de planta (corre 01_Vistas de assembly).\u0027.format(tname))\n            else:\n                # ---------- Tags de Structural Rebar en la planta (segun Layout) ----------\n                # independiente de si la planta ya tenia cotas de una corrida anterior.\n                if barras_ai:\n                    ya_tageadas = elementos_ya_tageados(vplan)\n                    ya_anotadas_multi = elementos_ya_anotados_multirebar(vplan) if tag_type_multirebar is not None else set()\n                    pedestal_saltadas = 0\n                    partition_saltadas = 0\n                    multirebar_creadas = 0\n                    for r in barras_ai:\n                        if pedestal_ids_ai and es_barra_de_pedestal(r, pedestal_ids_ai):\n                            pedestal_saltadas += 1\n                            continue\n                        partition_val = leer_partition(r)\n                        if partition_val not in PARTITIONS_TAGEABLES:\n                            partition_saltadas += 1\n                            continue\n                        if tag_type_multirebar is not None and r.Id.Value not in ya_anotadas_multi:\n                            es_first_last = False\n                            try:\n                                if r.CanApplyPresentationMode(vplan):\n                                    es_first_last = (r.GetPresentationMode(vplan) == RebarPresentationMode.FirstLast)\n                            except Exception:\n                                es_first_last = False\n                            if es_first_last:\n                                try:\n                                    bb_multi = r.get_BoundingBox(vplan) or r.get_BoundingBox(None)\n                                    if bb_multi is None:\n                                        log.append(\u0027AVISO {}: barra {} sin bounding box, Multi-Rebar Annotation omitida.\u0027.format(tname, r.Id.Value))\n                                    else:\n                                        centro_multi = XYZ((bb_multi.Min.X + bb_multi.Max.X) / 2.0, (bb_multi.Min.Y + bb_multi.Max.Y) / 2.0, (bb_multi.Min.Z + bb_multi.Max.Z) / 2.0)\n                                        dir_multi, via_dir = direccion_cota_multirebar(r, vplan)\n                                        if dir_multi is None:\n                                            log.append(\u0027AVISO {}: barra {} sin direccion de distribucion calculable, Multi-Rebar Annotation omitida.\u0027.format(tname, r.Id.Value))\n                                        else:\n                                            # Posicion HACIA AFUERA del assembly (2026-07-15, pedido: antes quedaba al\n                                            # medio, coincidiendo con el centro de la barra) - ver posicion_afuera_assembly.\n                                            off_plan = offset_mm / 304.8 * vplan.Scale\n                                            posicion_multi, empuje_vertical_multi, perp_multi = posicion_afuera_assembly(centro_multi, dir_multi, vplan, off_plan)\n                                            # MultiReferenceAnnotationOptions (2026-07-15, firma real confirmada por\n                                            # reflexion en vivo sobre RevitAPI): NO recibe References como IndependentTag,\n                                            # recibe un ElementId del Rebar (SetElementsToDimension) - el set completo es\n                                            # UN Rebar, no hace falta el fallback de referencias_para_tag aca.\n                                            opciones_multi = MultiReferenceAnnotationOptions(tag_type_multirebar)\n                                            opciones_multi.SetElementsToDimension(List[ElementId]([r.Id]))\n                                            opciones_multi.TagHasLeader = True\n                                            opciones_multi.DimensionPlaneNormal = vplan.ViewDirection\n                                            opciones_multi.DimensionLineDirection = dir_multi\n                                            opciones_multi.DimensionLineOrigin = posicion_multi\n                                            opciones_multi.TagHeadPosition = posicion_multi\n                                            ann_multi = MultiReferenceAnnotation.Create(doc, vplan.Id, opciones_multi)\n                                            # Texto vertical SOLO cuando el empuje fue hacia el costado (izquierda,\n                                            # 2026-07-20): ahi el texto en Horizontal quedaba dificil de leer junto a\n                                            # la cota vertical; arriba se deja en Horizontal (ese si se lee bien). El\n                                            # tag interno (\"Orientation\" en el panel de Propiedades al Tab-seleccionar\n                                            # solo el texto = TagOrientation por API) se llega via\n                                            # MultiReferenceAnnotation.TagId.\n                                            if not empuje_vertical_multi:\n                                                try:\n                                                    tag_multi = doc.GetElement(ann_multi.TagId)\n                                                    if tag_multi is not None:\n                                                        tag_multi.TagOrientation = TagOrientation.Vertical\n                                                except Exception as e:\n                                                    log.append(\u0027AVISO {}: no se pudo rotar el texto del Multi-Rebar Annotation (barra {}): {}\u0027.format(tname, r.Id.Value, e))\n                                            total += 1\n                                            multirebar_creadas += 1\n                                            log.append(\u0027OK {}: Multi-Rebar Annotation creada en planta (barra {}, direccion via {}).\u0027.format(tname, r.Id.Value, via_dir))\n                                            try:\n                                                cobertura_creadas = crear_cotas_cobertura_multirebar(vplan, faces, r, dir_multi, perp_multi, posicion_multi, tname)\n                                                if cobertura_creadas:\n                                                    total += cobertura_creadas\n                                                    log.append(\u0027OK {}: {} cota(s) de cobertura junto a la Multi-Rebar Annotation (barra {}).\u0027.format(tname, cobertura_creadas, r.Id.Value))\n                                            except Exception as e:\n                                                log.append(\u0027ERROR {} cotas de cobertura (barra {}): {}\u0027.format(tname, r.Id.Value, e))\n                                except Exception as e:\n                                    log.append(\u0027ERROR {} Multi-Rebar Annotation (barra {}): {}\u0027.format(tname, r.Id.Value, e))\n                        if r.Id.Value in ya_tageadas:\n                            continue\n                        layout_txt, error_layout = leer_layout_rule(r)\n                        if layout_txt is None:\n                            log.append(\u0027AVISO {}: barra {}: {}\u0027.format(tname, r.Id.Value, error_layout))\n                            continue\n                        tipo_nombre = TIPO_TAG_POR_LAYOUT.get(layout_txt.strip().lower())\n                        if tipo_nombre is None:\n                            log.append(\u0027AVISO {}: Layout \"{}\" (barra {}) sin regla de tag definida, no se etiqueta.\u0027.format(tname, layout_txt, r.Id.Value))\n                            continue\n                        tag_type_arm = tag_types_arm.get(tipo_nombre)\n                        if tag_type_arm is None:\n                            continue  # ya se aviso mas arriba que falta este tipo\n                        try:\n                            bb = r.get_BoundingBox(vplan) or r.get_BoundingBox(None)\n                            if bb is None:\n                                log.append(\u0027AVISO {}: barra {} sin bounding box, no se etiqueta.\u0027.format(tname, r.Id.Value))\n                                continue\n                            centro = XYZ((bb.Min.X + bb.Max.X) / 2.0, (bb.Min.Y + bb.Max.Y) / 2.0, (bb.Min.Z + bb.Max.Z) / 2.0)\n                            # Posicion HACIA AFUERA del assembly (2026-07-15, mismo pedido que el\n                            # Multi-Rebar Annotation): el Rebar Tag se colocaba en \u0027centro\u0027 (el propio\n                            # centro de la barra, dentro del assembly) - se empuja con\n                            # posicion_afuera_assembly, usando la TANGENTE de la barra (no la\n                            # perpendicular como el Multi-Rebar: un Rebar Tag no tiene la restriccion de\n                            # perpendicularidad de Revit, asi que se empuja de costado a la barra misma,\n                            # con el mismo leader (addLeader=True) conectandolo de vuelta). Si no se\n                            # puede calcular la tangente (geometria rara), se etiqueta igual en \u0027centro\u0027\n                            # como antes, sin fallar.\n                            tangente_tag = tangente_barra_en_plano(r, vplan)\n                            empuje_vertical_tag = True\n                            if tangente_tag is not None:\n                                off_plan_tag = offset_mm / 304.8 * vplan.Scale\n                                centro, empuje_vertical_tag, _perp_tag = posicion_afuera_assembly(centro, tangente_tag, vplan, off_plan_tag)\n                            # Texto vertical cuando queda a la izquierda (2026-07-20, mismo criterio que\n                            # el Multi-Rebar Annotation, ver posicion_afuera_assembly): a diferencia de\n                            # ese, IndependentTag.Create recibe el TagOrientation directo al crear el\n                            # tag, sin necesidad de ir a buscarlo despues via TagId.\n                            orientacion_tag = TagOrientation.Horizontal if empuje_vertical_tag else TagOrientation.Vertical\n                            creado = False\n                            errores_ref = []\n                            for ref_tag, desc_ref in referencias_para_tag(r, vplan):\n                                try:\n                                    IndependentTag.Create(doc, tag_type_arm.Id, vplan.Id, ref_tag, True, orientacion_tag, centro)\n                                    total += 1\n                                    log.append(\u0027OK {}: tag de armadura ({}) creado en planta (via {}).\u0027.format(tname, layout_txt, desc_ref))\n                                    creado = True\n                                    break\n                                except Exception as e:\n                                    errores_ref.append(\u0027{}: {}\u0027.format(desc_ref, str(e).splitlines()[0][:120]))\n                            if not creado:\n                                log.append(\u0027ERROR {} tag de armadura (barra {}): ninguna referencia funciono [{}]\u0027.format(tname, r.Id.Value, \u0027 | \u0027.join(errores_ref) if errores_ref else \u0027sin candidatos\u0027))\n                        except Exception as e:\n                            log.append(\u0027ERROR {} tag de armadura (barra {}): {}\u0027.format(tname, r.Id.Value, e))\n                    if pedestal_saltadas:\n                        log.append(\u0027{}: {} barras de pedestal sin etiquetar en la planta ({} pedestales en el assembly).\u0027.format(tname, pedestal_saltadas, len(pedestales_ai)))\n                    if partition_saltadas:\n                        log.append(\u0027{}: {} barras sin etiquetar en la planta (Partition fuera de {}).\u0027.format(tname, partition_saltadas, sorted(PARTITIONS_TAGEABLES)))\n                    if multirebar_creadas:\n                        log.append(\u0027{}: {} Multi-Rebar Annotations creadas en la planta (barras en modo primera-y-ultima).\u0027.format(tname, multirebar_creadas))\n                # ---------- Tags de familias (ex-05, integrado 2026-07-15) ----------\n                # Multi-Category Tag a cada FamilyInstance de PRIMER NIVEL del assembly\n                # (las anidadas se saltan, tienen SuperComponent), SOLO si el assembly\n                # tiene 2+ TIPOS distintos de C-Pedestal (mismo criterio que los\n                # callouts de 00: estos tags existen para distinguir pedestales entre\n                # si; con 0, 1 o varios del MISMO tipo no se tagea nada). Idempotente:\n                # se salta si la planta ya tiene algun Multi-Category Tag (los Rebar\n                # Tags de arriba son otra categoria, no cuentan).\n                if tag_type_familias is not None:\n                    tipos_ped = tipos_pedestal(ai)\n                    if len(tipos_ped) \u003c 2:\n                        log.append(\u0027{}: {} tipo(s) de C-Pedestal (se requieren 2+ distintos), planta sin tags de familias.\u0027.format(tname, len(tipos_ped)))\n                    elif has_tags(vplan):\n                        log.append(\u0027{}: la planta ya tiene tags de familias, se salta.\u0027.format(tname))\n                    else:\n                        n_fam = 0\n                        omitidas_fam = 0\n                        for mid in ai.GetMemberIds():\n                            el = doc.GetElement(mid)\n                            if el is None or el.Category is None or not isinstance(el, FamilyInstance):\n                                continue\n                            sup = None\n                            try:\n                                sup = el.SuperComponent\n                            except Exception:\n                                pass\n                            if sup is not None:\n                                continue\n                            try:\n                                bb = el.get_BoundingBox(None)\n                                if bb is None:\n                                    continue\n                                centro_fam = XYZ((bb.Min.X + bb.Max.X) / 2.0, (bb.Min.Y + bb.Max.Y) / 2.0, (bb.Min.Z + bb.Max.Z) / 2.0)\n                                IndependentTag.Create(doc, tag_type_familias.Id, vplan.Id, Reference(el), False, TagOrientation.Horizontal, centro_fam)\n                                n_fam += 1\n                            except Exception:\n                                omitidas_fam += 1\n                        total += n_fam\n                        msg_fam = \u0027OK {}: {} tags de familias en la planta ({} tipos de C-Pedestal).\u0027.format(tname, n_fam, len(tipos_ped))\n                        if omitidas_fam:\n                            msg_fam += \u0027 {} familias no admiten este tag.\u0027.format(omitidas_fam)\n                        log.append(msg_fam)\n            # ---------- CORTES A y B ----------\n            # ya no se acota la altura en cadena (2026-07-21, pedido de Javier: eran\n            # unas cotas azules que no deberian aparecer, senalando la zapata y el\n            # pedestal - ver README). El corte solo recibe la Multi-Rebar Annotation\n            # de mas abajo.\n\n            for suf, nombre_corte in ((SUFIJO_CORTE, \u0027corte A\u0027), (SUFIJO_CORTE_B, \u0027corte B\u0027)):\n                vsec = views.get(tname + suf)\n                if vsec is None:\n                    log.append(\u0027AVISO {}: no existe la vista de {} (corre 01_Vistas de assembly).\u0027.format(tname, nombre_corte))\n                    continue\n                # --- Multi-Rebar Annotation en el corte: mismo tratamiento \u0027primera y\n                # ultima barra\u0027 que la planta (SetPresentationMode FirstLast + Multi-\n                # Rebar Annotation), pedido 2026-07-21. A diferencia de la planta, aca\n                # NO se filtra por Partition ni se excluye armadura de pedestal - los\n                # cortes ya muestran toda la armadura del assembly a proposito (ver\n                # README). Solo Layout == Number with Spacing y CanApplyPresentationMode\n                # en ESTA vista (el modo es un estado por VISTA - 00 solo lo aplica en\n                # la planta, aca hay que aplicarlo tambien para el corte). Posicion:\n                # reusa posicion_afuera_assembly (misma funcion que la planta, sin\n                # modificarla) - empuja siempre a la izquierda los sets cuya linea de\n                # cota es vertical (ej. estribos de pedestal separados a lo largo de la\n                # altura) y siempre arriba los que dan linea de cota horizontal (ej.\n                # barras de zapata separadas a lo ancho).\n                if tag_type_multirebar is not None and barras_ai:\n                    ya_anotadas_multi_corte = elementos_ya_anotados_multirebar(vsec)\n                    multirebar_corte_creadas = 0\n                    # rango vertical (proyeccion sobre UpDirection) + banda X de cada\n                    # anotacion izquierda ya colocada en ESTE corte, para escalonar las\n                    # que choquen (ver constantes ..._MULTIREBAR_CORTE_MM). Bandas separadas para\n                    # izquierda, derecha (pedestal especifico, ver mas abajo) y arriba -\n                    # cada familia de empuje escalona independiente de las demas.\n                    bandas_izq_corte = []\n                    bandas_der_corte = []\n                    bandas_arriba_corte = []\n                    for r in barras_ai:\n                        if r.Id.Value in ya_anotadas_multi_corte:\n                            continue\n                        try:\n                            si_aplica_corte = r.CanApplyPresentationMode(vsec)\n                        except Exception:\n                            si_aplica_corte = False\n                        if not si_aplica_corte:\n                            continue\n                        layout_txt_corte, _err_layout_corte = leer_layout_rule(r)\n                        if layout_txt_corte is None or layout_txt_corte.strip().lower() != \u0027number with spacing\u0027:\n                            continue\n                        try:\n                            if r.GetPresentationMode(vsec) != RebarPresentationMode.FirstLast:\n                                r.SetPresentationMode(vsec, RebarPresentationMode.FirstLast)\n                        except Exception as e:\n                            log.append(\u0027ERROR {} {}: no se pudo aplicar primera-y-ultima barra (barra {}): {}\u0027.format(tname, nombre_corte, r.Id.Value, e))\n                            continue\n                        try:\n                            bb_multi_corte = r.get_BoundingBox(vsec) or r.get_BoundingBox(None)\n                            if bb_multi_corte is None:\n                                log.append(\u0027AVISO {} {}: barra {} sin bounding box, Multi-Rebar Annotation omitida.\u0027.format(tname, nombre_corte, r.Id.Value))\n                                continue\n                            centro_multi_corte = XYZ((bb_multi_corte.Min.X + bb_multi_corte.Max.X) / 2.0, (bb_multi_corte.Min.Y + bb_multi_corte.Max.Y) / 2.0, (bb_multi_corte.Min.Z + bb_multi_corte.Max.Z) / 2.0)\n                            dir_multi_corte, via_dir_corte = direccion_cota_multirebar(r, vsec)\n                            if dir_multi_corte is None:\n                                log.append(\u0027AVISO {} {}: barra {} sin direccion de distribucion calculable, Multi-Rebar Annotation omitida.\u0027.format(tname, nombre_corte, r.Id.Value))\n                                continue\n                            off_plan_corte = offset_mm / 304.8 * vsec.Scale\n                            posicion_multi_corte, empuje_vertical_multi_corte, perp_multi_corte = posicion_afuera_assembly(centro_multi_corte, dir_multi_corte, vsec, off_plan_corte)\n                            if not empuje_vertical_multi_corte:\n                                # EMPUJE A LA IZQUIERDA O DERECHA (2026-07-21, pedido de Javier: las\n                                # anotaciones se montaban unas sobre otras y sobre la zapata).\n                                # (a) arrancar POR FUERA del borde del assembly (clearance\n                                # positivo, no el offset_mm negativo por defecto que las\n                                # dejaba adentro, sobre el hormigon); (b) escalonar: si la\n                                # altura del TEXTO de esta barra choca con una anotacion ya\n                                # colocada en la misma banda, correrla un paso mas hacia\n                                # afuera hasta quedar libre.\n                                # LADO (2026-07-21, mismo dia, pedido de Javier: \"en cortes con\n                                # 2+ pedestales, las cotas de ambos se van hacia la izquierda y\n                                # se juntan - dejar mas cerca de los pedestales a las que le\n                                # corresponden para que se vea mas equilibrada la vista\"): si el\n                                # assembly tiene 2+ pedestales (pedestal_ids_ai) y esta barra\n                                # resuelve a uno especifico (resolver_pedestal_de_barra), se\n                                # empuja hacia el lado de ESE pedestal (lado_derecho_pedestal_en_\n                                # corte, comparando cada pedestal contra el promedio de todos en\n                                # el eje RightDirection de este corte) en vez de siempre a la\n                                # izquierda. Barras sin pedestal resuelto (ej. zapata) o\n                                # assemblies con 0/1 pedestal siguen con el criterio fijo de\n                                # siempre a la izquierda (sin cambios de comportamiento ahi).\n                                off_clear_corte = clearance_tags_corte_mm / 304.8 * vsec.Scale\n                                usar_derecha_corte = False\n                                if pedestal_ids_ai:\n                                    pedestal_barra_id = resolver_pedestal_de_barra(r, pedestal_ids_ai)\n                                    if pedestal_barra_id is not None:\n                                        usar_derecha_corte = lado_derecho_pedestal_en_corte(pedestal_barra_id, pedestales_ai, vsec)\n                                if usar_derecha_corte:\n                                    posicion_multi_corte, perp_multi_corte = empuje_derecha_corte(centro_multi_corte, dir_multi_corte, vsec, off_clear_corte)\n                                    bandas_lado_corte = bandas_der_corte\n                                else:\n                                    posicion_multi_corte, _ev_clear, perp_multi_corte = posicion_afuera_assembly(centro_multi_corte, dir_multi_corte, vsec, off_clear_corte)\n                                    bandas_lado_corte = bandas_izq_corte\n                                up_corte = vsec.UpDirection\n                                # banda de choque basada en la ALTURA DEL TEXTO (centro de\n                                # la barra = donde queda el tag), NO en la extension completa\n                                # de la barra (2026-07-21, fix: los sets verticales largos -\n                                # estribos de pedestal, bbox de z=0 a toda la altura - tapaban\n                                # TODA la columna izquierda y empujaban lejos a los tags de la\n                                # zapata, que estan abajo, aunque sus TEXTOS no se pisaran por\n                                # estar a alturas muy distintas. Confirmado por Javier: pasa solo\n                                # en assemblies con 2+ familias a distinta altura, ej. pedestal +\n                                # zapata; con una sola familia estaba bien). Dos tags chocan solo\n                                # si sus textos (centro +- MARGEN) se solapan verticalmente.\n                                centro_v = centro_multi_corte.DotProduct(up_corte)\n                                margen_v = MARGEN_MULTIREBAR_CORTE_MM / 304.8 * vsec.Scale\n                                v_lo = centro_v - margen_v\n                                v_hi = centro_v + margen_v\n                                banda = 0\n                                while True:\n                                    choca = False\n                                    for (o_lo, o_hi, o_b) in bandas_lado_corte:\n                                        if o_b == banda and not (v_hi \u003c o_lo or v_lo \u003e o_hi):\n                                            choca = True\n                                            break\n                                    if not choca:\n                                        break\n                                    banda += 1\n                                if banda \u003e 0:\n                                    paso_corte = paso_tags_corte_mm / 304.8 * vsec.Scale\n                                    posicion_multi_corte = posicion_multi_corte.Add(perp_multi_corte.Multiply(banda * paso_corte))\n                                bandas_lado_corte.append((v_lo, v_hi, banda))\n                            else:\n                                # EMPUJE HACIA ARRIBA (2026-07-21, mismo pedido: los sets\n                                # horizontales -barras de zapata separadas a lo ancho- se\n                                # amontonaban a la misma altura cuando habia varios en el mismo\n                                # corte, con el texto ilegible, superpuesto). Mismo escalonado\n                                # que la izquierda/derecha pero con los ejes cruzados: la banda\n                                # de choque se mide por posicion HORIZONTAL (RightDirection) en\n                                # vez de vertical, y el paso se aplica hacia ARRIBA\n                                # (perp_multi_corte) en vez de hacia el costado. Mantiene la\n                                # posicion original de posicion_afuera_assembly (offset_mm, no\n                                # clearance_tags_corte_mm que es solo para izquierda/derecha) -\n                                # antes de este fix el empuje hacia arriba no escalonaba nada.\n                                right_corte = vsec.RightDirection\n                                centro_h = centro_multi_corte.DotProduct(right_corte)\n                                margen_h = MARGEN_HORIZONTAL_MULTIREBAR_CORTE_MM / 304.8 * vsec.Scale\n                                h_lo = centro_h - margen_h\n                                h_hi = centro_h + margen_h\n                                banda_arriba = 0\n                                while True:\n                                    choca = False\n                                    for (o_lo, o_hi, o_b) in bandas_arriba_corte:\n                                        if o_b == banda_arriba and not (h_hi \u003c o_lo or h_lo \u003e o_hi):\n                                            choca = True\n                                            break\n                                    if not choca:\n                                        break\n                                    banda_arriba += 1\n                                if banda_arriba \u003e 0:\n                                    paso_corte = paso_tags_corte_mm / 304.8 * vsec.Scale\n                                    posicion_multi_corte = posicion_multi_corte.Add(perp_multi_corte.Multiply(banda_arriba * paso_corte))\n                                bandas_arriba_corte.append((h_lo, h_hi, banda_arriba))\n                            # Tipo de Multi-Rebar Annotation segun RebarShape.RebarStyle\n                            # (2026-07-21, solo en cortes): estribos/amarras (StirrupTie)\n                            # usan NOMBRE_TIPO_MULTIREBAR_ESTRIBO; el resto sigue con el\n                            # tipo general. Si el tipo de estribo no existe en el proyecto,\n                            # cae de vuelta al general (ya avisado en el bootstrap).\n                            tipo_multi_corte = tag_type_multirebar\n                            try:\n                                if tag_type_multirebar_estribo is not None and es_estribo_stirrup_tie(r):\n                                    tipo_multi_corte = tag_type_multirebar_estribo\n                            except Exception as e:\n                                log.append(\u0027AVISO {} {}: no se pudo evaluar RebarStyle (barra {}): {}\u0027.format(tname, nombre_corte, r.Id.Value, e))\n                            opciones_multi_corte = MultiReferenceAnnotationOptions(tipo_multi_corte)\n                            opciones_multi_corte.SetElementsToDimension(List[ElementId]([r.Id]))\n                            opciones_multi_corte.TagHasLeader = True\n                            opciones_multi_corte.DimensionPlaneNormal = vsec.ViewDirection\n                            opciones_multi_corte.DimensionLineDirection = dir_multi_corte\n                            opciones_multi_corte.DimensionLineOrigin = posicion_multi_corte\n                            opciones_multi_corte.TagHeadPosition = posicion_multi_corte\n                            ann_multi_corte = MultiReferenceAnnotation.Create(doc, vsec.Id, opciones_multi_corte)\n                            if not empuje_vertical_multi_corte:\n                                try:\n                                    tag_multi_corte = doc.GetElement(ann_multi_corte.TagId)\n                                    if tag_multi_corte is not None:\n                                        tag_multi_corte.TagOrientation = TagOrientation.Vertical\n                                except Exception as e:\n                                    log.append(\u0027AVISO {} {}: no se pudo rotar el texto del Multi-Rebar Annotation (barra {}): {}\u0027.format(tname, nombre_corte, r.Id.Value, e))\n                            total += 1\n                            multirebar_corte_creadas += 1\n                            log.append(\u0027OK {}: Multi-Rebar Annotation creada en {} (barra {}, direccion via {}).\u0027.format(tname, nombre_corte, r.Id.Value, via_dir_corte))\n                        except Exception as e:\n                            log.append(\u0027ERROR {} {} Multi-Rebar Annotation (barra {}): {}\u0027.format(tname, nombre_corte, r.Id.Value, e))\n                    if multirebar_corte_creadas:\n                        log.append(\u0027{}: {} Multi-Rebar Annotations creadas en {} (barras Number with Spacing en modo primera-y-ultima).\u0027.format(tname, multirebar_corte_creadas, nombre_corte))\n\n                # --- CADENA VERTICAL DE COBERTURA en el corte (re-implementada 2026-07-25,\n                #     pedido de Javier). Va DESPUES de las anotaciones: reusa que quedan en\n                #     modo primera-y-ultima y su idempotencia excluye las Dimensions de las\n                #     anotaciones (por eso el doc.Regenerate antes, para poblar DimensionId).\n                if barras_ai:\n                    try:\n                        doc.Regenerate()\n                        total += crear_cadena_vertical_corte(vsec, faces, barras_ai, tname, offset_mm)\n                    except Exception as e:\n                        log.append(\u0027ERROR {} {} cadena vertical de cobertura: {}\u0027.format(tname, nombre_corte, e))\n        except Exception as e:\n            log.append(\u0027ERROR {}: {}\u0027.format(tname, e))\nfinally:\n    TransactionManager.Instance.TransactionTaskDone()\n\nlog.insert(0, \u0027Anotaciones creadas: {} | assemblies procesados: {}\u0027.format(total, len(targets)))\nOUT = log",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
