    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# 01_Calcular y crear laminas - calcula cuantas laminas hacen falta para las\n# vistas de assembly pendientes y crea esa cantidad, con la numeracion de siempre.\n#\n# EMPAQUETADO (reescrito 2026-07-23): se empaqueta por el tamano del CROP de cada\n# vista (View.CropBox / escala, que el 00 deja ajustado justo al borde de la\n# fundacion) MAS el titulo - NO por el contorno completo con lineas de seccion\n# (esas cruces que salen del crop se extienden muchisimo mas que la fundacion y,\n# como son finas, cruzarse con las vistas vecinas es normal en estos planos; medir\n# por ellas daba un bloque por pagina). El reparto usa un algoritmo SKYLINE\n# (bottom-left): cada bloque cae en el hueco mas alto y a la izquierda que le\n# quepa, asi un bloque alto y angosto ocupa solo su columna y el resto del ancho\n# de la lamina se rellena con los bloques siguientes. 02_Colocar usa la MISMA\n# medida y el MISMO empaquetado.\n# Revit 2027 / Dynamo 4 / CPython3\n# IN[0] = tipo de vineta (dropdown Family Types)\n# IN[1] = numero del primer sheet\n# IN[2] = nombre del primer sheet\n# IN[3] = procesar todos los assemblies (bool)\n# IN[4] = filtro de assemblies si IN[3] es False (parcial, comas)\n# IN[5] = margen y separacion entre vistas (mm) - debe coincidir con 02\n# IN[6] = reserva en el lado derecho (mm) - idem, debe coincidir con 02\n# IN[7] = separacion de vistas (%) - regula cuantas vistas por lamina. 100 = ajustado\n#         (denso); \u003c 100 = mas montadas y menos laminas; \u003e 100 = mas separadas y mas\n#         laminas. DEBE coincidir con 02 para que el calculo y la colocacion cuadren.\n\nimport clr\nimport re\nclr.AddReference(\u0027RevitAPI\u0027)\nclr.AddReference(\u0027RevitServices\u0027)\nfrom Autodesk.Revit.DB import (FilteredElementCollector, AssemblyInstance, ViewSheet,\n                               Viewport, View, BuiltInCategory, Element, ElementId, XYZ)\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\ntb_type = UnwrapElement(IN[0])\nfirst_number = (IN[1] or \u0027\u0027).strip()\nfirst_name = (IN[2] or \u0027\u0027).strip()\nprocess_all = bool(IN[3])\nfilter_text = (IN[4] or \u0027\u0027).strip()\nmargin = float(IN[5]) / 304.8\nright_reserve = float(IN[6]) / 304.8\n# separacion de vistas (%) - escala el hueco que reserva cada bloque al empaquetar\n# (no el tamano real de las vistas): \u003c 100 monta las vistas y usa menos laminas,\n# \u003e 100 las separa y usa mas laminas. Si el input aun no existe (grafo sin re-abrir\n# en Dynamo), cae a 100.\ntry:\n    esc = float(IN[7]) / 100.0\nexcept Exception:\n    esc = 1.0\nif esc \u003c 0.2:\n    esc = 0.2\n# separacion REAL dentro de cada bloque (planta -\u003e corte A -\u003e corte B -\u003e callouts):\n# margen general + 10 mm fijos, igual que 02.\ngap_bloque = margin + 10.0 / 304.8\n\nlog = []\nSUFIJO_ARMADURAS = \u0027 - ARMADURA\u0027\nSUFIJO_CORTE = SUFIJO_ARMADURAS + \u0027 - CORTE A\u0027\nSUFIJO_CORTE_B = SUFIJO_ARMADURAS + \u0027 - CORTE B\u0027\nSUFIJOS_CORTE = (SUFIJO_CORTE, SUFIJO_CORTE_B)\nPREFIJO_PEDESTAL = SUFIJO_ARMADURAS + \u0027 - PEDESTAL \u0027\n\n# reserva bajo cada vista para su titulo (planta y cortes/callouts)\nlabel_h_planta = 12.0 / 304.8\nlabel_h_corte = (12.0 + 14.0) / 304.8\n\ndef sufijo_corte(nombre):\n    for a in SUFIJOS_CORTE:\n        if nombre.endswith(a):\n            return a\n    return None\n\ndef es_callout_pedestal(nombre):\n    return PREFIJO_PEDESTAL in nombre\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\ndef label_h_de(v):\n    nombre = elem_name(v)\n    return label_h_corte if (sufijo_corte(nombre) or es_callout_pedestal(nombre)) else label_h_planta\n\ndef tb_label(t):\n    try:\n        return \u0027{} : {}\u0027.format(t.FamilyName, elem_name(t))\n    except Exception:\n        return \u0027Id \u0027 + str(t.Id)\n\ndef list_titleblocks():\n    col = (FilteredElementCollector(doc)\n           .OfCategory(BuiltInCategory.OST_TitleBlocks)\n           .WhereElementIsElementType())\n    return list(col)\n\ndef paper_size(v):\n    # tamano en papel (pies) = crop del modelo / escala (crop ya ajustado por 00)\n    cb = v.CropBox\n    s = v.Scale if v.Scale \u003e 0 else 1\n    return ((cb.Max.X - cb.Min.X) / s, (cb.Max.Y - cb.Min.Y) / s)\n\ndef dims_bloque(grupo):\n    # bloque vertical: planta arriba, cortes/callouts abajo. Ancho = crop mas ancho;\n    # alto = suma de (crop + titulo) + gap_bloque entre vistas.\n    ws = []\n    hs = []\n    for v in grupo:\n        w, h = paper_size(v)\n        ws.append(w)\n        hs.append(h + label_h_de(v))\n    bw = max(ws)\n    bh = sum(hs) + gap_bloque * (len(grupo) - 1)\n    return bw, bh\n\ndef usable_rect(sheet):\n    # area util = bbox de la vineta menos margenes (y reserva derecha)\n    col = FilteredElementCollector(doc, sheet.Id).OfCategory(BuiltInCategory.OST_TitleBlocks)\n    tb = col.FirstElement()\n    if tb is not None:\n        bb = tb.get_BoundingBox(sheet)\n        if bb is not None:\n            return (bb.Min.X + margin, bb.Min.Y + margin,\n                    bb.Max.X - margin - right_reserve, bb.Max.Y - margin)\n    o = sheet.Outline\n    return (o.Min.U + margin, o.Min.V + margin,\n            o.Max.U - margin - right_reserve, o.Max.V - margin)\n\n# ---------------- empaquetado SKYLINE (bottom-left, first-fit) ----------------\n# Mantiene el orden por nombre ENTRE laminas y rellena huecos DENTRO de cada una.\n# Solo abre lamina nueva cuando el bloque no entra en la actual; nunca vuelve a\n# laminas anteriores. Un bloque mas grande que la lamina entera ocupa su columna\n# desde el tope, dejando el resto del ancho libre para rellenar.\nEPS = 1e-9\n\ndef depth_max(sky, a, b):\n    d = 0.0\n    for xi, xf, dep in sky:\n        if xf \u003c= a + EPS or xi \u003e= b - EPS:\n            continue\n        if dep \u003e d:\n            d = dep\n    return d\n\ndef ocupa(sky, a, b, nd):\n    nuevos = []\n    for xi, xf, dep in sky:\n        if xi \u003c a - EPS:\n            nuevos.append([xi, min(xf, a), dep])\n        if xf \u003e b + EPS:\n            nuevos.append([max(xi, b), xf, dep])\n    nuevos.append([a, b, nd])\n    nuevos = [s for s in nuevos if s[1] - s[0] \u003e EPS]\n    nuevos.sort(key=lambda s: s[0])\n    sky[:] = nuevos\n\ndef mejor_pos(sky, x0, x1, H, ew, eh):\n    best = None\n    for seg in sky:\n        x = seg[0]\n        if x + ew \u003e x1 + EPS:\n            continue\n        depth = depth_max(sky, x, x + ew)\n        if depth + eh \u003e H + EPS:\n            continue\n        if best is None or depth \u003c best[1] - EPS or (abs(depth - best[1]) \u003c EPS and x \u003c best[0] - EPS):\n            best = (x, depth)\n    return best\n\ndef bin_usado(sky):\n    for xi, xf, dep in sky:\n        if dep \u003e EPS:\n            return True\n    return False\n\ndef empaquetar(dims_bloques, x0, y0, x1, y1):\n    H = y1 - y0\n    bins = []\n    asign = []\n    avisos = []\n    def nuevo():\n        bins.append([[x0, x1, 0.0]])\n        return len(bins) - 1\n    cur = nuevo()\n    for idx, (bw, bh) in enumerate(dims_bloques):\n        # el hueco reservado por bloque se escala con la densidad (esc); el tamano\n        # real de las vistas no cambia, asi que con esc \u003c 1 los bloques se montan.\n        ew = bw * esc\n        eh = bh * esc\n        pos = mejor_pos(bins[cur], x0, x1, H, ew, eh)\n        # solo abrir lamina nueva si la actual YA tiene algo; si esta fresca y aun\n        # asi no cabe (bloque mas grande que la lamina), se coloca igual aca - de lo\n        # contrario quedaba una primera lamina vacia (bug 2026-07-23).\n        if pos is None and bin_usado(bins[cur]):\n            cur = nuevo()\n            pos = mejor_pos(bins[cur], x0, x1, H, ew, eh)\n        if pos is None:\n            pos = (x0, 0.0)\n            if bh \u003e H:  # genuinamente mas alto que el area util de una lamina\n                avisos.append(idx)\n        bx, depth = pos\n        asign.append((cur, bx, y1 - depth))\n        ocupa(bins[cur], bx, min(bx + ew, x1), depth + eh)\n    return asign, len(bins), avisos\n\ndef bump(text, steps):\n    last = None\n    for m in re.finditer(\u0027\\\\d+\u0027, text):\n        last = m\n    if last is None:\n        return \u0027{} {:02d}\u0027.format(text, steps + 1)\n    width = len(last.group(0))\n    val = int(last.group(0)) + steps\n    return text[:last.start()] + str(val).zfill(width) + text[last.end():]\n\n# --- validar la vineta seleccionada ---\ntb_cat_id = ElementId(BuiltInCategory.OST_TitleBlocks)\nis_tb = (tb_type is not None\n         and tb_type.Category is not None\n         and tb_type.Category.Id == tb_cat_id)\n\nif not is_tb:\n    log.append(\u0027ERROR: el tipo seleccionado en el dropdown NO es una vineta (Title Block).\u0027)\n    log.append(\u0027Selecciona una de estas vinetas cargadas en el proyecto:\u0027)\n    tbs = list_titleblocks()\n    if not tbs:\n        log.append(\u0027  (no hay vinetas cargadas en el proyecto)\u0027)\n    for t in tbs:\n        log.append(\u0027  - \u0027 + tb_label(t))\n    OUT = log\nelse:\n    by_type = {}\n    for ai in FilteredElementCollector(doc).OfClass(AssemblyInstance):\n        by_type.setdefault(ai.AssemblyTypeName, []).append(ai)\n\n    names = sorted(by_type.keys())\n    if not process_all:\n        tokens = [t.strip().lower() for t in filter_text.split(\u0027,\u0027) if t.strip()]\n        if tokens:\n            names = [n for n in names if any(tok in n.lower() for tok in tokens)]\n        else:\n            names = []\n            log.append(\u0027ERROR: \\\"Todos\\\" esta en False y el filtro esta vacio.\u0027)\n\n    view_by_name = {}\n    for v in FilteredElementCollector(doc).OfClass(View):\n        if not v.IsTemplate:\n            view_by_name[elem_name(v)] = v\n\n    placed_ids = set()\n    for vp in FilteredElementCollector(doc).OfClass(Viewport):\n        placed_ids.add(vp.ViewId.Value)\n\n    bloques = []\n    for n in names:\n        grupo = []\n        for vname in (n + SUFIJO_ARMADURAS, n + SUFIJO_CORTE, n + SUFIJO_CORTE_B):\n            v = view_by_name.get(vname)\n            if v is None:\n                log.append(\u0027AVISO: no existe la vista \\\"{}\\\" (corre 00_Vistas de assembly).\u0027.format(vname))\n            elif v.Id.Value in placed_ids:\n                pass  # ya colocada en una lamina, no cuenta como pendiente\n            else:\n                grupo.append(v)\n        prefijo_ped = n + PREFIJO_PEDESTAL\n        for vname_ped in sorted(nm for nm in view_by_name if nm.startswith(prefijo_ped)):\n            v_ped = view_by_name[vname_ped]\n            if v_ped.Id.Value not in placed_ids:\n                grupo.append(v_ped)\n        if grupo:\n            bloques.append(grupo)\n\n    if not bloques:\n        log.append(\u0027No hay vistas pendientes de colocar; no se creo ninguna lamina.\u0027)\n        OUT = log\n    else:\n        created = 0\n        sheets_needed = 0\n        TransactionManager.Instance.EnsureInTransaction(doc)\n        try:\n            if hasattr(tb_type, \u0027IsActive\u0027) and not tb_type.IsActive:\n                tb_type.Activate()\n\n            # --- lamina de prueba solo para medir el area util de la vineta ---\n            probe = ViewSheet.Create(doc, tb_type.Id)\n            doc.Regenerate()\n            x0, y0, x1, y1 = usable_rect(probe)\n            doc.Delete(probe.Id)\n\n            dims_bloques = [dims_bloque(g) for g in bloques]\n            asign, sheets_needed, avisos = empaquetar(dims_bloques, x0, y0, x1, y1)\n            for idx in avisos:\n                bw, bh = dims_bloques[idx]\n                log.append(\u0027AVISO: \\\"{}\\\" ({:.0f} x {:.0f} mm en papel) es mas grande que el area util de una lamina; ocupara su columna y puede sobrepasar el borde.\u0027.format(\n                    elem_name(bloques[idx][0]), bw * 304.8, bh * 304.8))\n\n            # --- crear esa cantidad de laminas, con la numeracion de siempre ---\n            if not first_number:\n                first_number = \u0027A-001\u0027\n                log.append(\u0027AVISO: numero inicial vacio, se usa A-001.\u0027)\n            if not first_name:\n                first_name = \u0027SIN NOMBRE 01\u0027\n                log.append(\u0027AVISO: nombre inicial vacio, se usa SIN NOMBRE 01.\u0027)\n\n            existing = set()\n            for vs in FilteredElementCollector(doc).OfClass(ViewSheet):\n                existing.add(vs.SheetNumber)\n\n            plan = []\n            produced = 0\n            offset = 0\n            while produced \u003c sheets_needed and offset \u003c sheets_needed + 1000:\n                num = first_number if offset == 0 else bump(first_number, offset)\n                offset += 1\n                if num in existing:\n                    log.append(\u0027AVISO: el numero {} ya existe en el proyecto, se salta.\u0027.format(num))\n                    continue\n                name = first_name if produced == 0 else bump(first_name, produced)\n                plan.append((num, name))\n                existing.add(num)\n                produced += 1\n\n            for num, name in plan:\n                try:\n                    sheet = ViewSheet.Create(doc, tb_type.Id)\n                    sheet.SheetNumber = num\n                    try:\n                        sheet.Name = name\n                    except Exception:\n                        Element.Name.__set__(sheet, name)\n                    created += 1\n                    log.append(\u0027OK: {}  |  {}\u0027.format(num, name))\n                except Exception as e:\n                    log.append(\u0027ERROR creando {}: {}\u0027.format(num, e))\n        finally:\n            TransactionManager.Instance.TransactionTaskDone()\n\n        log.insert(0, \u0027Vineta usada: \u0027 + tb_label(tb_type))\n        log.insert(1, \u0027Laminas necesarias calculadas: {} | creadas: {} (empaquetado skyline por crop)\u0027.format(sheets_needed, created))\n        log.append(\u0027Listo. Ahora corre 02_Colocar vistas en laminas para distribuir las vistas en estas laminas.\u0027)\n        OUT = log",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "a9010000000000000000000000000001",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "a9010000000000000000000000000002",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "a9010000000000000000000000000003",
          "Name": "IN[1]",
          "Description": "Input #1",
