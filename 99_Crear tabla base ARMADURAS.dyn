    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# 99_Crear tabla base ARMADURAS (TEMPORAL) - arma la tabla de despiece que despues se\n# guarda como VIEW TEMPLATE de schedule, para que las formulas viajen con el template y\n# las columnas dejen de ser una foto.\n#\n# POR QUE ESTE GRAPH ES A MEDIAS: la API de Revit NO permite crear valores calculados\n# (formulas) en un schedule. Es una limitacion vieja y sin fecha de arreglo. Entonces\n# este graph pone TODO lo que la API si puede (campos nativos, compartidos, orden,\n# anchos, unidades, totales, agrupacion, grafismo) y deja 4 huecos que se llenan A MANO\n# una sola vez.\n#\n# COMO SE USA (2 corridas):\n#   1) Correr -> crea la tabla base con todos los campos posibles. El log dice que falta.\n#   2) A mano en Revit: abrir la tabla, Fields > Calculated Value, y crear las 4 formulas\n#      con los NOMBRES EXACTOS y los TIPOS que indica el log.\n#   3) Volver a correr -> ordena las columnas, aplica unidades, anchos y totales.\n#   4) Guardar como view template y BORRAR esta tabla (el template se queda con todo).\n#\n# NO borra ni rehace campos: se puede re-correr sin perder las formulas cargadas a mano.\n#\n# Revit 2027 / Dynamo 4 / CPython3\n# IN[0] = nombre de la tabla base\n# IN[1] = (sin uso en este graph)\n# IN[2] = ancho total disponible para la tabla (mm) - debe coincidir con la reserva del 05\n# IN[3] = nombre del estilo de linea para grid/outline (vacio = no tocar)\n# IN[4] = nombre del tipo de texto para encabezados (vacio = no tocar)\n# IN[5] = nombre del tipo de texto para el cuerpo (vacio = no tocar)\n# IN[6] = titulo de la tabla\n# IN[7] = (sin uso en este graph)\n\nimport clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (FilteredElementCollector, ViewSchedule, ScheduleSortGroupField,\n                               BuiltInCategory, BuiltInParameter, ElementId, Element,\n                               TextNoteType, GraphicsStyle, StorageType, SharedParameterElement,\n                               ExternalDefinitionCreationOptions, SpecTypeId, GroupTypeId,\n                               FormatOptions, UnitTypeId, ForgeTypeId, ScheduleFieldDisplayType,\n                               ScheduleFieldId)\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\nfrom System import Guid\nfrom System.Collections.Generic import List\nimport os\nimport tempfile\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nnombre_base = (IN[0] or '').strip() or 'TBL_ARMADURAS_BASE'\nancho_total = float(IN[2]) / 304.8\ngrid_style_name = (IN[3] or '').strip()\nheader_text_name = (IN[4] or '').strip()\nbody_text_name = (IN[5] or '').strip()\ntitulo_tabla = (IN[6] or '').strip()\n\n# --- GUIDs de compartidos ya existentes en el proyecto (los mismos que usa el 05) ---\nGUID_ITEM = Guid('48cfe67b-4544-4f71-bd75-e46767622ddd')      # ITEM_TBL -> MARCA\nGUID_A = Guid('834200b7-07e9-4677-a81a-44dc862ff50b')\nGUID_B = Guid('e0d9703a-2ca6-44f8-8ca6-ce70571458d7')\nGUID_C = Guid('4aad6aab-b0e9-4528-bfa3-eeb96adaead0')\nGUID_D = Guid('e70a9408-6d69-44f5-848d-f5ba4cb037e5')\nGUID_E = Guid('74e389d7-fb43-471a-8f8d-830bf717db8e')\nGUID_F = Guid('60bd0376-836e-484f-89d4-d8fb8d985f34')\n\nNOMBRE_PARAM_SHEET_ARM = 'SHEET_ARMADURAS'\nNOMBRE_CANT_ASSY = 'ARM_CANT_ASSY'\nNOMBRES_ARM = ['ARM_L1', 'ARM_L2', NOMBRE_CANT_ASSY]\n# ARM_CANT_ASSY es ENTERO, no texto: es el multiplicador de las formulas de TOTAL y PESO\n# TOTAL (la cantidad de assemblies del tipo, el mismo numero que el \"CANT=X\" del\n# encabezado ARM_L2, que es texto y por eso no sirve dentro de una formula).\nSPECS_ARM = {NOMBRE_CANT_ASSY: SpecTypeId.Int.Integer}\n\n# GUIDs CANONICOS: fijos a proposito. La identidad de un compartido es el GUID, no el\n# nombre; con GUIDs al azar el view template no seria transferible a otro proyecto (el\n# template apuntaria a parametros que alla no existen). Tienen que ser IDENTICOS a los\n# del 05.\nGUIDS_CANONICOS = {\n    'SHEET_ARMADURAS': Guid('f13e5924-2e85-4b1d-a5ec-ed90ba914a21'),\n    'ARM_L1': Guid('c1ac69e4-5005-4849-8952-f14e2101cf20'),\n    'ARM_L2': Guid('59d4055b-b7b5-4125-bdf7-52ffd41649c5'),\n    'ARM_CANT_ASSY': Guid('8f890889-5f44-43a0-8cbf-83f5d06f2474'),\n}\nARCHIVO_COMPARTIDOS = 'bios_params_armaduras_v2.txt'\nREBAR_CAT_ID = ElementId(BuiltInCategory.OST_Rebar)\n\n# Las 4 formulas que hay que cargar a mano. (nombre exacto, tipo, formula)\n# TOTAL y PESO TOTAL multiplican por los TRES factores: largo unitario x barras del set x\n# assemblies del tipo. Las barras del set las suma Revit al colapsar la fila (por eso esos\n# dos campos llevan Calculate totals, que aplica este graph en la segunda corrida).\nFORMULAS = [\n    ('UNIT. (m)', 'Length (Longitud)',\n     'A + B + C + D + E + F'),\n    ('TOTAL (m)', 'Length (Longitud)',\n     '(A + B + C + D + E + F) * Quantity * ARM_CANT_ASSY'),\n    ('PESO UNIT. (Kg)', 'Mass (Masa)',\n     '(A + B + C + D + E + F) * Bar Mass per Unit Length'),\n    ('PESO TOTAL (Kg)', 'Mass (Masa)',\n     '(A + B + C + D + E + F) * Bar Mass per Unit Length * Quantity * ARM_CANT_ASSY'),\n]\n\n# --- definicion de columnas, en el orden final que tiene que quedar ---\n# (clave, referencia, encabezado, ancho_mm, unidad, totalizar, oculto)\n#   referencia: Guid                  -> compartido de la barra, por GUID\n#               'NOMBRE'              -> compartido que crea este graph, por nombre\n#               ('nat', [nombres])    -> campo nativo, primero de la lista que exista\n#               ('calc', nombre)      -> valor calculado, cargado A MANO\n#   unidad:     None | 'mm' | 'm' | 'kg'\n#   totalizar:  True -> DisplayType.Totals (suma al colapsar la fila en vez de partirla)\nCOLS = [\n    ('l1',      'ARM_L1',                          '',                      10.0, None, False, True),\n    ('l2',      'ARM_L2',                          '',                      10.0, None, False, True),\n    ('marca',   GUID_ITEM,                         'MARCA',                 12.0, None, False, False),\n    ('tipo',    ('nat', ['Shape', 'Shape Name']),  'TIPO',                  13.0, None, False, False),\n    ('diam',    ('nat', ['Bar Diameter']),         'Diam (mm)',              9.0, 'mm', False, False),\n    ('cant',    ('nat', ['Quantity']),             'CANTIDAD TOTAL BARRAS', 14.0, None, True,  False),\n    ('a',       GUID_A,                            'A (mm)',                 8.0, 'mm', False, False),\n    ('b',       GUID_B,                            'B (mm)',                 8.0, 'mm', False, False),\n    ('c',       GUID_C,                            'C (mm)',                 8.0, 'mm', False, False),\n    ('d',       GUID_D,                            'D (mm)',                 8.0, 'mm', False, False),\n    ('e',       GUID_E,                            'E (mm)',                 8.0, 'mm', False, False),\n    ('f',       GUID_F,                            'F (mm)',                 8.0, 'mm', False, False),\n    ('unit',    ('calc', 'UNIT. (m)'),             'UNIT. (m)',             10.0, 'm',  False, False),\n    ('total',   ('calc', 'TOTAL (m)'),             'TOTAL (m)',             10.0, 'm',  True,  False),\n    ('peso_u',  ('calc', 'PESO UNIT. (Kg)'),       'PESO UNIT. (Kg)',       11.0, 'kg', False, False),\n    ('peso_t',  ('calc', 'PESO TOTAL (Kg)'),       'PESO TOTAL (Kg)',       11.0, 'kg', True,  False),\n    ('obs',     ('nat', ['Comments']),             'OBSERVACION',           12.0, None, False, False),\n    # ocultos de apoyo: para que una formula pueda referenciar un parametro, ese parametro\n    # tiene que estar como CAMPO del schedule (aunque sea oculto).\n    #   'Bar Mass per Unit Length' -> lo usan las dos formulas de peso\n    #   ARM_CANT_ASSY              -> multiplicador de assemblies en TOTAL y PESO TOTAL\n    #   SHEET_ARMADURAS            -> el filtro por lamina que pone el 05\n    ('masa_ml',   ('nat', ['Bar Mass per Unit Length']), '',                10.0, None, False, True),\n    ('cant_assy', NOMBRE_CANT_ASSY,                '',                      10.0, None, False, True),\n    ('filtro',    NOMBRE_PARAM_SHEET_ARM,          '',                      10.0, None, False, True),\n]\n\nlog = []\n\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\n\ndef fid_key(fid):\n    # ScheduleFieldId.IntegerValue quedo deprecado en las versiones nuevas a favor de Value\n    try:\n        return fid.IntegerValue\n    except Exception:\n        return fid.Value\n\n\ndef nombre_de_campo(f):\n    try:\n        return f.GetName()\n    except Exception:\n        try:\n            return f.ColumnHeading\n        except Exception:\n            return ''\n\n\ndef set_param_by_name(el, nombre, valor):\n    try:\n        p = None\n        for q in el.Parameters:\n            try:\n                if q.Definition.Name.lower().strip() == nombre.lower().strip():\n                    p = q\n                    break\n            except Exception:\n                continue\n        if p is None or p.IsReadOnly:\n            return False\n        if p.StorageType == StorageType.ElementId:\n            p.Set(valor.Id if hasattr(valor, 'Id') else valor)\n        elif p.StorageType == StorageType.Integer:\n            p.Set(int(valor))\n        elif p.StorageType == StorageType.String:\n            p.Set(str(valor))\n        else:\n            return False\n        return True\n    except Exception:\n        return False\n\n\n# --- bootstrap de compartidos (mismo patron que el 05) ---\nguids_arm = {}\nguid_sheet_arm = [None]\n\n\ndef cat_rebar():\n    try:\n        return doc.Settings.Categories.get_Item(BuiltInCategory.OST_Rebar)\n    except Exception:\n        return None\n\n\ndef asegurar_binding_rebar(definition):\n    app = doc.Application\n    rebar_c = cat_rebar()\n    if rebar_c is None:\n        return\n    bmap = doc.ParameterBindings\n    it = bmap.ForwardIterator()\n    it.Reset()\n    binding_existente = None\n    while it.MoveNext():\n        d = it.Key\n        if d is not None and d.Name == definition.Name:\n            binding_existente = it.Current\n            break\n    cats = app.Create.NewCategorySet()\n    ya = False\n    if binding_existente is not None:\n        for c in binding_existente.Categories:\n            cats.Insert(c)\n            if c.Id.Value == rebar_c.Id.Value:\n                ya = True\n    if ya:\n        return\n    cats.Insert(rebar_c)\n    binding = app.Create.NewInstanceBinding(cats)\n    if binding_existente is not None:\n        bmap.ReInsert(definition, binding, GroupTypeId.Data)\n    else:\n        bmap.Insert(definition, binding, GroupTypeId.Data)\n\n\ndef asegurar_params():\n    app = doc.Application\n    old_file = app.SharedParametersFilename\n    tmp = os.path.join(tempfile.gettempdir(), ARCHIVO_COMPARTIDOS)\n    if not os.path.exists(tmp):\n        f = open(tmp, 'w')\n        f.close()\n    app.SharedParametersFilename = tmp\n    try:\n        deffile = app.OpenSharedParameterFile()\n        grupo = None\n        for g in deffile.Groups:\n            if g.Name == 'ARMADURAS':\n                grupo = g\n                break\n        if grupo is None:\n            grupo = deffile.Groups.Create('ARMADURAS')\n\n        spe_por_nombre = {}\n        for spe in FilteredElementCollector(doc).OfClass(SharedParameterElement):\n            spe_por_nombre[elem_name(spe)] = spe\n\n        for nombre in [NOMBRE_PARAM_SHEET_ARM] + NOMBRES_ARM:\n            spe = spe_por_nombre.get(nombre)\n            if spe is None:\n                definicion = grupo.Definitions.get_Item(nombre)\n                if definicion is None:\n                    spec = SPECS_ARM.get(nombre, SpecTypeId.String.Text)\n                    opts = ExternalDefinitionCreationOptions(nombre, spec)\n                    g = GUIDS_CANONICOS.get(nombre)\n                    if g is not None:\n                        opts.GUID = g\n                    definicion = grupo.Definitions.Create(opts)\n                rebar_c = cat_rebar()\n                cats = app.Create.NewCategorySet()\n                if rebar_c is not None:\n                    cats.Insert(rebar_c)\n                binding = app.Create.NewInstanceBinding(cats)\n                doc.ParameterBindings.Insert(definicion, binding, GroupTypeId.Data)\n            else:\n                idef = None\n                try:\n                    idef = spe.GetDefinition()\n                except Exception:\n                    idef = None\n                if idef is not None:\n                    asegurar_binding_rebar(idef)\n    finally:\n        app.SharedParametersFilename = old_file\n    doc.Regenerate()\n\n    for spe in FilteredElementCollector(doc).OfClass(SharedParameterElement):\n        nombre = elem_name(spe)\n        if nombre == NOMBRE_PARAM_SHEET_ARM:\n            guid_sheet_arm[0] = spe.GuidValue\n        elif nombre in NOMBRES_ARM:\n            guids_arm[nombre] = spe.GuidValue\n\n    for nombre, g in GUIDS_CANONICOS.items():\n        actual = guid_sheet_arm[0] if nombre == NOMBRE_PARAM_SHEET_ARM else guids_arm.get(nombre)\n        if actual is not None and str(actual).lower() != str(g).lower():\n            log.append('AVISO: {} existe con GUID {} en vez del canonico {}.'.format(nombre, actual, g))\n            log.append('El template que salga de aca NO sera transferible a otro proyecto. Para')\n            log.append('normalizarlo: borrar ese parametro del proyecto y volver a correr este graph.')\n\n\ndef guid_de_ref(ref):\n    if isinstance(ref, Guid):\n        return ref\n    if ref == NOMBRE_PARAM_SHEET_ARM:\n        return guid_sheet_arm[0]\n    return guids_arm.get(ref)\n\n\ndef id_param_de_ref(ref):\n    g = guid_de_ref(ref)\n    if g is None:\n        return None\n    spe = SharedParameterElement.Lookup(doc, g)\n    return spe.Id if spe is not None else None\n\n\ndef aplicar_unidad(field, unidad, etiqueta):\n    if not unidad:\n        return\n    try:\n        if unidad == 'mm':\n            fo = FormatOptions(UnitTypeId.Millimeters)\n            fo.Accuracy = 1.0\n        elif unidad == 'm':\n            fo = FormatOptions(UnitTypeId.Meters)\n            fo.Accuracy = 0.01\n        else:\n            fo = FormatOptions(UnitTypeId.Kilograms)\n            fo.Accuracy = 0.01\n        try:\n            fo.SetSymbolTypeId(ForgeTypeId())\n        except Exception:\n            pass\n        field.SetFormatOptions(fo)\n    except Exception as e:\n        log.append('AVISO: no se pudo poner la unidad {} en la columna {}: {}'.format(\n            unidad, etiqueta, e))\n\n\nestilos_linea = list(FilteredElementCollector(doc).OfClass(GraphicsStyle))\ntipos_texto = list(FilteredElementCollector(doc).OfClass(TextNoteType))\n\n\ndef buscar_por_nombre(coleccion, nombre, etiqueta):\n    if not nombre:\n        return None\n    low = nombre.lower()\n    for e in coleccion:\n        if elem_name(e).lower() == low:\n            return e\n    log.append('AVISO: no se encontro {} \"{}\"; se deja el default.'.format(etiqueta, nombre))\n    return None\n\n\nTransactionManager.Instance.EnsureInTransaction(doc)\ntry:\n    asegurar_params()\n    if guid_sheet_arm[0] is None or any(n not in guids_arm for n in NOMBRES_ARM):\n        log.append('ERROR: no se pudieron crear/enlazar los compartidos de apoyo. No se creo nada.')\n    else:\n        estilo_grid = buscar_por_nombre(estilos_linea, grid_style_name, 'el estilo de linea')\n        tipo_header = buscar_por_nombre(tipos_texto, header_text_name, 'el tipo de texto de encabezados')\n        tipo_body = buscar_por_nombre(tipos_texto, body_text_name, 'el tipo de texto de cuerpo')\n\n        # El objetivo puede ser una TABLA normal (la base, antes de guardar el template) o\n        # directamente el VIEW TEMPLATE ya guardado. Se prioriza la tabla; si no existe, se\n        # busca entre los templates. Asi este graph sigue sirviendo despues de haber\n        # borrado la tabla base, que es el caso normal una vez montado el pipeline.\n        todos = list(FilteredElementCollector(doc).OfClass(ViewSchedule))\n        sched = next((v for v in todos if not v.IsTemplate and elem_name(v) == nombre_base), None)\n        es_template = False\n        if sched is None:\n            sched = next((v for v in todos if v.IsTemplate and elem_name(v) == nombre_base), None)\n            es_template = sched is not None\n        if sched is None:\n            sched = ViewSchedule.CreateSchedule(doc, REBAR_CAT_ID)\n            sched.Name = nombre_base\n            log.append('Tabla base \"{}\" CREADA.'.format(nombre_base))\n        elif es_template:\n            log.append('Trabajando sobre el VIEW TEMPLATE \"{}\" (la tabla base ya no existe).'.format(nombre_base))\n            log.append('Los cambios se propagan solos a todas las tablas que usan el template.')\n        else:\n            log.append('Tabla base \"{}\" ya existia; no se toca ningun campo, solo se ordena.'.format(nombre_base))\n\n        definition = sched.Definition\n        definition.IsItemized = False\n        doc.Regenerate()\n\n        # --- inventario de lo que ya tiene la tabla ---\n        def campos_actuales():\n            res = []\n            for fid in definition.GetFieldOrder():\n                res.append((fid, definition.GetField(fid)))\n            return res\n\n        def buscar_campo(ref):\n            actuales = campos_actuales()\n            if isinstance(ref, tuple) and ref[0] == 'calc':\n                for fid, f in actuales:\n                    if nombre_de_campo(f).strip() == ref[1]:\n                        return fid, f\n                return None, None\n            if isinstance(ref, tuple) and ref[0] == 'nat':\n                for n in ref[1]:\n                    for fid, f in actuales:\n                        if nombre_de_campo(f).strip() == n:\n                            return fid, f\n                return None, None\n            pid = id_param_de_ref(ref)\n            if pid is None:\n                return None, None\n            for fid, f in actuales:\n                if f.ParameterId == pid:\n                    return fid, f\n            return None, None\n\n        def agregar_campo(ref):\n            # solo para lo que la API si puede agregar (nativos y compartidos)\n            schedulable = list(definition.GetSchedulableFields())\n            if isinstance(ref, tuple) and ref[0] == 'nat':\n                for n in ref[1]:\n                    for sf in schedulable:\n                        try:\n                            if sf.GetName(doc) == n:\n                                return definition.AddField(sf)\n                        except Exception:\n                            continue\n                return None\n            pid = id_param_de_ref(ref)\n            if pid is None:\n                return None\n            for sf in schedulable:\n                if sf.ParameterId == pid:\n                    return definition.AddField(sf)\n            return None\n\n        # --- agregar lo que falte (menos los valores calculados) ---\n        faltan_formulas = []\n        no_disponibles = []\n        for clave, ref, hdr, ancho, unidad, totalizar, oculto in COLS:\n            fid, f = buscar_campo(ref)\n            if f is not None:\n                continue\n            if isinstance(ref, tuple) and ref[0] == 'calc':\n                faltan_formulas.append(ref[1])\n                continue\n            nuevo = agregar_campo(ref)\n            if nuevo is None:\n                etiqueta = ref[1][0] if isinstance(ref, tuple) else str(ref)\n                no_disponibles.append('{} ({})'.format(clave, etiqueta))\n        doc.Regenerate()\n\n        # --- orden final, encabezados, anchos, unidades, totales ---\n        visibles = [c for c in COLS if not c[6]]\n        suma = sum(c[3] for c in visibles)\n        escala = (ancho_total / (suma / 304.8)) if suma > 0 else 1.0\n\n        orden = []\n        vistos = set()\n        for clave, ref, hdr, ancho, unidad, totalizar, oculto in COLS:\n            fid, f = buscar_campo(ref)\n            if f is None:\n                continue\n            f.IsHidden = oculto\n            if hdr:\n                f.ColumnHeading = hdr\n            aplicar_unidad(f, unidad, hdr or clave)\n            try:\n                f.DisplayType = ScheduleFieldDisplayType.Totals if totalizar else ScheduleFieldDisplayType.Standard\n            except Exception as e:\n                log.append('AVISO: no se pudo poner el modo de la columna {}: {}'.format(hdr or clave, e))\n            if not oculto:\n                try:\n                    f.Width = (ancho / 304.8) * escala\n                except Exception as e:\n                    log.append('AVISO: no se pudo poner el ancho de {}: {}'.format(hdr or clave, e))\n            if fid_key(fid) not in vistos:\n                vistos.add(fid_key(fid))\n                orden.append(fid)\n\n        for fid in definition.GetFieldOrder():\n            if fid_key(fid) not in vistos:\n                vistos.add(fid_key(fid))\n                orden.append(fid)\n        try:\n            definition.SetFieldOrder(List[ScheduleFieldId](orden))\n        except Exception as e:\n            log.append('AVISO: no se pudo reordenar las columnas: {}'.format(e))\n        doc.Regenerate()\n\n        # --- agrupacion: ARM_L1 -> ARM_L2 -> MARCA (colapsa una fila por variante) ---\n        while definition.GetSortGroupFieldCount() > 0:\n            definition.RemoveSortGroupField(0)\n        for ref, con_encabezado in [('ARM_L1', True), ('ARM_L2', True), (GUID_ITEM, False)]:\n            fid, f = buscar_campo(ref)\n            if f is None:\n                continue\n            sg = ScheduleSortGroupField(fid)\n            sg.ShowHeader = con_encabezado\n            definition.AddSortGroupField(sg)\n\n        # --- grafismo (lo mismo que aplica el 05 hoy) ---\n        if estilo_grid is not None:\n            set_param_by_name(sched, 'Grid lines', estilo_grid)\n            set_param_by_name(sched, 'Outline', estilo_grid)\n        if tipo_header is not None:\n            set_param_by_name(sched, 'Header text', tipo_header)\n        if tipo_body is not None:\n            set_param_by_name(sched, 'Body text', tipo_body)\n        set_param_by_name(sched, 'Show Title', 1)\n        set_param_by_name(sched, 'Show Headers', 1)\n        p_titulo = sched.get_Parameter(BuiltInParameter.VIEW_DESCRIPTION)\n        if p_titulo is not None and not p_titulo.IsReadOnly and p_titulo.AsString() != titulo_tabla:\n            p_titulo.Set(titulo_tabla)\n\n        # --- informe ---\n        conocidos = set()\n        for clave, ref, hdr, ancho, unidad, totalizar, oculto in COLS:\n            fid, f = buscar_campo(ref)\n            if fid is not None:\n                conocidos.add(fid_key(fid))\n        colados = []\n        for fid in definition.GetFieldOrder():\n            if fid_key(fid) not in conocidos:\n                f = definition.GetField(fid)\n                if not f.IsHidden:\n                    colados.append(nombre_de_campo(f))\n        if colados:\n            log.append('')\n            log.append('AVISO: la tabla trae columnas visibles que no son de este despiece: ' +\n                       ', '.join(colados) + '. Borralas a mano antes de guardar el template.')\n        if no_disponibles:\n            log.append('')\n            log.append('ERROR: este Revit no expone estos campos con ese nombre: ' + ', '.join(no_disponibles))\n            nombres = sorted(set(sf.GetName(doc) for sf in definition.GetSchedulableFields()))\n            log.append('Campos disponibles: ' + ', '.join(nombres))\n        if faltan_formulas:\n            log.append('')\n            log.append('FALTAN LAS 4 FORMULAS (la API de Revit no las puede crear).')\n            log.append('Abre la tabla \"{}\" > Fields > Calculated Value, y crea:'.format(nombre_base))\n            for nombre, tipo, formula in FORMULAS:\n                if nombre in faltan_formulas:\n                    log.append('   Name: {}   |   Type: {}   |   Formula: {}'.format(nombre, tipo, formula))\n            log.append('Despues vuelve a correr este graph para que las ordene y formatee.')\n        else:\n            log.append('')\n            log.append('Las 4 formulas estan cargadas, ordenadas, con sus unidades y con')\n            log.append('Calculate totals en TOTAL (m) y PESO TOTAL (Kg).')\n            if es_template:\n                log.append('Como se trabajo sobre el template, las tablas ya creadas se actualizan solas.')\n            else:\n                log.append('Ahora: click derecho sobre la tabla en el navegador > Create View Template From View.')\nfinally:\n    TransactionManager.Instance.TransactionTaskDone()\n\nlog.insert(0, '--- Tabla base de armaduras ---')\nOUT = log\n",
      "Engine": "PythonNet3",
