    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# 00_Vistas de assembly (ARMADURAS) - Planta + cortes por assembly mostrando el refuerzo\n# (Structural Rebar), escala automatica, Detail Level Fine. Crea un set de vista\n# PARALELO al de la rutina de Formas, con sufij ' - ARMADURA' - las vistas de\n# Formas (FN-1001, FN-1001 - CORTE A/B) NUNCA se tocan.\n# MODIFICADO: Duplica la planta original mediante la API de Revit para evitar el bloqueo de \"ya existe\".\n# Revit 2027 / Dynamo 4 / CPython3\n\nimport clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (FilteredElementCollector, AssemblyInstance,\n                               AssemblyViewUtils, AssemblyDetailViewOrientation,\n                               View, UnitUtils, UnitTypeId, XYZ, Element,\n                               ElementTransformUtils, BuiltInParameter, BuiltInCategory,\n                               ElementId, ViewFamilyType, ViewFamily, StorageType,\n                               BoundingBoxXYZ, ViewDetailLevel, Options, Solid,\n                               GeometryInstance, Plane, FamilyInstance, ViewSection,\n                               ViewDuplicateOption) # <-- Importante para duplicar vistas\nfrom Autodesk.Revit.DB.Structure import Rebar, RebarInSystem, RebarContainer, RebarHostData, RebarPresentationMode\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\nfrom System.Collections.Generic import List\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nprocess_all = bool(IN[0])\nfilter_text = (IN[1] or '').strip()\nrecreate = bool(IN[2])\ncut_margin = float(IN[3]) / 30.48  # cm -> pies\nsec_type_text = (IN[4] or '').strip()\ntpl_planta_text = (IN[5] or '').strip()\ncrop_margin_mm = float(IN[6])\npedestal_fam = (IN[7] or '').strip() or 'C-Pedestal'\npedestal_fam_low = pedestal_fam.lower()\ncallout_scale = int(IN[8]) if IN[8] else 10\ncallout_margin_mm = float(IN[9]) if IN[9] else 15.0\ntpl_cortes_text = (IN[10] or '').strip()\n\nlog = []\nlog.append('AVISO: planta y cortes de ARMADURAS quedan en Detail Level Coarse con Structural Rebar/Couplers activados; Revit por defecto solo dibuja Structural Rebar en Fine, verificar visualmente que las barras se vean en Coarse.')\nSUFIJO_ARMADURAS = ' - ARMADURA'\nSUFIJO_CORTE = SUFIJO_ARMADURAS + ' - CORTE A'\nSUFIJO_CORTE_B = SUFIJO_ARMADURAS + ' - CORTE B'\nSUFIJO_TITULO_PLANTA = SUFIJO_ARMADURAS\nFAR_CLIP_MARGIN_MM = 500.0  # Far Clip Offset FIJO (total, no margen) para los cortes A/B (2026-07-20 R2: pedido explicito de Javier, revierte el fix anterior del mismo dia que lo calculaba como profundidad real del assembly + margen -- ese calculo evitaba cortar geometria y romper cotas/tags del 03 en assemblies profundos, pero el estandar de oficina pedido es 500mm fijo para TODOS los cortes sin importar la profundidad real; asumido con la consecuencia conocida: en assemblies mas profundos que 500mm se corta geometria mas alla de ese plano y Revit puede borrar en el regen siguiente, sin avisar, las cotas/spot elevations/tags del 03 que referencian caras ahora fuera del far clip)\nfar_clip_margin_corte = FAR_CLIP_MARGIN_MM / 304.8\n\ndef to_m(v):\n    return UnitUtils.ConvertFromInternalUnits(v, UnitTypeId.Meters)\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\ndef set_name(e, name):\n    try:\n        e.Name = name\n    except Exception:\n        Element.Name.__set__(e, name)\n\n# --- tipo de vista para los cortes (define el simbolo de corte en la planta) ---\nsec_type = None\nif sec_type_text:\n    detail_types = [t for t in FilteredElementCollector(doc).OfClass(ViewFamilyType)\n                    if t.ViewFamily in (ViewFamily.Detail, ViewFamily.Section)]\n    low = sec_type_text.lower()\n    for t in detail_types:\n        if elem_name(t).lower() == low:\n            sec_type = t\n            break\n\n# --- view templates: uno para planta, otro para cortes (y callouts, que son secciones) ---\ntemplates = [t for t in FilteredElementCollector(doc).OfClass(View) if t.IsTemplate]\n\ndef resolver_template(texto, etiqueta):\n    if not texto:\n        return None\n    low = texto.lower()\n    for t in templates:\n        if elem_name(t).lower() == low:\n            return t\n    log.append('AVISO: no existe el view template \"{}\" para {} en el proyecto.'.format(texto, etiqueta))\n    if templates:\n        log.append('Templates de vista disponibles: ' + ', '.join(sorted(elem_name(t) for t in templates)))\n    return None\n\nview_template_planta = resolver_template(tpl_planta_text, 'la planta')\nview_template_corte = resolver_template(tpl_cortes_text, 'los cortes')\n\n# --- tipo de vista para los callouts de pedestal (debe ser ViewFamily.Detail) ---\nvftype_detail = None\ntipos_vft_detail = [t for t in FilteredElementCollector(doc).OfClass(ViewFamilyType)\n                    if t.ViewFamily == ViewFamily.Detail]\nif tipos_vft_detail:\n    vftype_detail = sorted(tipos_vft_detail, key=lambda t: elem_name(t))[0]\n\n# --- assemblies unicos por tipo ---\nby_type = {}\nfor ai in FilteredElementCollector(doc).OfClass(AssemblyInstance):\n    by_type.setdefault(ai.AssemblyTypeName, []).append(ai)\n\nif process_all:\n    targets = sorted(by_type.keys())\nelse:\n    tokens = [t.strip().lower() for t in filter_text.split(',') if t.strip()]\n    targets = [n for n in sorted(by_type.keys()) if any(tok in n.lower() for tok in tokens)] if tokens else []\n\n# vistas existentes por nombre (para idempotencia)\nview_ids = {}\nfor v in FilteredElementCollector(doc).OfClass(View):\n    if not v.IsTemplate:\n        view_ids[elem_name(v)] = v.Id\n\ndef member_solid_bbox(el):\n    opt = Options()\n    opt.DetailLevel = ViewDetailLevel.Fine\n    try:\n        geo = el.get_Geometry(opt)\n    except Exception:\n        geo = None\n    if geo is None:\n        return None\n    minx = miny = minz = float('inf')\n    maxx = maxy = maxz = float('-inf')\n    hay = False\n    def acumular(solid, trf):\n        sbb = solid.GetBoundingBox()\n        for x in (sbb.Min.X, sbb.Max.X):\n            for y in (sbb.Min.Y, sbb.Max.Y):\n                for z in (sbb.Min.Z, sbb.Max.Z):\n                    p = sbb.Transform.OfPoint(XYZ(x, y, z))\n                    if trf is not None:\n                        p = trf.OfPoint(p)\n                    yield p\n    pts = []\n    for g in geo:\n        if isinstance(g, Solid) and g.Volume > 1e-9:\n            pts.extend(list(acumular(g, None)))\n        elif isinstance(g, GeometryInstance):\n            for sg in g.GetSymbolGeometry():\n                if isinstance(sg, Solid) and sg.Volume > 1e-9:\n                    pts.extend(list(acumular(sg, g.Transform)))\n    for p in pts:\n        hay = True\n        if p.X < minx: minx = p.X\n        if p.X > maxx: maxx = p.X\n        if p.Y < miny: miny = p.Y\n        if p.Y > maxy: maxy = p.Y\n        if p.Z < minz: minz = p.Z\n        if p.Z > maxz: maxz = p.Z\n    if not hay:\n        return None\n    class _BB(object):\n        pass\n    r = _BB()\n    r.Min = XYZ(minx, miny, minz)\n    r.Max = XYZ(maxx, maxy, maxz)\n    return r\n\ndef local_size(ai):\n    t = ai.GetTransform()\n    tinv = t.Inverse\n    mins = [float('inf')] * 3\n    maxs = [float('-inf')] * 3\n    for mid in ai.GetMemberIds():\n        el = doc.GetElement(mid)\n        bb = member_solid_bbox(el)\n        if bb is None:\n            continue\n        for x in (bb.Min.X, bb.Max.X):\n            for y in (bb.Min.Y, bb.Max.Y):\n                for z in (bb.Min.Z, bb.Max.Z):\n                    p = tinv.OfPoint(XYZ(x, y, z))\n                    vals = (p.X, p.Y, p.Z)\n                    for i in range(3):\n                        if vals[i] < mins[i]:\n                            mins[i] = vals[i]\n                        if vals[i] > maxs[i]:\n                            maxs[i] = vals[i]\n    if mins[0] == float('inf'):\n        return None\n    return [to_m(maxs[i] - mins[i]) for i in range(3)]\n\ndef world_z_range(ai):\n    zmin = float('inf')\n    zmax = float('-inf')\n    for mid in ai.GetMemberIds():\n        el = doc.GetElement(mid)\n        bb = member_solid_bbox(el)\n        if bb is None:\n            continue\n        if bb.Min.Z < zmin:\n            zmin = bb.Min.Z\n        if bb.Max.Z > zmax:\n            zmax = bb.Max.Z\n    if zmin > zmax:\n        return None\n    return (zmin, zmax)\n\ndef find_viewer(vname):\n    for ve in FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Viewers):\n        if elem_name(ve) == vname:\n            return ve\n    return None\n\ndef ocultar_marcador_en(view, viewer, etiqueta_v, etiqueta_dest, tname):\n    if view is None or viewer is None:\n        return\n    try:\n        if viewer.IsHidden(view):\n            return\n        if viewer.CanBeHidden(view):\n            view.HideElements(List[ElementId]([viewer.Id]))\n            log.append('{}: marcador de \\\"{}\\\" oculto en {}.'.format(tname, etiqueta_v, etiqueta_dest))\n    except Exception as e:\n        pass\n\ndef ocultar_marcadores_cruzados(tname, vplan_arm):\n    doc.Regenerate()\n    vplan_formas = None\n    fid = view_ids.get(tname)\n    if fid is not None:\n        vf = doc.GetElement(fid)\n        if isinstance(vf, View):\n            vplan_formas = vf\n    nombres_arm = (tname + SUFIJO_CORTE, tname + SUFIJO_CORTE_B)\n    nombres_formas = (tname + ' - CORTE A', tname + ' - CORTE B')\n    pref_ped_arm = tname + SUFIJO_ARMADURAS + ' - PEDESTAL '\n    pref_ped_formas = tname + ' - PEDESTAL '\n    for ve in FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Viewers):\n        nom = elem_name(ve)\n        if nom in nombres_arm or nom.startswith(pref_ped_arm):\n            ocultar_marcador_en(vplan_formas, ve, nom, 'la planta de FORMAS', tname)\n        elif nom in nombres_formas or nom.startswith(pref_ped_formas):\n            ocultar_marcador_en(vplan_arm, ve, nom, 'la planta de ARMADURAS', tname)\n\ndef orientar_burbuja_corte(v, tname, label):\n    vd = v.ViewDirection\n    if abs(vd.X) <= abs(vd.Y):\n        return\n    viewer = find_viewer(elem_name(v))\n    if viewer is None:\n        return\n    cb = v.CropBox\n    centro_local = XYZ((cb.Min.X + cb.Max.X) / 2.0, (cb.Min.Y + cb.Max.Y) / 2.0, (cb.Min.Z + cb.Max.Z) / 2.0)\n    centro = cb.Transform.OfPoint(centro_local)\n    try:\n        marcador_y = viewer.Location.Point.Y\n    except Exception:\n        marcador_y = v.Origin.Y\n    if marcador_y >= centro.Y:\n        return\n    plano = Plane.CreateByNormalAndOrigin(XYZ(0.0, 1.0, 0.0), centro)\n    ids = List[ElementId]([viewer.Id])\n    ElementTransformUtils.MirrorElements(doc, ids, plano, False)\n    doc.Regenerate()\n\ndef ajustar_corte_planta(vplan, ai, tname):\n    dirz = vplan.ViewDirection.Z\n    if abs(dirz) < 0.99:\n        return\n    zr = world_z_range(ai)\n    if zr is None:\n        return\n    zmin, zmax = zr\n    if dirz > 0:\n        objetivo = zmax + cut_margin\n        far = (objetivo - zmin) + cut_margin\n    else:\n        objetivo = zmin - cut_margin\n        far = (zmax - objetivo) + cut_margin\n    dz = objetivo - vplan.Origin.Z\n    if abs(dz) > 0.003:\n        viewer = find_viewer(elem_name(vplan))\n        if viewer is None:\n            return\n        ElementTransformUtils.MoveElement(doc, viewer.Id, XYZ(0.0, 0.0, dz))\n    p = vplan.get_Parameter(BuiltInParameter.VIEWER_BOUND_OFFSET_FAR)\n    if p is not None and not p.IsReadOnly:\n        p.Set(far)\n\ndef ajustar_crop_planta(vplan, ai, tname):\n    bb = vplan.CropBox\n    inv = bb.Transform.Inverse\n    minx = miny = float('inf')\n    maxx = maxy = float('-inf')\n    hay_geo = False\n    for mid in ai.GetMemberIds():\n        el = doc.GetElement(mid)\n        mbb = member_solid_bbox(el)\n        if mbb is None:\n            continue\n        hay_geo = True\n        for x in (mbb.Min.X, mbb.Max.X):\n            for y in (mbb.Min.Y, mbb.Max.Y):\n                for z in (mbb.Min.Z, mbb.Max.Z):\n                    p = inv.OfPoint(XYZ(x, y, z))\n                    if p.X < minx: minx = p.X\n                    if p.X > maxx: maxx = p.X\n                    if p.Y < miny: miny = p.Y\n                    if p.Y > maxy: maxy = p.Y\n    if not hay_geo:\n        return\n    margen = crop_margin_mm / 304.8 * vplan.Scale\n    nuevo = BoundingBoxXYZ()\n    nuevo.Transform = bb.Transform\n    nuevo.Min = XYZ(minx - margen, miny - margen, bb.Min.Z)\n    nuevo.Max = XYZ(maxx + margen, maxy + margen, bb.Max.Z)\n    vplan.CropBox = nuevo\n    try:\n        mgr = vplan.GetCropRegionShapeManager()\n        mgr.IsAnnotationCropActive = False\n    except Exception:\n        pass\n\ndef ajustar_crop_corte(vsec, ai, tname, label):\n    bb = vsec.CropBox\n    inv = bb.Transform.Inverse\n    minx = miny = float('inf')\n    maxx = maxy = float('-inf')\n    hay_geo = False\n    for mid in ai.GetMemberIds():\n        el = doc.GetElement(mid)\n        mbb = member_solid_bbox(el)\n        if mbb is None:\n            continue\n        hay_geo = True\n        for x in (mbb.Min.X, mbb.Max.X):\n            for y in (mbb.Min.Y, mbb.Max.Y):\n                for z in (mbb.Min.Z, mbb.Max.Z):\n                    p = inv.OfPoint(XYZ(x, y, z))\n                    if p.X < minx: minx = p.X\n                    if p.X > maxx: maxx = p.X\n                    if p.Y < miny: miny = p.Y\n                    if p.Y > maxy: maxy = p.Y\n    if not hay_geo:\n        return\n    margen = crop_margin_mm / 304.8 * vsec.Scale\n    nuevo = BoundingBoxXYZ()\n    nuevo.Transform = bb.Transform\n    nuevo.Min = XYZ(minx - margen, miny - margen, bb.Min.Z)\n    nuevo.Max = XYZ(maxx + margen, maxy + margen, bb.Max.Z)\n    vsec.CropBox = nuevo\n    try:\n        mgr = vsec.GetCropRegionShapeManager()\n        mgr.IsAnnotationCropActive = False\n    except Exception:\n        pass\n\ndef ajustar_crop_callout(vsec, bb_mundo, margen_mm, escala):\n    # mismo patron que ajustar_crop_planta/ajustar_crop_corte: bb_mundo (coordenadas\n    # MUNDO, ver bbox_barras_pedestal) se reproyecta al sistema local del CropBox\n    # actual del callout. Se usa tanto al crear el callout como para RETROFITEAR uno ya\n    # existente cuyo crop haya quedado grande (ver bbox_barras_pedestal).\n    bbc = vsec.CropBox\n    inv = bbc.Transform.Inverse\n    minx = miny = float('inf')\n    maxx = maxy = float('-inf')\n    for x in (bb_mundo.Min.X, bb_mundo.Max.X):\n        for y in (bb_mundo.Min.Y, bb_mundo.Max.Y):\n            for z in (bb_mundo.Min.Z, bb_mundo.Max.Z):\n                p = inv.OfPoint(XYZ(x, y, z))\n                if p.X < minx: minx = p.X\n                if p.X > maxx: maxx = p.X\n                if p.Y < miny: miny = p.Y\n                if p.Y > maxy: maxy = p.Y\n    margen = margen_mm / 304.8 * escala\n    nuevo = BoundingBoxXYZ()\n    nuevo.Transform = bbc.Transform\n    nuevo.Min = XYZ(minx - margen, miny - margen, bbc.Min.Z)\n    nuevo.Max = XYZ(maxx + margen, maxy + margen, bbc.Max.Z)\n    vsec.CropBox = nuevo\n\ndef ajustar_far_clip_corte(vsec, ai, tname, label):\n    # Far Clip Offset FIJO en FAR_CLIP_MARGIN_MM para TODOS los cortes A/B, sin\n    # importar la profundidad real del assembly (2026-07-20 R2, pedido explicito de\n    # Javier -- ver comentario en FAR_CLIP_MARGIN_MM sobre la consecuencia conocida en\n    # assemblies mas profundos que el offset).\n    p_activo = vsec.get_Parameter(BuiltInParameter.VIEWER_BOUND_ACTIVE_FAR)\n    if p_activo is not None and not p_activo.IsReadOnly:\n        p_activo.Set(1)\n    p_offset = vsec.get_Parameter(BuiltInParameter.VIEWER_BOUND_OFFSET_FAR)\n    if p_offset is not None and not p_offset.IsReadOnly:\n        p_offset.Set(far_clip_margin_corte)\n\ndef ajustar_titulo_planta(v, tname):\n    p = v.get_Parameter(BuiltInParameter.VIEW_DESCRIPTION)\n    if p is None or p.IsReadOnly:\n        return\n    deseado = tname + SUFIJO_TITULO_PLANTA\n    if p.AsString() != deseado:\n        p.Set(deseado)\n\ndef ocultar_simbolos_corte(v, tname, label):\n    try:\n        cat = ElementId(BuiltInCategory.OST_Sections)\n        if v.CanCategoryBeHidden(cat) and not v.GetCategoryHidden(cat):\n            v.SetCategoryHidden(cat, True)\n    except Exception as e:\n        log.append('{}: no se pudo ocultar Sections en {} (probablemente el view template la controla): {}'.format(tname, label, e))\n\nCATS_ARMADURA = ((BuiltInCategory.OST_Rebar, 'Structural Rebar'), (BuiltInCategory.OST_Coupler, 'Structural Rebar Couplers'))\n\ndef preparar_vista_armadura(v, tname, label):\n    try:\n        if v.DetailLevel != ViewDetailLevel.Coarse:\n            v.DetailLevel = ViewDetailLevel.Coarse\n    except Exception:\n        pass\n    for bic, nombre_cat in CATS_ARMADURA:\n        try:\n            cat = ElementId(bic)\n            if v.CanCategoryBeHidden(cat) and v.GetCategoryHidden(cat):\n                v.SetCategoryHidden(cat, False)\n                log.append('{}: categoria {} activada en {}.'.format(tname, nombre_cat, label))\n        except Exception:\n            pass\n\nCATS_CALLOUT = ((BuiltInCategory.OST_Callouts, 'Callouts'), (BuiltInCategory.OST_CalloutBoundary, 'Callout Boundary'), (BuiltInCategory.OST_CalloutHeads, 'Callout Heads'))\n\ndef mostrar_categoria_callouts(v, tname, label):\n    # La planta de ARMADURAS nace duplicada de la planta de FORMAS (Duplicate), que\n    # nunca crea callouts de pedestal -- si su template/estado tenia la categoria\n    # Callouts oculta (plausible, nadie la necesitaba antes), la planta de ARMADURAS\n    # hereda esa categoria oculta y el marcador del callout de pedestal (creado por\n    # crear_callout_pedestal) queda invisible en la planta aunque el elemento exista y\n    # no este oculto por si mismo (2026-07-21, mismo patron que CATS_ARMADURA con Structural\n    # Rebar/Couplers, que ya se forzaban visibles por la misma razon).\n    for bic, nombre_cat in CATS_CALLOUT:\n        try:\n            cat = ElementId(bic)\n            if v.CanCategoryBeHidden(cat) and v.GetCategoryHidden(cat):\n                v.SetCategoryHidden(cat, False)\n                log.append('{}: categoria {} activada en {}.'.format(tname, nombre_cat, label))\n        except Exception:\n            pass\n\nPARAM_CANTIDAD = 'Cantidad_Inserto'\n\ndef set_cantidad(v, cantidad, tname):\n    p = v.LookupParameter(PARAM_CANTIDAD)\n    if p is None or p.IsReadOnly:\n        return\n    st = p.StorageType\n    if st == StorageType.Integer:\n        p.Set(int(cantidad))\n    elif st == StorageType.Double:\n        p.Set(float(cantidad))\n    else:\n        p.Set(str(cantidad))\n\ndef armaduras_del_assembly(ai):\n    # RebarHostData se chequea en CUALQUIER instancia del assembly, a cualquier\n    # profundidad de anidamiento (instancias_recursivas, 2026-07-20) -- no solo en\n    # los miembros de PRIMER NIVEL: si el host de la barra es un sub-componente\n    # anidado 2+ niveles adentro, RebarHostData.GetRebarHostData() sobre el miembro\n    # de primer nivel daba None y la barra no se mostraba/pasaba a modo\n    # primera-y-ultima (mismo bug que rebar_del_assembly de 03).\n    barras = {}\n    def agregar(r):\n        try:\n            barras[r.Id.Value] = r\n        except Exception:\n            pass\n    for mid in ai.GetMemberIds():\n        el = doc.GetElement(mid)\n        if isinstance(el, (Rebar, RebarInSystem, RebarContainer)):\n            agregar(el)\n    for el in instancias_recursivas(ai):\n        try:\n            hd = RebarHostData.GetRebarHostData(el)\n        except Exception:\n            hd = None\n        if hd is None:\n            continue\n        try:\n            for r in hd.GetRebarsInHost():\n                agregar(r)\n        except Exception:\n            pass\n    return list(barras.values())\n\ndef mostrar_armaduras(v, barras, tname, label):\n    if not barras:\n        return\n    cambiadas = 0\n    for r in barras:\n        try:\n            if not r.IsUnobscuredInView(v):\n                r.SetUnobscuredInView(v, True)\n                cambiadas += 1\n        except Exception:\n            pass\n    if cambiadas:\n        log.append('{}: {} barras visibles en {}.'.format(tname, cambiadas, label))\n\ndef mostrar_primera_ultima(v, barras, tname, label):\n    # 'Show First and Last Rebar in Rebar Set' (checkbox de Presentation en la UI) =\n    # Rebar.SetPresentationMode(view, RebarPresentationMode.FirstLast). Solo aplica a\n    # sets con mas de una barra (CanApplyPresentationMode devuelve False para barras\n    # individuales, ej. Layout 'Single' - se salta sin error, no hace falta releer el\n    # Layout Rule de la barra aca).\n    if not barras:\n        return\n    cambiadas = 0\n    for r in barras:\n        try:\n            if not r.CanApplyPresentationMode(v):\n                continue\n            if r.GetPresentationMode(v) != RebarPresentationMode.FirstLast:\n                r.SetPresentationMode(v, RebarPresentationMode.FirstLast)\n                cambiadas += 1\n        except Exception:\n            pass\n    if cambiadas:\n        log.append('{}: {} sets de barras en modo \\\"primera y ultima\\\" en {}.'.format(tname, cambiadas, label))\n\ndef es_familia_pedestal(nombre_familia):\n    # 2026-07-15: no todos los pedestales son la familia \\\"C-Pedestal\\\" pura (PD-1004,\n    # PD-1003, PD-1010) - hay familias COMBINADAS fundacion+pedestal en una sola pieza\n    # (\\\"C-Fundacion+Pedestal\\\", \\\"C-Fundacion+2-Pedestal\\\": confirmado con Javier que ahi\n    # el sub-componente que hospeda la barra, ej. G35, cuelga DIRECTO de esa familia\n    # combinada via SuperComponent, sin un nivel intermedio \\\"solo pedestal\\\" separable).\n    # Match por substring (no exacto) para no tener que mantener una lista de nombres.\n    try:\n        return 'pedestal' in nombre_familia.strip().lower()\n    except Exception:\n        return False\n\ndef pedestales_del_assembly(ai):\n    # todas las instancias del assembly (a cualquier profundidad, via\n    # instancias_recursivas) cuya familia matchea es_familia_pedestal - se usa SOLO\n    # para CONTAR cuantos pedestales tiene el assembly, no para decidir barra por\n    # barra (ver ocultar_barras_pedestal).\n    resultado = []\n    for el in instancias_recursivas(ai):\n        try:\n            fam = el.Symbol.Family.Name\n        except Exception:\n            continue\n        if es_familia_pedestal(fam):\n            resultado.append(el)\n    return resultado\n\ndef es_barra_de_pedestal(r, pedestal_ids):\n    # host de la barra (Rebar.GetHostId) y su cadena de anidamiento\n    # (FamilyInstance.SuperComponent): True si el host o algun ancestro ES una de las\n    # instancias de pedestal del assembly (pedestal_ids, ver pedestales_del_assembly) -\n    # no compara por nombre de familia aca, compara por ElementId puntual.\n    try:\n        host = doc.GetElement(r.GetHostId())\n    except Exception:\n        return False\n    pasos = 0\n    while host is not None and pasos < 50:\n        try:\n            hid = host.Id.Value\n        except Exception:\n            hid = None\n        if hid is not None and hid in pedestal_ids:\n            return True\n        try:\n            host = host.SuperComponent\n        except Exception:\n            host = None\n        pasos += 1\n    return False\n\ndef resolver_pedestal_de_barra(r, pedestal_ids):\n    # Mismo recorrido que es_barra_de_pedestal (GetHostId + SuperComponent hacia\n    # arriba), pero devuelve el ElementId.Value del pedestal encontrado en vez de\n    # True/False -- para filtrar el callout por el pedestal ESPECIFICO que le\n    # corresponde (no solo \"es de algun pedestal\"). None si la barra no cuelga de\n    # ningun pedestal del assembly (ej. armadura de zapata/radier).\n    try:\n        host = doc.GetElement(r.GetHostId())\n    except Exception:\n        return None\n    pasos = 0\n    while host is not None and pasos < 50:\n        try:\n            hid = host.Id.Value\n        except Exception:\n            hid = None\n        if hid is not None and hid in pedestal_ids:\n            return hid\n        try:\n            host = host.SuperComponent\n        except Exception:\n            host = None\n        pasos += 1\n    return None\n\nPEDESTAL_PARTITION_PREFIX = 'PPL-PPL'\ndef leer_partition_barra(r):\n    # mismo patron que leer_partition del 03: parametro de instancia de texto plano,\n    # AsString() (no AsValueString(), no es un enum).\n    try:\n        p = r.LookupParameter('Partition')\n    except Exception:\n        p = None\n    if p is None:\n        return None\n    try:\n        valor = p.AsString()\n    except Exception:\n        valor = None\n    return valor.strip() if valor else None\n\ndef ocultar_barras_pedestal(v, barras, tname, label, pedestales):\n    # Regla de negocio 2026-07-15, AMPLIADA 2026-07-20 (definida con el jefe de area):\n    # antes, con 2+ pedestales se ocultaba TODA la armadura de pedestal (ambiguo a cual\n    # pedestal pertenece cada barra) y con 0 o 1 pedestal se mostraba todo sin filtrar.\n    # Ahora, sin importar cuantos pedestales tenga el assembly, toda barra que\n    # pertenezca a un pedestal se muestra en planta UNICAMENTE si su parametro de\n    # instancia Partition empieza con PPL-PPL (la armadura principal/longitudinal del\n    # pedestal) - el resto de tipos de armadura del pedestal (estribos, etc.) se oculta\n    # siempre, ya no depende de la ambiguedad entre pedestales porque el filtro es por\n    # Partition, no por a que pedestal pertenece cada barra. Las barras que NO son de\n    # pedestal (zapata/radier: PPL-SUP, PPL-INF, SEC-LAT, SEC-RFZ) nunca pasan por este\n    # filtro, siguen mostrandose igual que siempre. Oculta explicitamente\n    # (View.HideElements) - complementa el forzado de categoria visible de\n    # preparar_vista_armadura, que no distingue por elemento. Devuelve las barras que SI\n    # deben mostrarse (para encadenar con mostrar_armaduras / mostrar_primera_ultima).\n    if not barras or not pedestales:\n        return list(barras)\n    pedestal_ids = set()\n    for el in pedestales:\n        try:\n            pedestal_ids.add(el.Id.Value)\n        except Exception:\n            pass\n    visibles = []\n    ids = List[ElementId]()\n    for r in barras:\n        if es_barra_de_pedestal(r, pedestal_ids):\n            partition = leer_partition_barra(r)\n            if partition and partition.startswith(PEDESTAL_PARTITION_PREFIX):\n                visibles.append(r)\n                continue\n            try:\n                if r.CanBeHidden(v) and not r.IsHidden(v):\n                    ids.Add(r.Id)\n            except Exception:\n                pass\n        else:\n            visibles.append(r)\n    if ids.Count > 0:\n        try:\n            v.HideElements(ids)\n            log.append('{}: {} barras de pedestal ocultas en {} (Partition distinto de {}, {} pedestales en el assembly).'.format(tname, ids.Count, label, PEDESTAL_PARTITION_PREFIX, len(pedestales)))\n        except Exception as e:\n            log.append('ERROR {} ocultando barras de pedestal en {}: {}'.format(tname, label, e))\n    return visibles\n\ndef aplicar_template(v, tname, label, scale, template):\n    if template is None:\n        return\n    try:\n        if v.ViewTemplateId != template.Id:\n            v.ViewTemplateId = template.Id\n            log.append('{}: template aplicado a {}.'.format(tname, label))\n        if v.Scale != scale:\n            v.Scale = scale\n    except Exception as e:\n        pass\n\ndef instancias_recursivas(ai):\n    vistos = set()\n    resultado = []\n    stack = list(ai.GetMemberIds())\n    while stack:\n        eid = stack.pop()\n        if eid.Value in vistos:\n            continue\n        vistos.add(eid.Value)\n        el = doc.GetElement(eid)\n        if el is None or not isinstance(el, FamilyInstance):\n            continue\n        resultado.append(el)\n        try:\n            stack.extend(list(el.GetSubComponentIds()))\n        except Exception:\n            pass\n    return resultado\n\ndef tipos_pedestal(ai):\n    # 2026-07-21 R2: antes exact-matcheaba la familia contra pedestal_fam_low\n    # (default 'C-Pedestal'), asi que los assemblies cuyo unico pedestal vive en una\n    # familia COMBINADA (ej. C-Fundacion+Pedestal, C-Fundacion+2-Pedestal) nunca\n    # generaban ningun callout -- quedaban con grupos={} aunque\n    # pedestales_del_assembly() (usada para el filtro de armadura) SI los contaba. Ahora\n    # usa el mismo criterio amplio es_familia_pedestal() (substring 'pedestal' en el\n    # nombre de familia, case-insensitive) que ya rige en toda la rutina para identificar\n    # que es 'tipo pedestal' -- pedestal_fam_low queda sin uso aca (el input \"Familia de\n    # pedestal para callouts\" no filtra mas la deteccion, cualquier familia con\n    # 'pedestal' en el nombre cuenta). Se sigue agrupando por Symbol.Name (tipo), no por\n    # familia -- si el mismo tipo se repite varias instancias, es UN solo grupo.\n    grupos = {}\n    for el in instancias_recursivas(ai):\n        try:\n            fam = el.Symbol.Family.Name\n        except Exception:\n            continue\n        if not es_familia_pedestal(fam):\n            continue\n        tn = elem_name(el.Symbol)\n        grupos.setdefault(tn, []).append(el)\n    return grupos\n\ndef bbox_con_anidados(el):\n    pila = [el]\n    vistos = set()\n    minx = miny = minz = float('inf')\n    maxx = maxy = maxz = float('-inf')\n    hay = False\n    while pila:\n        e = pila.pop()\n        if e is None:\n            continue\n        try:\n            eid = e.Id.Value\n        except Exception:\n            eid = None\n        if eid is not None:\n            if eid in vistos:\n                continue\n            vistos.add(eid)\n        bb = member_solid_bbox(e)\n        if bb is not None:\n            hay = True\n            if bb.Min.X < minx: minx = bb.Min.X\n            if bb.Max.X > maxx: maxx = bb.Max.X\n            if bb.Min.Y < miny: miny = bb.Min.Y\n            if bb.Max.Y > maxy: maxy = bb.Max.Y\n            if bb.Min.Z < minz: minz = bb.Min.Z\n            if bb.Max.Z > maxz: maxz = bb.Max.Z\n        if isinstance(e, FamilyInstance):\n            try:\n                for sid in e.GetSubComponentIds():\n                    pila.append(doc.GetElement(sid))\n            except Exception:\n                pass\n    if not hay:\n        return None\n    class _BB(object):\n        pass\n    r = _BB()\n    r.Min = XYZ(minx, miny, minz)\n    r.Max = XYZ(maxx, maxy, maxz)\n    return r\n\ndef barras_del_pedestal(el_ped, pedestales, barras, vplan):\n    # Fuente UNICA de verdad de \"que barras pertenecen a este pedestal especifico\" --\n    # la usan tanto limitar_callout_a_pedestal (visibilidad) como bbox_barras_pedestal\n    # (crop), para no duplicar el criterio en dos lados.\n    #\n    # Historial 2026-07-21 (iterado varias veces con Javier): SuperComponent solo no\n    # alcanza (no distingue pedestal de zapata en familias COMBINADAS, donde ambas\n    # cuelgan del mismo elemento). Una lista de Partitions tampoco alcanza, ni blanca\n    # (PPL-PPL unicamente dejaba afuera barras reales del pedestal con otra Partition,\n    # ej. estribos SEC-EST) ni negra (ZAPATA_PARTITIONS dejaba pasar barras de zapata\n    # reales con Partition en blanco -- Schedule Mark \"(SUP.-INF.)\"/\"(LATERAL)\" en el\n    # modelo real -- porque el modelador nunca les asigno el parametro). Javier senalo\n    # el problema de fondo: una lista de valores (blanca o negra) NUNCA es escalable,\n    # cualquier Partition nueva o mal cargada la rompe de nuevo.\n    #\n    # Criterio: PEDESTAL_PARTITION_PREFIX (PPL-PPL, la unica Partition inequivoca desde\n    # el pedido original) se usa SOLO como ANCLA para identificar el/los elemento(s) de\n    # hormigon que HOSPEDAN (Rebar.GetHostId, host directo, no SuperComponent) la\n    # armadura principal del pedestal -- y despues se acepta CUALQUIER barra hospedada\n    # en ese host, sin importar su propia Partition (vacia, con un valor nuevo, como\n    # sea). No depende de que Partition este bien cargado en cada barra individual,\n    # solo en al menos una (la PPL-PPL) por host.\n    #\n    # Un solo pedestal por callout, aunque haya 2+ hosts anclados (2026-07-21, caso real\n    # FN-1011: dos pedestales \"iguales\" (mismo tipo) fusionados en UNA sola instancia\n    # combinada -- no son dos FamilyInstance entre las que elegir, son dos capas\n    # anidadas distintas dentro de la MISMA instancia, cada una con su propia barra\n    # PPL-PPL). Si hosts_ancla tiene mas de un host, host_mas_a_la_derecha() elige UNO\n    # solo (mismo criterio que elemento_mas_a_la_derecha para elegir entre instancias\n    # distintas) y se descartan las barras de los demas hosts anclados.\n    try:\n        target_id = el_ped.Id.Value\n    except Exception:\n        return []\n    pedestal_ids = set()\n    for p in pedestales:\n        try:\n            pedestal_ids.add(p.Id.Value)\n        except Exception:\n            pass\n    del_pedestal = [r for r in barras if resolver_pedestal_de_barra(r, pedestal_ids) == target_id]\n    hosts_ancla = set()\n    for r in del_pedestal:\n        partition = leer_partition_barra(r)\n        if partition and partition.strip().upper().startswith(PEDESTAL_PARTITION_PREFIX):\n            try:\n                hid = r.GetHostId()\n            except Exception:\n                hid = None\n            if hid is not None and hid.Value >= 0:\n                hosts_ancla.add(hid.Value)\n    if not hosts_ancla:\n        # sin ninguna barra PPL-PPL para anclar (no deberia pasar en un pedestal bien\n        # modelado) -- se cae a todo lo que resuelva por SuperComponent, mejor que\n        # dejar el callout vacio.\n        return del_pedestal\n    host_elegido = host_mas_a_la_derecha(vplan, hosts_ancla)\n    if host_elegido is None:\n        return del_pedestal\n    resultado = []\n    for r in del_pedestal:\n        try:\n            hid = r.GetHostId()\n        except Exception:\n            hid = None\n        if hid is not None and hid.Value == host_elegido:\n            resultado.append(r)\n    return resultado\n\ndef bbox_barras_pedestal(el_ped, pedestales, barras, vplan):\n    # 2026-07-21: el crop del callout NO puede seguir midiendose con\n    # bbox_con_anidados(el_ped) en familias COMBINADAS (ej. C-Fundacion+Pedestal) --\n    # ahi el_ped ES la zapata y el pedestal fusionados en un solo solido, asi que su\n    # bbox completo incluye la zapata entera (Javier: \"el crop deberia ajustarse\n    # unicamente al pedestal, no a toda la zapata\"). En cambio, se mide el bbox de los\n    # HOSTS REALES de barras_del_pedestal() -- ese host tipicamente es la capa anidada\n    # especifica del pedestal (ej. G35), mas chica que la zapata completa, sin importar\n    # si el_ped es una familia pura o combinada. None si no se encontro ninguna barra\n    # valida (el caller cae de vuelta a bbox_con_anidados(el_ped) en ese caso).\n    hosts = set()\n    for r in barras_del_pedestal(el_ped, pedestales, barras, vplan):\n        try:\n            hid = r.GetHostId()\n        except Exception:\n            hid = None\n        if hid is not None and hid.Value >= 0:\n            hosts.add(hid.Value)\n    if not hosts:\n        return None\n    minx = miny = minz = float('inf')\n    maxx = maxy = maxz = float('-inf')\n    hay = False\n    for hid in hosts:\n        el_host = doc.GetElement(ElementId(hid))\n        bb = member_solid_bbox(el_host)\n        if bb is None:\n            continue\n        hay = True\n        if bb.Min.X < minx: minx = bb.Min.X\n        if bb.Max.X > maxx: maxx = bb.Max.X\n        if bb.Min.Y < miny: miny = bb.Min.Y\n        if bb.Max.Y > maxy: maxy = bb.Max.Y\n        if bb.Min.Z < minz: minz = bb.Min.Z\n        if bb.Max.Z > maxz: maxz = bb.Max.Z\n    if not hay:\n        return None\n    class _BB(object):\n        pass\n    r_ = _BB()\n    r_.Min = XYZ(minx, miny, minz)\n    r_.Max = XYZ(maxx, maxy, maxz)\n    return r_\n\ndef elemento_mas_a_la_derecha(vplan, instancias):\n    inv = vplan.CropBox.Transform.Inverse\n    mejor = None\n    mejor_x = float('-inf')\n    for el in instancias:\n        bb = bbox_con_anidados(el)\n        if bb is None:\n            continue\n        cx = (bb.Min.X + bb.Max.X) / 2.0\n        cy = (bb.Min.Y + bb.Max.Y) / 2.0\n        cz = (bb.Min.Z + bb.Max.Z) / 2.0\n        p_local = inv.OfPoint(XYZ(cx, cy, cz))\n        if p_local.X > mejor_x:\n            mejor_x = p_local.X\n            mejor = (el, bb)\n    return mejor\n\ndef host_mas_a_la_derecha(vplan, host_ids):\n    # mismo criterio que elemento_mas_a_la_derecha, pero para elegir UN host de\n    # hormigon entre varios anclados por PPL-PPL (ver barras_del_pedestal) -- caso real\n    # 2026-07-21: un assembly puede tener DOS pedestales \"iguales\" (mismo tipo)\n    # fusionados en una UNICA instancia combinada (ej. FN-1011), asi que no hay dos\n    # instancias de FamilyInstance entre las que elegir (elemento_mas_a_la_derecha no\n    # aplica, son la MISMA instancia) -- hay que elegir entre los HOSTS anidados de esa\n    # unica instancia.\n    inv = vplan.CropBox.Transform.Inverse\n    mejor = None\n    mejor_x = float('-inf')\n    for hid in host_ids:\n        el_host = doc.GetElement(ElementId(hid))\n        bb = member_solid_bbox(el_host)\n        if bb is None:\n            continue\n        cx = (bb.Min.X + bb.Max.X) / 2.0\n        cy = (bb.Min.Y + bb.Max.Y) / 2.0\n        cz = (bb.Min.Z + bb.Max.Z) / 2.0\n        p_local = inv.OfPoint(XYZ(cx, cy, cz))\n        if p_local.X > mejor_x:\n            mejor_x = p_local.X\n            mejor = hid\n    return mejor\n\ndef limitar_callout_a_pedestal(callout, el_ped, pedestales, barras, tname, tipo, vplan):\n    # El callout de un tipo de pedestal debe mostrar EXCLUSIVAMENTE la armadura de ESE\n    # pedestal (2026-07-21, pedido explicito de Javier, iterado varias veces -- version\n    # final). Ver barras_del_pedestal() para el criterio completo (estructural, por\n    # host de hormigon anclado en la Partition PPL-PPL -- no por lista de valores de\n    # Partition, ni blanca ni negra, ninguna de las dos escalaba). Cualquier barra que\n    # NO este en barras_del_pedestal() se oculta. Ademas se ocultan los elementos de\n    # CONCRETO de otros pedestales (y sus subcomponentes anidados) para que tampoco\n    # aparezca su geometria. El pedestal elegido y su propio contenido quedan intactos.\n    try:\n        target_id = el_ped.Id.Value\n    except Exception:\n        return\n    validas_ids = set()\n    for r in barras_del_pedestal(el_ped, pedestales, barras, vplan):\n        try:\n            validas_ids.add(r.Id.Value)\n        except Exception:\n            pass\n    ids = List[ElementId]()\n    for r in barras:\n        try:\n            rid = r.Id.Value\n        except Exception:\n            rid = None\n        if rid is not None and rid in validas_ids:\n            continue\n        try:\n            if r.CanBeHidden(callout) and not r.IsHidden(callout):\n                ids.Add(r.Id)\n        except Exception:\n            pass\n    for otro in pedestales:\n        try:\n            if otro.Id.Value == target_id:\n                continue\n        except Exception:\n            continue\n        pila = [otro]\n        while pila:\n            e = pila.pop()\n            if e is None:\n                continue\n            try:\n                if e.CanBeHidden(callout) and not e.IsHidden(callout):\n                    ids.Add(e.Id)\n            except Exception:\n                pass\n            if isinstance(e, FamilyInstance):\n                try:\n                    for sid in e.GetSubComponentIds():\n                        pila.append(doc.GetElement(sid))\n                except Exception:\n                    pass\n    if ids.Count > 0:\n        try:\n            callout.HideElements(ids)\n            log.append('{}: {} elementos fuera del pedestal {} ocultos en su callout.'.format(tname, ids.Count, tipo))\n        except Exception as e:\n            log.append('ERROR {} limitando el callout de {} al pedestal: {}'.format(tname, tipo, e))\n\ndef crear_callout_pedestal(vplan, tname, tipo, bb, vftype, escala, margen_mm, barras, el_ped, pedestales):\n    global callouts_creados, callouts_saltados\n    vname = '{}{} - PEDESTAL {}'.format(tname, SUFIJO_ARMADURAS, tipo)\n    # bbox_barras_pedestal (mas ajustado, mide los hosts reales de las barras del\n    # pedestal) reemplaza a bb (bbox_con_anidados de el_ped completo, ver comentario en\n    # esa funcion) como fuente del crop -- si no se encontro ninguna barra valida, cae\n    # de vuelta a bb para no dejar el callout sin crop.\n    bb_ajustado = bbox_barras_pedestal(el_ped, pedestales, barras, vplan)\n    if bb_ajustado is None:\n        bb_ajustado = bb\n    callout = None\n    if vname in view_ids:\n        if recreate:\n            doc.Delete(view_ids[vname])\n            del view_ids[vname]\n        else:\n            callout = doc.GetElement(view_ids[vname])\n            callouts_saltados += 1\n    if callout is None:\n        inv = vplan.CropBox.Transform.Inverse\n        tr = vplan.CropBox.Transform\n        minx = miny = float('inf')\n        maxx = maxy = float('-inf')\n        for x in (bb_ajustado.Min.X, bb_ajustado.Max.X):\n            for y in (bb_ajustado.Min.Y, bb_ajustado.Max.Y):\n                for z in (bb_ajustado.Min.Z, bb_ajustado.Max.Z):\n                    p = inv.OfPoint(XYZ(x, y, z))\n                    if p.X < minx: minx = p.X\n                    if p.X > maxx: maxx = p.X\n                    if p.Y < miny: miny = p.Y\n                    if p.Y > maxy: maxy = p.Y\n        margen = margen_mm / 304.8 * escala\n        p1 = tr.OfPoint(XYZ(minx - margen, miny - margen, 0.0))\n        p2 = tr.OfPoint(XYZ(maxx + margen, maxy + margen, 0.0))\n        callout = ViewSection.CreateCallout(doc, vplan.Id, vftype.Id, p1, p2)\n        set_name(callout, vname)\n        callout.Scale = escala\n        callout.DetailLevel = ViewDetailLevel.Fine\n        view_ids[vname] = callout.Id\n        callouts_creados += 1\n        log.append('OK {}: callout de pedestal {} creado.'.format(tname, tipo))\n    else:\n        # retrofit: recalcular el crop tambien en callouts YA EXISTENTES, creados en\n        # una corrida anterior con el bbox viejo (mas ancho en familias combinadas).\n        try:\n            ajustar_crop_callout(callout, bb_ajustado, margen_mm, escala)\n        except Exception as e:\n            log.append('ERROR {} ajustando crop del callout de {}: {}'.format(tname, tipo, e))\n    aplicar_template(callout, tname, 'callout de ' + tipo, escala, view_template_corte)\n    try:\n        mostrar_armaduras(callout, barras, tname, 'callout de ' + tipo)\n    except Exception:\n        pass\n    try:\n        if callout.CropBoxVisible:\n            callout.CropBoxVisible = False\n    except Exception:\n        pass\n    limitar_callout_a_pedestal(callout, el_ped, pedestales, barras, tname, tipo, vplan)\n\ncallouts_creados = 0\ncallouts_saltados = 0\ncreated = 0\nskipped = 0\nTransactionManager.Instance.EnsureInTransaction(doc)\ntry:\n    for tname in targets:\n        insts = by_type[tname]\n        ai = insts[0]\n        try:\n            size = local_size(ai)\n            scale = 50 if size is not None and (size[0] > 2.0 or size[1] > 2.0) else 25\n            barras_ai = armaduras_del_assembly(ai)\n            pedestales_ai = pedestales_del_assembly(ai)\n            \n            # 1. PLANTA FORMAS (Original sin sufijo)\n            vplan_formas = None\n            if tname in view_ids:\n                vplan_formas = doc.GetElement(view_ids[tname])\n                log.append('{}: planta formas ya existe.'.format(tname))\n            else:\n                vplan_formas = AssemblyViewUtils.CreateDetailSection(doc, ai.Id, AssemblyDetailViewOrientation.HorizontalDetail)\n                set_name(vplan_formas, tname)\n                vplan_formas.Scale = scale\n                vplan_formas.DetailLevel = ViewDetailLevel.Fine\n                view_ids[tname] = vplan_formas.Id\n                created += 1\n                log.append('OK {}: planta formas creada.'.format(tname))\n                \n            if vplan_formas is not None:\n                if not vplan_formas.CropBoxActive:\n                    vplan_formas.CropBoxActive = True\n                ajustar_corte_planta(vplan_formas, ai, tname)\n                ajustar_crop_planta(vplan_formas, ai, tname)\n\n            # 2. PLANTA ARMADURAS (Duplicado)\n            vplan_arm = None\n            vname_arm = tname + SUFIJO_ARMADURAS\n            if vname_arm in view_ids:\n                if recreate:\n                    doc.Delete(view_ids[vname_arm])\n                    del view_ids[vname_arm]\n                    log.append('{}: planta armaduras anterior eliminada para recrear.'.format(tname))\n                    # Duplicar planta formas original\n                    new_id = vplan_formas.Duplicate(ViewDuplicateOption.Duplicate)\n                    vplan_arm = doc.GetElement(new_id)\n                    set_name(vplan_arm, vname_arm)\n                    view_ids[vname_arm] = vplan_arm.Id\n                    created += 1\n                    log.append('OK {}: planta armaduras creada (por duplicado).'.format(tname))\n                else:\n                    vplan_arm = doc.GetElement(view_ids[vname_arm])\n                    log.append('{}: planta armaduras ya existe, se salta.'.format(tname))\n                    skipped += 1\n            else:\n                # Duplicar planta formas original\n                new_id = vplan_formas.Duplicate(ViewDuplicateOption.Duplicate)\n                vplan_arm = doc.GetElement(new_id)\n                set_name(vplan_arm, vname_arm)\n                view_ids[vname_arm] = vplan_arm.Id\n                created += 1\n                log.append('OK {}: planta armaduras creada (por duplicado).'.format(tname))\n                \n            if vplan_arm is not None:\n                if not vplan_arm.CropBoxActive:\n                    vplan_arm.CropBoxActive = True\n                ajustar_corte_planta(vplan_arm, ai, tname)\n                ajustar_crop_planta(vplan_arm, ai, tname)\n                ajustar_titulo_planta(vplan_arm, tname)\n                set_cantidad(vplan_arm, len(insts), tname)\n                aplicar_template(vplan_arm, tname, 'planta armaduras', scale, view_template_planta)\n                barras_planta = ocultar_barras_pedestal(vplan_arm, barras_ai, tname, 'planta armaduras', pedestales_ai)\n                mostrar_armaduras(vplan_arm, barras_planta, tname, 'planta armaduras')\n                mostrar_primera_ultima(vplan_arm, barras_planta, tname, 'planta armaduras')\n                preparar_vista_armadura(vplan_arm, tname, 'planta armaduras')\n                mostrar_categoria_callouts(vplan_arm, tname, 'planta armaduras')\n\n            # 3. CORTES (A y B)\n            jobs_cortes = (\n                (tname + SUFIJO_CORTE, AssemblyDetailViewOrientation.DetailSectionA, 'corte A'),\n                (tname + SUFIJO_CORTE_B, AssemblyDetailViewOrientation.DetailSectionB, 'corte B')\n            )\n            for vname_corte, orient, label in jobs_cortes:\n                v_corte = None\n                if vname_corte in view_ids:\n                    if recreate:\n                        doc.Delete(view_ids[vname_corte])\n                        del view_ids[vname_corte]\n                        log.append('{}: {} anterior eliminada.'.format(tname, label))\n                    else:\n                        log.append('{}: {} ya existe, se salta.'.format(tname, label))\n                        skipped += 1\n                        v_corte = doc.GetElement(view_ids[vname_corte])\n                if v_corte is None:\n                    v_corte = AssemblyViewUtils.CreateDetailSection(doc, ai.Id, orient)\n                    set_name(v_corte, vname_corte)\n                    v_corte.Scale = scale\n                    v_corte.DetailLevel = ViewDetailLevel.Coarse\n                    view_ids[vname_corte] = v_corte.Id\n                    created += 1\n                    log.append('OK {}: {} creada.'.format(tname, label))\n                \n                if v_corte is not None:\n                    if not v_corte.CropBoxActive:\n                        v_corte.CropBoxActive = True\n                    if v_corte.CropBoxVisible:\n                        v_corte.CropBoxVisible = False\n                    orientar_burbuja_corte(v_corte, tname, label)\n                    ajustar_crop_corte(v_corte, ai, tname, label)\n                    ajustar_far_clip_corte(v_corte, ai, tname, label)\n                    aplicar_template(v_corte, tname, label, scale, view_template_corte)\n                    mostrar_armaduras(v_corte, barras_ai, tname, label)\n                    preparar_vista_armadura(v_corte, tname, label)\n                    ocultar_simbolos_corte(v_corte, tname, label)\n                    if sec_type is not None and v_corte.GetTypeId() != sec_type.Id:\n                        try:\n                            v_corte.ChangeTypeId(sec_type.Id)\n                        except Exception:\n                            pass\n\n            # 4. CALLOUTS PEDESTALES\n            if vplan_arm is not None and vftype_detail is not None:\n                try:\n                    grupos = tipos_pedestal(ai)\n                except Exception:\n                    grupos = {}\n                if grupos:\n                    for tipo in sorted(grupos):\n                        elegido = elemento_mas_a_la_derecha(vplan_arm, grupos[tipo])\n                        if elegido is not None:\n                            el_ped, bb_ped = elegido\n                            crear_callout_pedestal(vplan_arm, tname, tipo, bb_ped, vftype_detail, callout_scale, callout_margin_mm, barras_ai, el_ped, pedestales_ai)\n\n            # 5. CRUZAR MARCADORES (OCULTARLOS)\n            if vplan_arm is not None:\n                try:\n                    ocultar_marcadores_cruzados(tname, vplan_arm)\n                except Exception:\n                    pass\n\n        except Exception as e:\n            log.append('ERROR {}: {}'.format(tname, e))\nfinally:\n    TransactionManager.Instance.TransactionTaskDone()\n\nlog.insert(0, 'Assemblies procesados: {} | vistas creadas: {} | saltadas: {} | callouts creados: {} | callouts saltados: {}'.format(len(targets), created, skipped, callouts_creados, callouts_saltados))\nOUT = log",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "a2010000000000000000000000000001",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "a2010000000000000000000000000002",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
