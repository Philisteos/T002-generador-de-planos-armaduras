    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# 03_Cotas generales (ARMADURAS) - Anotaciones por assembly\n# planta: SOLO tags de Structural Rebar segun Layout Rule (2026-07-14: se quito la cota\n# de ancho/largo que heredaba la rutina de Formas - en el plano de armaduras esa cota\n# no va) | cortes A y B: altura total + spot elevation superior + Multi-Tag del elemento\n# mas bajo del assembly (solo si es de la familia C-CapaCimiento)\n#\n# Regla de negocio de los tags de armadura (2026-07-14): en la planta (todavia NO en los\n# cortes), cada Structural Rebar del assembly (miembro directo o hospedado, ver\n# rebar_del_assembly) se etiqueta con un Rebar Tag (categoria OST_RebarTags, NO Multi-Category) de la familia\n# \"C_EtiquetaArmaduras\", eligiendo el TIPO segun el parametro de instancia de la barra\n# cuyo nombre contiene \"layout\" (busqueda parcial, ver leer_layout_rule - el accessor\n# shape-driven, Rebar.GetShapeDrivenAccessor(), resulto ser de SOLO ESCRITURA, sin\n# ningun getter, asi que el valor se lee del parametro real via AsValueString(); si\n# ninguna barra tiene un parametro asi, el log vuelca todos los parametros de esa\n# barra para diagnosticar): Layout = \"Single\" -> tipo\n# \"RecuentoDoble_Corto\"; Layout = \"Number with Spacing\" -> tipo \"RecuentoSimple_Corto\"\n# (ver TIPO_TAG_POR_LAYOUT). Otros valores de Layout (Fixed Number, Maximum Spacing,\n# Minimum Clear Spacing) no tienen regla definida todavia: la barra queda sin etiquetar y\n# el log avisa. Idempotente por barra (no por vista): una vez\n# tageada, no se vuelve a tocar aunque el resto de la planta (cotas) se reprocese.\n# Revit 2027 / Dynamo 4 / CPython3\n# IN[0] = procesar todos los assemblies (bool)\n# IN[1] = filtro por nombre si IN[0] es False (parcial, comas)\n# IN[2] = separacion de la cota respecto al assembly, en mm de papel\n# IN[3] = ya no se usa (antes: filtro de material para los cortes); se reemplazo por un\n#         filtro de categoria (Structural Foundation), mas confiable. Se mantiene el\n#         input conectado por compatibilidad pero el graph lo ignora.\n#\n# Regla de negocio del Multi-Tag (2026-07-09): en ambos cortes (A y B), se etiqueta el\n# elemento REAL mas bajo de todo el assembly (a cualquier profundidad de anidamiento,\n# no solo los miembros de primer nivel) con un Multi-Category Tag de la familia\n# \"C-MultiCat\" tipo \"Descripcion+Comentario\" - pero SOLO si ese elemento mas bajo\n# pertenece a la familia \"C-CapaCimiento\" (cualquier tipo). No todos los assemblies\n# tienen esta capa (a veces el elemento mas bajo es otra cosa) - en ese caso no se\n# taguea nada, sin error.\n\nimport clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (FilteredElementCollector, AssemblyInstance, View,\n                               Options, ViewDetailLevel, Solid, GeometryInstance,\n                               PlanarFace, ReferenceArray, Line, XYZ, UV,\n                               Dimension, Element, BuiltInCategory, ElementId,\n                               IndependentTag, Reference, TagOrientation, FamilyInstance,\n                               MultiReferenceAnnotation, MultiReferenceAnnotationType,\n                               MultiReferenceAnnotationOptions)\nfrom Autodesk.Revit.DB.Structure import Rebar, RebarInSystem, RebarContainer, RebarHostData, RebarPresentationMode, MultiplanarOption\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\nfrom System.Collections.Generic import List\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nprocess_all = bool(IN[0])\nfilter_text = (IN[1] or '').strip()\noffset_mm = float(IN[2])\nCAT_FOUNDATION = ElementId(BuiltInCategory.OST_StructuralFoundation)\nNOMBRE_FAMILIA_TAG_CAPA = 'C-MultiCat'\nNOMBRE_TIPO_TAG_CAPA = 'Descripcion+Comentario'\nNOMBRE_FAMILIA_CAPA_CIMIENTO = 'C-CapaCimiento'\nNOMBRE_FAMILIA_TAG_ARM = 'C_EtiquetaArmaduras'\nTIPO_TAG_POR_LAYOUT = {\n    'single': 'RecuentoDoble_Corto',\n    'number with spacing': 'RecuentoSimple_Corto',\n}\nPARTITIONS_TAGEABLES = set(['C-INF', 'C-LAT'])\n# Multi-Rebar Annotation (2026-07-15): ademas del Rebar Tag de arriba (coexisten sobre\n# la misma barra), anota las mismas barras que 00 dejo en modo primera-y-ultima\n# (Rebar.SetPresentationMode con RebarPresentationMode.FirstLast, ver\n# mostrar_primera_ultima en 00) y que pasan el mismo filtro de Partition\n# (PARTITIONS_TAGEABLES). No es un Rebar Tag de familia cargable: la categoria es\n# OST_MultiReferenceAnnotations (Multi-Rebar Annotations en la UI), clase\n# MultiReferenceAnnotationType, sin FamilyName - se busca por Name directo.\nNOMBRE_TIPO_MULTIREBAR = 'RecuentoDoble+Info_S/Linea_Largo'\n# tags de familias en la planta (ex-05, integrado 2026-07-15): misma familia de tag\n# que el de capa de cimiento (C-MultiCat), tipo 'Modelo' (el default que usaba 05).\nNOMBRE_TIPO_TAG_FAMILIAS = 'Modelo'\nNOMBRE_FAMILIA_PEDESTAL_PURA = 'C-Pedestal'\n\nlog = []\n# contrato de nombres de la rutina de ARMADURAS (ver 00): este graph acota las\n# vistas de ARMADURAS; las de Formas (FN-1001 a secas) nunca matchean.\nSUFIJO_ARMADURAS = ' - ARMADURA'\nSUFIJO_CORTE = SUFIJO_ARMADURAS + ' - CORTE A'\nSUFIJO_CORTE_B = SUFIJO_ARMADURAS + ' - CORTE B'\nPARALELO = 0.99   # tolerancia: la normal de la cara debe ser paralela a la direccion medida\nMIN_DIST = 0.01   # pies: separacion minima entre las dos referencias de una cota\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\ndef rebar_del_assembly(ai):\n    # mismo patron que armaduras_del_assembly() de 00: barras miembro directo del\n    # assembly + barras hospedadas (RebarHostData) a cualquier profundidad.\n    barras = {}\n    def agregar(r):\n        try:\n            barras[r.Id.Value] = r\n        except Exception:\n            pass\n    for mid in ai.GetMemberIds():\n        el = doc.GetElement(mid)\n        if el is None:\n            continue\n        if isinstance(el, (Rebar, RebarInSystem, RebarContainer)):\n            agregar(el)\n            continue\n        try:\n            hd = RebarHostData.GetRebarHostData(el)\n        except Exception:\n            hd = None\n        if hd is None:\n            continue\n        try:\n            for r in hd.GetRebarsInHost():\n                agregar(r)\n        except Exception:\n            pass\n    return list(barras.values())\n\ndef instancias_recursivas(ai):\n    # todas las FamilyInstance del assembly a cualquier profundidad de anidamiento\n    # (a diferencia de hojas_recursivas, incluye tambien los contenedores, no solo las\n    # hojas) - mismo patron que usa 00 para lo mismo.\n    vistos = set()\n    resultado = []\n    stack = list(ai.GetMemberIds())\n    while stack:\n        eid = stack.pop()\n        if eid.Value in vistos:\n            continue\n        vistos.add(eid.Value)\n        el = doc.GetElement(eid)\n        if el is None or not isinstance(el, FamilyInstance):\n            continue\n        resultado.append(el)\n        try:\n            stack.extend(list(el.GetSubComponentIds()))\n        except Exception:\n            pass\n    return resultado\n\ndef es_familia_pedestal(nombre_familia):\n    # 2026-07-15: no todos los pedestales son la familia \\\"C-Pedestal\\\" pura - hay\n    # familias COMBINADAS fundacion+pedestal en una sola pieza (\\\"C-Fundacion+Pedestal\\\",\n    # \\\"C-Fundacion+2-Pedestal\\\"). Match por substring, mismo criterio que 00.\n    try:\n        return 'pedestal' in nombre_familia.strip().lower()\n    except Exception:\n        return False\n\ndef pedestales_del_assembly(ai):\n    # todas las instancias del assembly cuya familia matchea es_familia_pedestal - se\n    # usa SOLO para CONTAR cuantos pedestales tiene el assembly.\n    resultado = []\n    for el in instancias_recursivas(ai):\n        try:\n            fam = el.Symbol.Family.Name\n        except Exception:\n            continue\n        if es_familia_pedestal(fam):\n            resultado.append(el)\n    return resultado\n\ndef tipos_pedestal(ai):\n    # nombres de TIPO distintos de la familia C-Pedestal PURA en el assembly (match\n    # EXACTO de familia, igual que los callouts de pedestal de 00 - las familias\n    # combinadas fundacion+pedestal NO cuentan aca: son un solo tipo sin pedestales\n    # separables). Distinto de pedestales_del_assembly (substring), que cuenta\n    # INSTANCIAS para ocultar barras.\n    tipos = set()\n    for el in instancias_recursivas(ai):\n        try:\n            fam = el.Symbol.Family.Name\n        except Exception:\n            continue\n        if fam.strip().lower() == NOMBRE_FAMILIA_PEDESTAL_PURA.lower():\n            tipos.add(elem_name(el.Symbol).strip())\n    return tipos\n\ndef es_barra_de_pedestal(r, pedestal_ids):\n    # host de la barra (Rebar.GetHostId) y su cadena de anidamiento\n    # (FamilyInstance.SuperComponent): True si el host o algun ancestro ES una de las\n    # instancias de pedestal del assembly (pedestal_ids, ver pedestales_del_assembly).\n    try:\n        host = doc.GetElement(r.GetHostId())\n    except Exception:\n        return False\n    pasos = 0\n    while host is not None and pasos < 50:\n        try:\n            hid = host.Id.Value\n        except Exception:\n            hid = None\n        if hid is not None and hid in pedestal_ids:\n            return True\n        try:\n            host = host.SuperComponent\n        except Exception:\n            host = None\n        pasos += 1\n    return False\n\ndef leer_layout_rule(r):\n    # El accessor shape-driven (RebarShapeDrivenAccessor) resulto ser de SOLO\n    # ESCRITURA (2026-07-14): solo tiene SetLayoutAsSingle/SetLayoutAsFixedNumber/etc,\n    # ningun getter. El valor real hay que leerlo del parametro de instancia de la\n    # barra (busqueda por coincidencia parcial del nombre, no exacta, por si el\n    # nombre de definicion no es exactamente \"Layout\"). Devuelve (texto, None) si\n    # funciono, o (None, motivo) si no.\n    if not isinstance(r, Rebar):\n        return None, 'no es un Rebar individual ({})'.format(type(r).__name__)\n    try:\n        parametros = list(r.Parameters)\n    except Exception as e:\n        return None, 'no se pudo leer Parameters: {}'.format(e)\n    for p in parametros:\n        try:\n            nombre = p.Definition.Name\n        except Exception:\n            continue\n        if 'layout' in nombre.lower():\n            try:\n                valor = p.AsValueString()\n            except Exception:\n                valor = None\n            if valor:\n                return valor.strip(), None\n    nombres = sorted(set(p.Definition.Name for p in parametros if p.Definition is not None))\n    return None, 'no se encontro ningun parametro de Layout; parametros de esta barra: {}'.format(', '.join(nombres))\n\ndef leer_partition(r):\n    # Regla de negocio 2026-07-15: solo se tagean barras cuyo parametro de instancia\n    # \\\"Partition\\\" (texto plano, no enum - a diferencia de Layout Rule no hace falta\n    # AsValueString) valga \\\"C-INF\\\" o \\\"C-LAT\\\" (PARTITIONS_TAGEABLES). Cualquier otro\n    # valor, o sin el parametro, no se tagea.\n    try:\n        p = r.LookupParameter('Partition')\n    except Exception:\n        p = None\n    if p is None:\n        return None\n    try:\n        valor = p.AsString()\n    except Exception:\n        valor = None\n    return valor.strip() if valor else None\n\ndef proyectar_al_plano_vista(v, d):\n    # componente de d dentro del plano de la vista (sin la parte a lo largo de\n    # ViewDirection), normalizada. None si d es (casi) paralelo a ViewDirection.\n    try:\n        vd = v.ViewDirection\n        en_plano = d.Subtract(vd.Multiply(d.DotProduct(vd)))\n        if en_plano.GetLength() < 1e-6:\n            return None\n        return en_plano.Normalize()\n    except Exception:\n        return None\n\ndef direccion_cota_multirebar(r, v):\n    # Direccion de la linea de cota del Multi-Rebar Annotation. Revit exige que las\n    # referencias (las barras del set, lineas en la planta) sean PERPENDICULARES a la\n    # linea de cota - o sea, la cota corre a lo largo del camino de distribucion del\n    # set (2026-07-15, error real de la primera corrida: \"references must be linear\n    # references which are perpendicular to the dimension line\", con la diagonal del\n    # bounding box como direccion). Preferencia: la direccion del distribution path\n    # del accessor shape-driven (que si expone ESTE getter, a diferencia del Layout\n    # Rule, que no tiene ninguno - ver leer_layout_rule); fallback: perpendicular al\n    # eje de la primera barra en el plano de la vista (ViewDirection x tangente).\n    try:\n        acc = r.GetShapeDrivenAccessor()\n        camino = acc.GetDistributionPath()\n        d = proyectar_al_plano_vista(v, camino.Direction)\n        if d is not None:\n            return d, 'distribution path'\n    except Exception:\n        pass\n    try:\n        curvas = r.GetCenterlineCurves(False, True, True, MultiplanarOption.IncludeOnlyPlanarCurves, 0)\n        for c in curvas:\n            tangente = c.GetEndPoint(1).Subtract(c.GetEndPoint(0))\n            if tangente.GetLength() < 1e-6:\n                continue\n            perp = v.ViewDirection.CrossProduct(tangente.Normalize())\n            d = proyectar_al_plano_vista(v, perp)\n            if d is not None:\n                return d, 'perpendicular al eje de la barra'\n    except Exception:\n        pass\n    return None, None\n\n# --- assemblies objetivo (unicos por tipo, igual que 02) ---\nby_type = {}\nfor ai in FilteredElementCollector(doc).OfClass(AssemblyInstance):\n    by_type.setdefault(ai.AssemblyTypeName, []).append(ai)\n\nif process_all:\n    targets = sorted(by_type.keys())\nelse:\n    tokens = [t.strip().lower() for t in filter_text.split(',') if t.strip()]\n    if tokens:\n        targets = [n for n in sorted(by_type.keys())\n                   if any(tok in n.lower() for tok in tokens)]\n    else:\n        targets = []\n        log.append('ERROR: \\\"Todos\\\" esta en False y el filtro esta vacio.')\n\nviews = {}\nfor v in FilteredElementCollector(doc).OfClass(View):\n    if not v.IsTemplate:\n        views[elem_name(v)] = v\n\ndef add_solid_faces(out, s, trf, cat_id, el_id):\n    for f in s.Faces:\n        if isinstance(f, PlanarFace) and f.Reference is not None:\n            n = f.FaceNormal\n            buv = f.GetBoundingBox()\n            uv = UV((buv.Min.U + buv.Max.U) / 2.0, (buv.Min.V + buv.Max.V) / 2.0)\n            p = f.Evaluate(uv)\n            if trf is not None:\n                n = trf.OfVector(n)\n                p = trf.OfPoint(p)\n            out.append((f.Reference, n, p, cat_id, el_id))\n\ndef collect_faces(ai):\n    # caras planas con referencia de todos los miembros del assembly\n    # (para familias: geometria de simbolo, cuyas referencias si son acotables)\n    out = []\n    opt = Options()\n    opt.ComputeReferences = True\n    opt.DetailLevel = ViewDetailLevel.Fine\n    for mid in ai.GetMemberIds():\n        el = doc.GetElement(mid)\n        geo = el.get_Geometry(opt)\n        if geo is None:\n            continue\n        cat_id = el.Category.Id if el.Category is not None else None\n        for g in geo:\n            if isinstance(g, Solid) and g.Volume > 1e-9:\n                add_solid_faces(out, g, None, cat_id, mid.Value)\n            elif isinstance(g, GeometryInstance):\n                trf = g.Transform\n                for sg in g.GetSymbolGeometry():\n                    if isinstance(sg, Solid) and sg.Volume > 1e-9:\n                        add_solid_faces(out, sg, trf, cat_id, mid.Value)\n    return out\n\ndef extremes(faces, d):\n    # las dos caras mas extremas cuya normal es paralela a d\n    cands = [(ref, p) for ref, n, p, c, e in faces if abs(n.DotProduct(d)) > PARALELO]\n    if len(cands) < 2:\n        return None\n    lo = min(cands, key=lambda c: c[1].DotProduct(d))\n    hi = max(cands, key=lambda c: c[1].DotProduct(d))\n    if hi[1].DotProduct(d) - lo[1].DotProduct(d) < MIN_DIST:\n        return None\n    return lo, hi\n\ndef element_top_faces(faces, d, excluir_id=None):\n    # para cada elemento (agrupado por su ElementId), la cara PROPIA mas alta en la\n    # direccion d (con normal paralela a d) - sirve para armar una cadena con un\n    # segmento por elemento en vez de una sola cota de extremo a extremo.\n    # excluir_id: si se pasa, ese elemento no genera su propio segmento (2026-07-13,\n    # capa de cimiento con Multi-Tag - ver comentario en make_dim_chain).\n    por_elemento = {}\n    for ref, n, p, c, el_id in faces:\n        if excluir_id is not None and el_id == excluir_id:\n            continue\n        if abs(n.DotProduct(d)) <= PARALELO:\n            continue\n        val = p.DotProduct(d)\n        actual = por_elemento.get(el_id)\n        if actual is None or val > actual[1]:\n            por_elemento[el_id] = (ref, val, p)\n    return list(por_elemento.values())\n\ndef top_face_de(faces, d, el_id):\n    # cara PROPIA mas alta (en direccion d) de UN elemento puntual - para arrancar\n    # la cadena desde ahi en vez de desde el borde inferior absoluto (ver uso en\n    # make_dim_chain).\n    mejor = None\n    for ref, n, p, c, e in faces:\n        if e != el_id or abs(n.DotProduct(d)) <= PARALELO:\n            continue\n        val = p.DotProduct(d)\n        if mejor is None or val > mejor[1]:\n            mejor = (ref, val, p)\n    return mejor\n\ndef dim_line(d, perp, perp_value, p_lo, p_hi):\n    # linea paralela a d, desplazada a perp_value sobre el eje perp\n    c = p_lo.Add(p_hi).Multiply(0.5)\n    base = c.Add(perp.Multiply(perp_value - c.DotProduct(perp)))\n    q1 = base.Add(d.Multiply(p_lo.DotProduct(d) - base.DotProduct(d)))\n    q2 = base.Add(d.Multiply(p_hi.DotProduct(d) - base.DotProduct(d)))\n    return Line.CreateBound(q1, q2)\n\ndef has_dims(v):\n    return FilteredElementCollector(doc, v.Id).OfClass(Dimension).GetElementCount() > 0\n\ndef has_tags(v):\n    return (FilteredElementCollector(doc, v.Id)\n            .OfCategory(BuiltInCategory.OST_MultiCategoryTags)\n            .OfClass(IndependentTag).GetElementCount() > 0)\n\ndef elementos_ya_tageados(v):\n    # ids de todos los elementos que ya tienen un Rebar Tag en esta vista\n    # (para no re-etiquetar barras ya tageadas en corridas anteriores).\n    tageados = set()\n    for tg in (FilteredElementCollector(doc, v.Id)\n               .OfCategory(BuiltInCategory.OST_RebarTags)\n               .OfClass(IndependentTag)):\n        try:\n            for tid in tg.GetTaggedLocalElementIds():\n                tageados.add(tid.Value)\n        except Exception:\n            pass\n    return tageados\n\ndef elementos_ya_anotados_multirebar(v):\n    # mismo patron que elementos_ya_tageados pero para Multi-Rebar Annotations\n    # (categoria OST_MultiReferenceAnnotations, clase MultiReferenceAnnotation): junta\n    # los ElementId de todas las referencias ya anotadas en esta vista, via\n    # GetTaggedReferences() (lista de Reference, no de ElementId como IndependentTag).\n    anotados = set()\n    for an in (FilteredElementCollector(doc, v.Id)\n               .OfCategory(BuiltInCategory.OST_MultiReferenceAnnotations)\n               .OfClass(MultiReferenceAnnotation)):\n        try:\n            for ref in an.GetTaggedReferences():\n                anotados.add(ref.ElementId.Value)\n        except Exception:\n            pass\n    return anotados\n\ndef referencias_para_tag(r, vista):\n    # Candidatos de Reference para IndependentTag.Create, en orden de preferencia.\n    # Reference(elemento) directo fallo en este modelo (\"The reference can not be\n    # tagged\", 2026-07-14) pese a que el tag manual por categoria SI funciona en la\n    # misma vista: al clickear con el mouse, Revit taguea una barra concreta del SET,\n    # y la API expone esas barras individuales como Subelements con su propia\n    # Reference (GetSubelements()[i].GetReference()) - esa es la forma que suele\n    # aceptar. Como fallback final, una referencia sacada de la geometria visible\n    # (cara o curva con ComputeReferences=True).\n    cands = []\n    try:\n        cands.append((Reference(r), 'Reference(elemento)'))\n    except Exception:\n        pass\n    try:\n        for sub in r.GetSubelements():\n            try:\n                ref_sub = sub.GetReference()\n            except Exception:\n                continue\n            if ref_sub is not None:\n                cands.append((ref_sub, 'subelemento'))\n                break\n    except Exception:\n        pass\n    try:\n        opt = Options()\n        opt.ComputeReferences = True\n        opt.View = vista\n        geo = r.get_Geometry(opt)\n    except Exception:\n        geo = None\n    if geo is not None:\n        ref_geo = None\n        for g in geo:\n            if isinstance(g, Solid) and g.Volume > 1e-9:\n                for f in g.Faces:\n                    if f.Reference is not None:\n                        ref_geo = (f.Reference, 'cara de geometria')\n                        break\n            elif getattr(g, 'Reference', None) is not None:\n                ref_geo = (g.Reference, 'curva de geometria')\n            if ref_geo is not None:\n                break\n        if ref_geo is not None:\n            cands.append(ref_geo)\n    return cands\n\ndef hojas_recursivas(ai):\n    # todas las hojas (FamilyInstance sin sub-componentes propios) del assembly, a\n    # cualquier profundidad de anidamiento - mismo patron que 06_Tabla de assemblies.\n    # Hace falta esto (en vez de solo ai.GetMemberIds()) porque collect_faces()\n    # atribuye la geometria de simbolos anidados al miembro de PRIMER NIVEL, no al\n    # elemento real que la contiene - para identificar la familia real del elemento\n    # mas bajo hay que llegar hasta la hoja.\n    vistos = set()\n    hojas = []\n    stack = list(ai.GetMemberIds())\n    while stack:\n        eid = stack.pop()\n        if eid.Value in vistos:\n            continue\n        vistos.add(eid.Value)\n        el = doc.GetElement(eid)\n        if el is None or not isinstance(el, FamilyInstance):\n            continue\n        subs = []\n        try:\n            subs = list(el.GetSubComponentIds())\n        except Exception:\n            pass\n        if subs:\n            stack.extend(subs)\n        else:\n            hojas.append(el)\n    return hojas\n\ndef elemento_mas_bajo(hojas):\n    # la hoja cuyo bounding box llega mas abajo (Z minimo mas bajo de todas)\n    mejor, mejor_z = None, None\n    for el in hojas:\n        try:\n            bb = el.get_BoundingBox(None)\n        except Exception:\n            bb = None\n        if bb is None:\n            continue\n        if mejor_z is None or bb.Min.Z < mejor_z:\n            mejor_z, mejor = bb.Min.Z, el\n    return mejor\n\ndef proj_range(faces, d):\n    vals = [p.DotProduct(d) for ref, n, p, c, e in faces]\n    return (min(vals), max(vals))\n\ndef make_dim_chain(view, faces, d, perp, perp_value, etiqueta, tname, excluir_id=None):\n    # cadena con UN segmento por elemento: del borde inferior absoluto a la cara\n    # propia mas alta de cada elemento, en orden ascendente (en vez de una sola\n    # cota de extremo a extremo). Con un solo elemento da el mismo resultado que\n    # make_dim (una cota, dos referencias).\n    # excluir_id (2026-07-13): el elemento mas bajo del assembly, cuando ya lleva\n    # el Multi-Tag de capa de cimiento (ver elem_bajo mas abajo), no genera su\n    # propio segmento en la cadena - queda tageado pero no acotado por separado.\n    # La cadena arranca desde la cara SUPERIOR de ESE elemento (no desde el borde\n    # inferior absoluto del assembly): su espesor queda completamente fuera de la\n    # cadena, en vez de fusionarse con el segmento de arriba.\n    ext = extremes(faces, d)\n    if ext is None:\n        log.append('AVISO {}: sin caras perpendiculares para la cota de {}.'.format(tname, etiqueta))\n        return 0\n    (lo_ref, p_lo), (hi_ref, p_hi) = ext\n    if excluir_id is not None:\n        propio = top_face_de(faces, d, excluir_id)\n        if propio is not None:\n            lo_ref, _val_propio, p_lo = propio\n    tops = element_top_faces(faces, d, excluir_id)\n    tops.sort(key=lambda t: t[1])\n    filtrados = []\n    ultimo = None\n    for ref, val, p in tops:\n        if ultimo is None or val - ultimo > MIN_DIST:\n            filtrados.append(ref)\n            ultimo = val\n    ra = ReferenceArray()\n    ra.Append(lo_ref)\n    for ref in (filtrados if filtrados else [hi_ref]):\n        ra.Append(ref)\n    line = dim_line(d, perp, perp_value, p_lo, p_hi)\n    doc.Create.NewDimension(view, line, ra)\n    log.append('OK {}: cota de {} en \\\"{}\\\" ({} segmentos).'.format(tname, etiqueta, elem_name(view), max(1, len(filtrados))))\n    return 1\n\ntotal = 0\nTransactionManager.Instance.EnsureInTransaction(doc)\n\ntag_type_capa = None\nfor t in FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_MultiCategoryTags).WhereElementIsElementType():\n    try:\n        if (t.FamilyName.strip().lower() == NOMBRE_FAMILIA_TAG_CAPA.lower()\n                and elem_name(t).strip().lower() == NOMBRE_TIPO_TAG_CAPA.lower()):\n            tag_type_capa = t\n            break\n    except Exception:\n        continue\nif tag_type_capa is None:\n    log.append('AVISO: no se encontro el tag \"{} : {}\" (Multi-Category Tag) para la capa de cimiento; ese tag se omite.'.format(\n        NOMBRE_FAMILIA_TAG_CAPA, NOMBRE_TIPO_TAG_CAPA))\n    disponibles = list(FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_MultiCategoryTags).WhereElementIsElementType())\n    if disponibles:\n        log.append('Tags multicategoria disponibles: ' + ', '.join(sorted('{} : {}'.format(t.FamilyName, elem_name(t)) for t in disponibles)))\nelif hasattr(tag_type_capa, 'IsActive') and not tag_type_capa.IsActive:\n    tag_type_capa.Activate()\n\ntag_types_arm = {}\nfaltantes_arm = set(TIPO_TAG_POR_LAYOUT.values())\nfor t in FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_RebarTags).WhereElementIsElementType():\n    try:\n        if t.FamilyName.strip().lower() == NOMBRE_FAMILIA_TAG_ARM.lower():\n            nom = elem_name(t).strip()\n            if nom in faltantes_arm:\n                tag_types_arm[nom] = t\n                faltantes_arm.discard(nom)\n    except Exception:\n        continue\nif faltantes_arm:\n    log.append('AVISO: no se encontraron estos tipos de \"{}\" (Rebar Tag): {}. Las barras con ese Layout no se etiquetan.'.format(\n        NOMBRE_FAMILIA_TAG_ARM, ', '.join(sorted(faltantes_arm))))\n    disponibles_arm = list(FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_RebarTags).WhereElementIsElementType())\n    if disponibles_arm:\n        log.append('Rebar Tags disponibles: ' + ', '.join(sorted('{} : {}'.format(t.FamilyName, elem_name(t)) for t in disponibles_arm)))\nfor t in tag_types_arm.values():\n    if hasattr(t, 'IsActive') and not t.IsActive:\n        t.Activate()\n\n# tipo de Multi-Rebar Annotation (2026-07-15, ver NOMBRE_TIPO_MULTIREBAR mas arriba) -\n# no es FamilySymbol (sin FamilyName/Activate), se busca por Name directo sobre la\n# clase MultiReferenceAnnotationType.\ntag_type_multirebar = None\nfor t in FilteredElementCollector(doc).OfClass(MultiReferenceAnnotationType):\n    try:\n        if elem_name(t).strip().lower() == NOMBRE_TIPO_MULTIREBAR.lower():\n            tag_type_multirebar = t\n            break\n    except Exception:\n        continue\nif tag_type_multirebar is None:\n    log.append('AVISO: no se encontro el Multi-Rebar Annotation Type {} (categoria Multi-Rebar Annotations); esa anotacion se omite.'.format(NOMBRE_TIPO_MULTIREBAR))\n    disponibles_multirebar = list(FilteredElementCollector(doc).OfClass(MultiReferenceAnnotationType))\n    if disponibles_multirebar:\n        log.append('Multi-Rebar Annotation Types disponibles: ' + ', '.join(sorted(elem_name(t) for t in disponibles_multirebar)))\nelif hasattr(tag_type_multirebar, 'IsActive') and not tag_type_multirebar.IsActive:\n    tag_type_multirebar.Activate()\n\n# tipo de tag para las familias de la planta (ex-05): C-MultiCat : Modelo\ntag_type_familias = None\nfor t in FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_MultiCategoryTags).WhereElementIsElementType():\n    try:\n        if (t.FamilyName.strip().lower() == NOMBRE_FAMILIA_TAG_CAPA.lower()\n                and elem_name(t).strip().lower() == NOMBRE_TIPO_TAG_FAMILIAS.lower()):\n            tag_type_familias = t\n            break\n    except Exception:\n        continue\nif tag_type_familias is None:\n    log.append('AVISO: no se encontro el tag \"{} : {}\" (Multi-Category Tag) para las familias de la planta (ex-05); ese tagueo se omite.'.format(\n        NOMBRE_FAMILIA_TAG_CAPA, NOMBRE_TIPO_TAG_FAMILIAS))\nelif hasattr(tag_type_familias, 'IsActive') and not tag_type_familias.IsActive:\n    tag_type_familias.Activate()\n\ntry:\n    for tname in targets:\n        ai = by_type[tname][0]\n        try:\n            faces = collect_faces(ai)\n            if not faces:\n                log.append('ERROR {}: los miembros no exponen geometria con referencias.'.format(tname))\n                continue\n            pedestales_ai = pedestales_del_assembly(ai)\n            pedestal_ids_ai = set(el.Id.Value for el in pedestales_ai) if len(pedestales_ai) >= 2 else set()\n            # ---------- PLANTA: tags de Structural Rebar (2026-07-14: ya NO se acota ancho/largo) ----------\n            vplan = views.get(tname + SUFIJO_ARMADURAS)\n            if vplan is None:\n                log.append('AVISO {}: no existe la vista de planta (corre 00_Vistas de assembly).'.format(tname))\n            else:\n                # ---------- Tags de Structural Rebar en la planta (segun Layout) ----------\n                # independiente de si la planta ya tenia cotas de una corrida anterior.\n                barras_ai = rebar_del_assembly(ai)\n                if barras_ai:\n                    ya_tageadas = elementos_ya_tageados(vplan)\n                    ya_anotadas_multi = elementos_ya_anotados_multirebar(vplan) if tag_type_multirebar is not None else set()\n                    pedestal_saltadas = 0\n                    partition_saltadas = 0\n                    multirebar_creadas = 0\n                    for r in barras_ai:\n                        if pedestal_ids_ai and es_barra_de_pedestal(r, pedestal_ids_ai):\n                            pedestal_saltadas += 1\n                            continue\n                        partition_val = leer_partition(r)\n                        if partition_val not in PARTITIONS_TAGEABLES:\n                            partition_saltadas += 1\n                            continue\n                        if tag_type_multirebar is not None and r.Id.Value not in ya_anotadas_multi:\n                            es_first_last = False\n                            try:\n                                if r.CanApplyPresentationMode(vplan):\n                                    es_first_last = (r.GetPresentationMode(vplan) == RebarPresentationMode.FirstLast)\n                            except Exception:\n                                es_first_last = False\n                            if es_first_last:\n                                try:\n                                    bb_multi = r.get_BoundingBox(vplan) or r.get_BoundingBox(None)\n                                    if bb_multi is None:\n                                        log.append('AVISO {}: barra {} sin bounding box, Multi-Rebar Annotation omitida.'.format(tname, r.Id.Value))\n                                    else:\n                                        centro_multi = XYZ((bb_multi.Min.X + bb_multi.Max.X) / 2.0, (bb_multi.Min.Y + bb_multi.Max.Y) / 2.0, (bb_multi.Min.Z + bb_multi.Max.Z) / 2.0)\n                                        dir_multi, via_dir = direccion_cota_multirebar(r, vplan)\n                                        if dir_multi is None:\n                                            log.append('AVISO {}: barra {} sin direccion de distribucion calculable, Multi-Rebar Annotation omitida.'.format(tname, r.Id.Value))\n                                        else:\n                                            # MultiReferenceAnnotationOptions (2026-07-15, firma real confirmada por\n                                            # reflexion en vivo sobre RevitAPI): NO recibe References como IndependentTag,\n                                            # recibe un ElementId del Rebar (SetElementsToDimension) - el set completo es\n                                            # UN Rebar, no hace falta el fallback de referencias_para_tag aca.\n                                            opciones_multi = MultiReferenceAnnotationOptions(tag_type_multirebar)\n                                            opciones_multi.SetElementsToDimension(List[ElementId]([r.Id]))\n                                            opciones_multi.TagHasLeader = False\n                                            opciones_multi.DimensionPlaneNormal = vplan.ViewDirection\n                                            opciones_multi.DimensionLineDirection = dir_multi\n                                            opciones_multi.DimensionLineOrigin = centro_multi\n                                            opciones_multi.TagHeadPosition = centro_multi\n                                            MultiReferenceAnnotation.Create(doc, vplan.Id, opciones_multi)\n                                            total += 1\n                                            multirebar_creadas += 1\n                                            log.append('OK {}: Multi-Rebar Annotation creada en planta (barra {}, direccion via {}).'.format(tname, r.Id.Value, via_dir))\n                                except Exception as e:\n                                    log.append('ERROR {} Multi-Rebar Annotation (barra {}): {}'.format(tname, r.Id.Value, e))\n                        if r.Id.Value in ya_tageadas:\n                            continue\n                        layout_txt, error_layout = leer_layout_rule(r)\n                        if layout_txt is None:\n                            log.append('AVISO {}: barra {}: {}'.format(tname, r.Id.Value, error_layout))\n                            continue\n                        tipo_nombre = TIPO_TAG_POR_LAYOUT.get(layout_txt.strip().lower())\n                        if tipo_nombre is None:\n                            log.append('AVISO {}: Layout \"{}\" (barra {}) sin regla de tag definida, no se etiqueta.'.format(tname, layout_txt, r.Id.Value))\n                            continue\n                        tag_type_arm = tag_types_arm.get(tipo_nombre)\n                        if tag_type_arm is None:\n                            continue  # ya se aviso mas arriba que falta este tipo\n                        try:\n                            bb = r.get_BoundingBox(vplan) or r.get_BoundingBox(None)\n                            if bb is None:\n                                log.append('AVISO {}: barra {} sin bounding box, no se etiqueta.'.format(tname, r.Id.Value))\n                                continue\n                            centro = XYZ((bb.Min.X + bb.Max.X) / 2.0, (bb.Min.Y + bb.Max.Y) / 2.0, (bb.Min.Z + bb.Max.Z) / 2.0)\n                            creado = False\n                            errores_ref = []\n                            for ref_tag, desc_ref in referencias_para_tag(r, vplan):\n                                try:\n                                    IndependentTag.Create(doc, tag_type_arm.Id, vplan.Id, ref_tag, True, TagOrientation.Horizontal, centro)\n                                    total += 1\n                                    log.append('OK {}: tag de armadura ({}) creado en planta (via {}).'.format(tname, layout_txt, desc_ref))\n                                    creado = True\n                                    break\n                                except Exception as e:\n                                    errores_ref.append('{}: {}'.format(desc_ref, str(e).splitlines()[0][:120]))\n                            if not creado:\n                                log.append('ERROR {} tag de armadura (barra {}): ninguna referencia funciono [{}]'.format(tname, r.Id.Value, ' | '.join(errores_ref) if errores_ref else 'sin candidatos'))\n                        except Exception as e:\n                            log.append('ERROR {} tag de armadura (barra {}): {}'.format(tname, r.Id.Value, e))\n                    if pedestal_saltadas:\n                        log.append('{}: {} barras de pedestal sin etiquetar en la planta ({} pedestales en el assembly).'.format(tname, pedestal_saltadas, len(pedestales_ai)))\n                    if partition_saltadas:\n                        log.append('{}: {} barras sin etiquetar en la planta (Partition fuera de {}).'.format(tname, partition_saltadas, sorted(PARTITIONS_TAGEABLES)))\n                    if multirebar_creadas:\n                        log.append('{}: {} Multi-Rebar Annotations creadas en la planta (barras en modo primera-y-ultima).'.format(tname, multirebar_creadas))\n                # ---------- Tags de familias (ex-05, integrado 2026-07-15) ----------\n                # Multi-Category Tag a cada FamilyInstance de PRIMER NIVEL del assembly\n                # (las anidadas se saltan, tienen SuperComponent), SOLO si el assembly\n                # tiene 2+ TIPOS distintos de C-Pedestal (mismo criterio que los\n                # callouts de 00: estos tags existen para distinguir pedestales entre\n                # si; con 0, 1 o varios del MISMO tipo no se tagea nada). Idempotente:\n                # se salta si la planta ya tiene algun Multi-Category Tag (los Rebar\n                # Tags de arriba son otra categoria, no cuentan).\n                if tag_type_familias is not None:\n                    tipos_ped = tipos_pedestal(ai)\n                    if len(tipos_ped) < 2:\n                        log.append('{}: {} tipo(s) de C-Pedestal (se requieren 2+ distintos), planta sin tags de familias.'.format(tname, len(tipos_ped)))\n                    elif has_tags(vplan):\n                        log.append('{}: la planta ya tiene tags de familias, se salta.'.format(tname))\n                    else:\n                        n_fam = 0\n                        omitidas_fam = 0\n                        for mid in ai.GetMemberIds():\n                            el = doc.GetElement(mid)\n                            if el is None or el.Category is None or not isinstance(el, FamilyInstance):\n                                continue\n                            sup = None\n                            try:\n                                sup = el.SuperComponent\n                            except Exception:\n                                pass\n                            if sup is not None:\n                                continue\n                            try:\n                                bb = el.get_BoundingBox(None)\n                                if bb is None:\n                                    continue\n                                centro_fam = XYZ((bb.Min.X + bb.Max.X) / 2.0, (bb.Min.Y + bb.Max.Y) / 2.0, (bb.Min.Z + bb.Max.Z) / 2.0)\n                                IndependentTag.Create(doc, tag_type_familias.Id, vplan.Id, Reference(el), False, TagOrientation.Horizontal, centro_fam)\n                                n_fam += 1\n                            except Exception:\n                                omitidas_fam += 1\n                        total += n_fam\n                        msg_fam = 'OK {}: {} tags de familias en la planta ({} tipos de C-Pedestal).'.format(tname, n_fam, len(tipos_ped))\n                        if omitidas_fam:\n                            msg_fam += ' {} familias no admiten este tag.'.format(omitidas_fam)\n                        log.append(msg_fam)\n            # ---------- CORTES A y B: altura total + spot elevations ----------\n            # en los cortes solo se acota Structural Foundation (filtro por categoria del\n            # elemento dueño de la cara, no por nombre de material - mas confiable). Si\n            # ningun miembro de esa categoria expone caras referenciables, NO se cae a\n            # usar toda la geometria del assembly: pernos/planchas/conexiones dan\n            # referencias poco confiables (caras delgadas, simbolos anidados) que Revit\n            # termina rechazando para Spot Elevation (\"Spot Dimensions can generally\n            # reference only those references which have valid coordinates in the\n            # view\") - y a veces incluso para la propia cota, recien al comitear la\n            # transaccion al final del script (dialogo \"Deleted element: id = -1\").\n            # Mas vale saltar el corte con un aviso claro que forzar una anotacion\n            # fragil que interrumpe al usuario con un dialogo de error de Revit.\n            faces_corte = [fx for fx in faces if fx[3] == CAT_FOUNDATION]\n            if not faces_corte:\n                log.append('AVISO {}: ningun miembro de Structural Foundation con caras referenciables; se omiten la cota de altura y la spot elevation de los cortes (el resto de la geometria - pernos, planchas, conexiones - no da referencias confiables para acotar).'.format(tname))\n\n            # elemento REAL mas bajo del assembly (a cualquier profundidad de anidamiento);\n            # solo se taguea si es de la familia C-CapaCimiento (no todos los assemblies\n            # tienen esta capa - en ese caso queda en None y no se taguea nada).\n            elem_bajo = None\n            candidato_bajo = elemento_mas_bajo(hojas_recursivas(ai))\n            if candidato_bajo is not None:\n                try:\n                    fam_nombre = candidato_bajo.Symbol.Family.Name\n                except Exception:\n                    fam_nombre = ''\n                if fam_nombre.strip().lower() == NOMBRE_FAMILIA_CAPA_CIMIENTO.lower():\n                    elem_bajo = candidato_bajo\n\n            for suf, nombre_corte in ((SUFIJO_CORTE, 'corte A'), (SUFIJO_CORTE_B, 'corte B')):\n                vsec = views.get(tname + suf)\n                if vsec is None:\n                    log.append('AVISO {}: no existe la vista de {} (corre 00_Vistas de assembly).'.format(tname, nombre_corte))\n                    continue\n                rd = vsec.RightDirection\n                z = XYZ.BasisZ\n                off = offset_mm / 304.8 * vsec.Scale\n                if has_dims(vsec):\n                    log.append('{}: el {} ya tiene cotas, se salta.'.format(tname, nombre_corte))\n                elif faces_corte:\n                    r0, r1 = proj_range(faces, rd)\n                    try:\n                        excluir_id = elem_bajo.Id.Value if elem_bajo is not None else None\n                        # cadena de altura a la IZQUIERDA del corte (r0 - off; pedido de\n                        # los modeladores 2026-07-13, antes iba a la derecha). La spot\n                        # elevation superior sigue a la derecha.\n                        total += make_dim_chain(vsec, faces_corte, z, rd, r0 - off, 'altura ({})'.format(nombre_corte), tname, excluir_id)\n                    except Exception as e:\n                        log.append('ERROR {} cota altura {}: {}'.format(tname, nombre_corte, e))\n                    ext = extremes(faces_corte, z)\n                    if ext is None:\n                        log.append('AVISO {}: sin caras horizontales para spot elevations.'.format(tname))\n                    else:\n                        (lo_ref, p_lo), (hi_ref, p_hi) = ext\n                        # solo la spot elevation superior; la inferior ya no se coloca\n                        pares = ((hi_ref, p_hi, 1.0, 'superior'),)\n                        for ref, pt, dz, tag in pares:\n                            try:\n                                bend = pt.Add(rd.Multiply(off)).Add(XYZ(0, 0, dz * off))\n                                end = bend.Add(rd.Multiply(off))\n                                doc.Create.NewSpotElevation(vsec, ref, pt, bend, end, pt, True)\n                                total += 1\n                                log.append('OK {}: spot elevation {} en {}.'.format(tname, tag, nombre_corte))\n                            except Exception as e:\n                                log.append('ERROR {} spot elevation {} en {}: {}'.format(tname, tag, nombre_corte, e))\n\n                # --- Multi-Tag del elemento mas bajo del assembly (solo si es C-CapaCimiento) ---\n                # independiente de si el corte ya tenia cotas de una corrida anterior.\n                if tag_type_capa is not None and elem_bajo is not None:\n                    if has_tags(vsec):\n                        log.append('{}: el {} ya tiene el tag de capa de cimiento, se salta.'.format(tname, nombre_corte))\n                    else:\n                        try:\n                            bb = elem_bajo.get_BoundingBox(None)\n                            # alineado a la mitad del elemento (sin desplazamiento lateral)\n                            # y por debajo del assembly completo (Z minimo de TODA la\n                            # geometria del assembly, no solo del elemento mas bajo).\n                            centro_x = (bb.Min.X + bb.Max.X) / 2.0\n                            centro_y = (bb.Min.Y + bb.Max.Y) / 2.0\n                            z_min_assembly = proj_range(faces, XYZ.BasisZ)[0]\n                            head = XYZ(centro_x, centro_y, z_min_assembly - off * 2.0)\n                            IndependentTag.Create(doc, tag_type_capa.Id, vsec.Id, Reference(elem_bajo),\n                                                  True, TagOrientation.Horizontal, head)\n                            total += 1\n                            log.append('OK {}: tag de capa de cimiento en {}.'.format(tname, nombre_corte))\n                        except Exception as e:\n                            log.append('ERROR {} tag de capa de cimiento en {}: {}'.format(tname, nombre_corte, e))\n        except Exception as e:\n            log.append('ERROR {}: {}'.format(tname, e))\nfinally:\n    TransactionManager.Instance.TransactionTaskDone()\n\nlog.insert(0, 'Anotaciones creadas: {} | assemblies procesados: {}'.format(total, len(targets)))\nOUT = log",
      "Engine": "PythonNet3",
